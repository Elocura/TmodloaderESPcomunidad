			'''
	}

	RhapsodistEnchant: {
		DisplayName: Encantamiento del Rapsoda
		Tooltip:
			'''
			Deja que tu canción inspire a un ejército, demuestra que tu talento no tiene igual
			Las notas de inspiración que caen serán más potentes
			Además, otorgan un potenciador aleatorio de nivel 1 a todos los aliados cercanos
			Presionar la tecla de 'habilidad especial' te otorga inspiración infinita, mayor daño sinfónico y velocidad de ejecución
			También sobrecarga a todos los aliados cercanos con todos los potenciadores III durante 15 segundos
