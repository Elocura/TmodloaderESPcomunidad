	DreamWeaverEnchant: {
		DisplayName: Encantamiento del Tejedor de sueños
		Tooltip:
			'''
			Manifiesta tus sueños más profundos a través de tus aliados; ata a los enemigos de tu futuro en agonía temporal
			Presionar la tecla de 'habilidad especial' consumirá 400 de maná y te sumergirá en el Sueño, alterando el tejido mismo de la realidad
			Mientras estás en el Sueño, los aliados curados serán brevemente invulnerables y se curarán de todos los efectos negativos
			Los enemigos serán fuertemente ralentizados y recibirán un 15% más de daño de todas las fuentes
			Los aliados obtendrán un gran aumento de velocidad de movimiento y ataque
			Otorga los efectos del Núcleo Omega
			'''
	}

	TideTurnerEnchant: {
		DisplayName: Encantamiento del Domador de mareas
		Tooltip:
			'''
			Conviértete en tan imparable como las mareas, desata la furia acuática sobre tus enemigos
			Presionar la tecla de 'habilidad especial' te envuelve en una burbuja impenetrable
			Mientras la burbuja esté activa, todo el daño recibido se convierte en curación
			Genera un glóbulo flotante cada medio segundo
			Cada glóbulo aumenta la defensa y convierte tu próximo ataque lanzado en un mini-crítico
			El daño de lanzamiento inunda a los enemigos alcanzados con energía
			Tu daño de lanzamiento tiene un 20% de probabilidad de invocar dagas acuáticas rastreadoras a tu alrededor
			Otorga los efectos del Frasco del Señor de la plaga
			'''
	}

	PyromancerEnchant: {
		DisplayName: Encantamiento del Piromante
		Tooltip:
			'''
			La mirada fundida del ejército que fortificaste con magma será temida
			Tu daño mágico quemará intensamente y dañará a todos los enemigos cercanos
			Todo daño de súbditos deja una quemadura persistente que inflige daño significativo con el tiempo
