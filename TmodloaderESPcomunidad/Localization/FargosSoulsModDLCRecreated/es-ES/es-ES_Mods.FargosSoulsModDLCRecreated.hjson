Items: {
	DLCItemChangesCalamity: {
		DisplayName: DLC Item Changes Calamity
		SoulTooltip1: Effects of Statis' Void Sash
		SoulTooltip2: Effects of Elemental Gauntlet and Badge of Bravery
		SoulTooltip3: Effects of Ethereal Talisman
		SoulTooltip4: Effects of Elemental Quiver and Quiver of Nihility
		SoulTooltip5: Effects of Nucleogenesis
		SoulTooltip6: Effects of Abyssal Diving Suit
		SoulTooltip7: Effects of The Amalgam, Asgardian Aegis, and Rampart of Deities
		SoulTooltip8: Effects of The Amalgam, Asgardian Aegis, and Rampart of Deities
		SoulTooltip9: Effects of Abyssal Diving Suit
		SoulTooltip10: Effects of Statis' Void Sash
		SoulTooltip11: Effects of Elemental Gauntlet and Badge of Bravery
		SoulTooltip12: Effects of Ethereal Talisman
		SoulTooltip13: Effects of Elemental Quiver and Quiver of Nihility
		SoulTooltip14: Effects of Nucleogenesis
	}

	DesolationForce: {
		DisplayName: Fuerza de Desolación
		Tooltip:
			'''
			When the world is barren and cold, you will be all that remains
			All armor bonuses from Daedalus, Snow Ruffian, Umbraphile, Prismatic, and Astral
			All armor bonuses from Omega Blue, Mollusk, Victide, Fathom Swarmer, and Sulphurous
			Effects of Scuttler's Jewel, Frozen Cube, and Permafrost Concoction
			Effects of Cryo Stone, Howls Heart, Frost Barrier, and Frost Flare
			Effects of Thief's Dime, Vampiric Talisman, Moonstone Crown, and Evasion Scarf
			'''
		Tooltip_NoCrossmod: Effects of Radiance, Interstellar Stompers, and Ursa Sergeant
		Tooltip_Crossmod: Effects of Hide of Asturm Deus, Interstellar Stompers, and Ursa Sergeant
		Tooltip_NoCrossmod_2: Effects of the Abyssal Diving Suit and Reaper Tooth Necklace
		Tooltip_Crossmod_2: Effects of Old Duke Scales and Reaper Tooth Necklace
		Tooltip_2:
			'''
			Effects of Aquatic Emblem, Shield of the Ocean, and Giant Pearl
			Effects of Ocean's Crest, Deep Diver and Luxor's Gift
			Effects of Corrosive Spine, Diamond of the Deep, Amadias Pendant, and Leviathan Ambergris
			'''
		Tooltip_NoCrossmod_3: Effects of Sand Cloak, Old Die, Scions Curio, Aquatic Heart and Alluring Bait
		Tooltip_Crossmod_3: Effects of Sand Cloak, Old Die, Scions Curio, and Aquatic Heart
	}

	AnnihilationForce: {
		DisplayName: Fuerza de Aniquilación
		Tooltip:
			'''
			Where once there was life and light, only ruin remains...
			All armor bonuses from Aerospec, Statigel, and Hydrothermic
			All armor bonuses from Empyrean, Desert Prowler, and Fearmonger
			Effects of Gladiator's Locket, Aero Stone and Unstable Granite Core
			Effects of Fungal Clump, Mana Polarizer and Fungal Symbiote
			'''
		Tooltip_NoCrossmod:
			'''
			Effects of Hallowed Rune, Ethereal Extorter, Regenator, The Community, and Shield of the High Ruler
			Effects of Spectral Veil, Occult Skull Crown, The Community, and Statis' Void Sash
			'''
		Tooltip_Crossmod:
			'''
			Effects of Flesh Totem, Ethereal Extorter, Regenator, The Absorber, and Shield of the High Ruler
			Effects of Spectral Veil, Occult Skull Crown, The Community, and The Evolution
			'''
	}

	WulfrumEnchant: {
		Tooltip:
			'''
			No debe confundirse con el Encantamiento de tungsteno…
			+5 de defensa cuando tienes menos del 50% de vida
			Otorga los efectos del Amuleto de Chi, Colmillo podrido y el Pack acrobático Wulfrum
			'''
		DisplayName: Encantamiento de Wulfrum
	}

	VictideEnchant: {
		Tooltip:
			'''
			Los antiguos mares te han energizado…
			Al usar cualquier arma tienes un 10% de probabilidad de lanzar un proyectil de concha marina que regresa
			Esta concha inflige daño verdadero y no se ve afectada por ninguna clase de daño
			Aumenta la movilidad bajo el agua y reduce ligeramente la pérdida de oxígeno en el abismo
			Otorga los efectos de la Cresta oceánica, el Escudo del océano y el Regalo de Luxor
			'''
		DisplayName: Encantamiento de Victide
	}

	UmbraphileEnchant: {
		Tooltip:
			'''
			+110 de sigilo máximo
			Las armas de pícaro tienen una probabilidad de crear explosiones al golpear
			Los ataques sigilosos siempre crean una explosión
			Otorga los efectos de la Moneda del ladrón, el Talismán vampírico y la Bufanda de evasión
			'''
		DisplayName: Encantamiento de Umbráfilas
	}

	TarragonEnchant: {
		DisplayName: Encantamiento de Tarragon
		Tooltip:
			'''
			Braelor's undying might flows through you...
			Increased heart pickup range
			Taking damage gives the Tarra Life buff, which grants +1.5 HP/s life regen
			Press Y to cloak yourself in life energy that heavily reduces contact damage for 10 seconds
			This has a 30 second cooldown
			Enemies have a chance to drop extra hearts on death
			Ranged projectiles split into homing life energy and leaves on death
			On every 5th critical strike you will fire a leaf storm
			Summons a life aura around you that damages nearby enemies
			After every 50 rogue critical hits you will gain 2.5 seconds of damage immunity
			This effect has a cooldown of 25 seconds
			While under effects of a debuff you gain 10% increased rogue damage
			'''
		Tooltip_BardHealer:
			'''
			Occasionally emit a healing pulse that heals and shields allies by 8 points
			You spawn quarter rests around you that heal inspiration upon hitting enemies
			'''
		Tooltip_NoCrossmod: Effects of Blazing Core and Dark Sun Ring
		Tooltip_Crossmod: Effects of Blazing Core, Warbanner of the Righteous, and Dark Sun Ring
	}

	SulphurousEnchant: {
		DisplayName: Encantamiento sulfuroso
		Tooltip:
			'''
			Attacking and being attacked by enemies inflicts poison
			Grants an additional jump that summons a sulphurous bubble
			Attacking and being attacked by enemies inflicts Poisoned for 1 second
			Reduces the severity of the sulphuric waters
			'''
		Tooltip_NoCrossmod: Effects of Sand Cloak, Old Die, Scions Curio, Amadias Pendant, and Alluring Bait
		Tooltip_Crossmod: Effects of Sand Cloak, Old Die, Scions Curio, and Amadias Pendant
	}

	StatigelEnchant: {
		DisplayName: Encantamiento de Statigel
		Tooltip:
			'''
			Statis’ mystical power surrounds you…
			When you take over 100 damage in one hit you become immune to damage for an extended period of time
			Grants an extra jump and increased jump height
			Effects of Fungal Clump, Mana Polarizer, and Fungal Symbiote
			'''
	}

	SnowRuffianEnchant: {
		Tooltip:
			'''
			Puedes planear para anular el daño por caída
			Los golpes críticos de Rogue infligen Quemadura gélida durante 3 segundos
			Otorga los efectos de la Joya del escurridizo and Frozen Cube
			'''
		DisplayName: Encantamiento del Rufián de la nieve
	}

	SilvaEnchant: {
		DisplayName: Encantamiento de Silva
		Tooltip:
			'''
			Boundless life energy cascades from you...
			You gain 3 HP/s life regen
			Max run speed and acceleration boosted by 5%
			If you are reduced to 1 HP you will not die from any further damage for 8 seconds
			This effect has a 5 minute cooldown. The cooldown does not decrement if any bosses or events are active.
			Magic projectiles which cannot pierce will occasionally set off potent blasts of nature energy
			Summons an ancient leaf prism to blast your enemies with life energy
			'''
		Tooltip_BardHealer: Taking heavy damage in one hit gives players with the lowest health the Guardian Angel buff for 30 seconds
		Tooltip_NoCrossmod: Effects of The Amalgam, Auric Soul Artifact, and Yharim's Gift
		Tooltip_Crossmod: Effects of Blunder Booster, Auric Soul Artifact, and Dynamo Stem Cells
	}

	ReaverEnchant: {
		Tooltip:
			'''
			Una muerte rápida aguarda a tus enemigos...
			Reduce en 20% la pérdida de regeneración de vida causada por efectos de daño prolongado
			30% menos velocidad de movimiento y tiempo de vuelo
			La Ira del saqueador se activa al recibir daño
			Otorga inmunidad al daño por caída y permite saltar sin parar
			Reduce el tiempo de recarga de los desplazamientos
			Resalta todo el tesoro cercano
			Aumenta el alcance de recolección de objetos y colocación de bloques
			Ahora puedes respirar bajo el agua
			Reduce la agresividad enemiga, incluso en el abismo
			Proporciona una pequeña cantidad de luz en el abismo
			Otorga los efectos de la Piedra floreciente y el Collar de vexación
			También otorga los efectos del Guante de imprudencia, Guante de precisión y La abeja
			'''
		DisplayName: Encantamiento del Saqueador
	}

	PlagueReaperEnchant: {
		DisplayName: Encantamiento del Segador de la plaga
		Tooltip:
			'''
			Effects of Plaguebringer Armor
			25% reduced ammo usage and 5% increased flight time
			Enemies receive 10% more damage from ranged projectiles when afflicted by the Plague
			Press Y to blind yourself for 5 seconds but massively boost your ranged damage
			This has a 25 second cooldown.
			'''
		Tooltip_NoCrossmod: Effects of Plague Hive, Plagued Fuel Pack, and The Camper
		Tooltip_Crossmod: Effects of Plague Hive, Alchemical Decanter, and The Camper
		Tooltip_2: Effects of Unholy Tonic and Vicious Tonic
	}

	OmegaBlueEnchant: {
		DisplayName: Encantamiento de Azul Omega
		Tooltip:
			'''
			The darkness of the Abyss has overwhelmed you...
			+2 max minions
			Short-ranged tentacles heal you by sucking enemy life
			Press Y to activate abyssal madness for 5 seconds
			Abyssal madness increases damage, critical strike chance, and tentacle aggression/range
			This effect has a 25 second cooldown
			'''
		Tooltip_NoCrossmod: Effects of the Abyssal Diving Suit and Reaper Tooth Necklace
		Tooltip_Crossmod: Effects of Old Duke Scales and Reaper Tooth Necklace
	}

	MolluskEnchant: {
		Tooltip:
			'''
			El mundo es tu ostra
			Dos moluscos te ayudan en combate
			10% más de reducción de daños
			Tu movimiento horizontal se ralentiza
			Otorga los efectos de la Perla gigante, Escudo del océano y Emblema acuático
			También otorga los efectos de la Cresta oceánica, Buzo profundo y el Regalo de Luxor
			'''
		DisplayName: Encantamiento de Molusco
	}

	GodSlayerEnchant: {
		DisplayName: Encantamiento del Asesino de Dioses
		Tooltip:
			'''
			The power to slay gods resides within you...
			Allows you to dash for an immense distance in 8 directions
			Press H while holding down the movement keys in the direction you want to dash
			Enemies you dash through take massive damage
			During the dash you are immune to most debuffs
			The dash has a 45 second cooldown
			Taking over 80 damage in one hit will cause you to release a swarm of high-damage god killer darts
			You fire a god killer shrapnel round while firing ranged weapons every 2.5 seconds
			While at full HP all of your rogue stats are boosted by 10%
			If you take over 80 damage in one hit you will be given extra immunity frames
			'''
		Tooltip_BardHealer:
			'''
			A calamity bell floats above your head and occasionally rings while attacking
			When the bell rings, enemies around you take 7500 true damage
			'''
		Tooltip_NoCrossmod: Effects of the Nebulous Core, Arc Flash Ring, and Crushing Ego
		Tooltip_Crossmod: Effects of Crushing Ego, Arc Flash Ring and Venetrated Locket
	}

	FearmongerEnchant: {
		DisplayName: Encantamiento del Intimidador
		Tooltip:
			'''
			20% increased summon damage and +2 max minions
			Minions no longer deal less damage while wielding non-summoner weapons
			Immunity to all forms of frost and flame
			Minion attacks grant +2.5 HP/s life regen and massively accelerate life regen
			This extra damage reduction ignores the soft cap
			'''
		Tooltip_NoCrossmod: Effects of Spectral Veil, Occult Skull Crown, and Statis' Void Sash
		Tooltip_Crossmod: Effects of Spectral Veil, Occult Skull Crown, and The Evolution
	}

	FathomSwarmerEnchant: {
		DisplayName: Encantamiento del Enjambre abisal
		Tooltip:
			'''
			10% increased summon damage and +2 max minions
			Grants the ability to climb walls
