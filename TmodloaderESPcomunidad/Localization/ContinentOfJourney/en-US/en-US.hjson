		Achievements: {
			DownedDeath: {
				FriendlyName: Deep Down We Know
				Description: Transcend World's End Everlasting Falling Whale, Death that bears the weight of countless lives.
			}

			DownedLifeGod: {
				FriendlyName: Return to Eden
				Description: Transcend the Lifebringer, the harmonic pond of consciousness and life.
			}

			DownedMatterGod: {
				FriendlyName: In the Movement
				Description: Transcend the Materealizer, throw yourself into the endless spiral.
			}

			DownedMyth: {
				FriendlyName: Not Anymore
				Description: Transcend Scarab Belief, traverse the sea of flowers growing in the nothingness.
			}

			DownedSon: {
				FriendlyName: Checkpoint!
				Description: Finish the ultimate ordeal, receive the approval of the Son.
			}

			DownedSunGod: {
				FriendlyName: Spectroscopist
				Description: Transcend Slime God, the cradle and homeland of everything slimy.
			}

			DownedTimeGod: {
				FriendlyName: Start, Continue, Loop
				Description: Transcend the Overwatcher, reach the end and beginning of time.
			}

			DownedBarrier: {
				FriendlyName: Second Spring
				Description: Defeat Wall of Shadow and break the seal.
			}
		}

		InAbyssCondition: In the Abyss
