			SurvivalCrisis: {
				DisplayName: Survival Crisis
				Tooltip:
					'''
					Increase armor penetration by 4
					Decrease non-summon damage, but increase them as you have more minions
					Drop non-summon crit chance to zero
					Summon damage boosts will apply to non-summon weapons
					Damage dealt by minions charge up the power meter
					When the meter is full, double tap UP to grant your team the following buffs:
					-restore original crit chances and increase them by the number of your minions
					-enable crit chance for summon weapons
					-increase summon critical strike chance by the number of your minions
					These effects last for 10 seconds
					'''
			}

