			PersonUnderFlower: {
				DisplayName: Person under Flower
				Tooltip:
					'''
					Heals you by 60 hp upon taking hit
					240 hp in stock
					Recovers stock when using a healing potion
					Consuming all stock enters a 8 minute cooldown
					Reduces the cooldown of healing potions by 25%
					Increase endurance by 4% when there's hp in stock
					Comsuming all stock increases your defense by 30 in 10 seconds
					'''
			}

			PersonUnderTheMoon: {
				DisplayName: Person under the Moon
				Tooltip:
					'''
					Heals you by 60 hp upon taking hit
					240 hp in stock
					Recovers stock when using a healing potion
					Consuming all stock enters a 8 minute cooldown
					Reduces the cooldown of healing potions by 25%
					Increase critical strike chance by 4% when there's hp in stock
					Comsuming all stock increases your damage by 10% in 10 seconds
					'''
			}

			AuroraMask: {
				DisplayName: Aurora Mask
				Tooltip:
					'''
					17% increased summon damage
					Increases your max number of sentries by 2
					Decreases your max number of minions by 4
					Right click to change form
					'''
			}

