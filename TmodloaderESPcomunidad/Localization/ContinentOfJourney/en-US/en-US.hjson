		Conditions: {
			BarrierDown: After the Wall of Shadow is defeated
			HasBooklet1or3: Having Ancient Builder Booklet Chapter 1 in inventory
			HasBooklet2or3: Having Ancient Builder Booklet Chapter 2 in inventory
			HasBooklet3: Having Ancient Builder Booklet Bound Volume in inventory
			BarrierThreeGods: After the Overwatcher, the Lifebringer and the Materealizer is defeated
			InBlizzardEnvironment: in Blizzard
			InJunglePostPlantera: In Jungle, after Plantera is defeated
			InHardmodeUnderground: In Underground, after Wall of Flesh is defeated
			InBeachPostPirate: At the Beach, after a pirate invasion is defeated
			SlimeRain: during a SlimeRain
		}

		Configs: {
			CoJConfigs: {
				DisplayName: Homeward Journey Server Configs

				TheTwinsMasterAIToggle: {
					Label: The Twins
					Tooltip: Toggles if the Twins run a custom AI in Master Mode
				}

				SpearEnabled: {
					Label: Spear Dash Enabled
					Tooltip: Toggles if right-clicking when holding a spear will perform dashing
				}

				AirblastEnabled: {
					Label: Airblast Enabled
					Tooltip: Toggles if right-clicking when holding a flamethrower will perform compression blasting
				}

				TheMotherbrainMasterAIToggle: {
					Label: The Motherbrain Master AI Toggle
					Tooltip: Toggles if the Motherbrain runs a custom AI in Master Mode
				}

				SlimeGodMasterAIToggle: {
					Label: Slime God Master AI Toggle
					Tooltip: Toggles if Slime God runs a custom AI in Master Mode
				}

				AbyssAtTheSameSideWithJungle: {
					Label: Abyss generates at the same side with Jungle
					Tooltip: ""
				}

				AirblastDamageMaximumMultiplier: {
					Label: Airblast Damage Maximum Multiplier
					Tooltip:
						'''
						Value of this config limits the maximum damage multiplier of reflected projectiles
						Damage of reflected projectiles increase as you progress
						You should keep it 7 in a normal run, as this config is used for testing.
						0 for x1
						1 for x6.66-after Eye of Cthulhu, Eater of Worlds/Brain of Cthulhu and Skeletron are defeated 
						2 for x9-after Wall of Flesh is defeated
						3 for x10-after the Twins, Destroyer and Skeletron Prime are defeated
						4 for x12-after Golem is defeated
						5 for x50-after the Motherbrain is defeated
						6 for x90-after Wall of Shadow is defeated
						7 for x120-after the Overwatcher, the Lifebringer and the Materealizer are defeated
						'''
				}

				TheLifebringerMasterAIToggle: {
					Label: The Lifebringer Master AI Toggle
					Tooltip: Toggles if the Lifebringer runs a custom AI in Master Mode
				}

				TheSonMasterAIToggle: {
					Label: The Son Master AI Toggle
					Tooltip: This config doesn't work now
				}

				WorldsEndEverlastingFallingWhaleMasterAIToggle: {
					Label: World's End Everlasting Falling Whale Master AI Toggle
					Tooltip: Toggles if World's End Everlasting Falling Whale runs a custom AI in Master Mode
				}

				UseAltWhaleMusic: {
					Label: Use Alt Theme for World's End Everlasting Falling Whale
					Tooltip: ""
				}

				OverwatcherMasterAIToggle: {
					Label: The Overwatcher Master AI Toggle
					Tooltip: Toggles if the Overwatcher runs a custom AI in Master Mode
				}

				EnableMasterAIInExpert: {
					Label: Enable Master AI In Expert
					Tooltip:
						'''
						Keep in mind that the stats in these AIs aren't designed for Expert,
						and there's a chance that they can be very messed up.
						Please report any abnormal damage you encountered
						and one day we will fix it thoroughly. 
						'''
				}

				UseAltOverwatcherMusic: {
					Label: Use Alt Theme for The Overwatcher
					Tooltip: ""
				}

				TheMaterealizerMasterAIToggle: {
					Label: The Materealizer Master AI Toggle
					Tooltip: Toggles if the Materealizer runs a custom AI in Master Mode
				}

				DialogueOn: {
					Label: Dialogue Mode
					Tooltip:
						'''
						Value of this config determines whether some bosses will start a dialogue.
						These dialogues only run in singleplayer mode.
						Set this to 0 to disable all dialogues
						Set this to 1 to allow dialogue on their first summon and first defeat
						Set this to 2 to always run said dialogues
						'''
				}

				DisableWeather: {
					Label: Disable Weather
					Tooltip: Turn this on in case the weathers of this mod cause compatibility or performance issues
				}
			}

			CoJConfigsClient: {
				DisplayName: Homeward Journey Client Configs

				SlimeGodEagleSoundVolumn: {
					Label: Slime God Eagle Sound Volume
					Tooltip: ""
				}

				WeatherVisualOverlayAlpha: {
					Label: Weather Visual Opacity
					Tooltip: The smaller the value is, the more transparent the weather effect will be
				}
			}
		}

