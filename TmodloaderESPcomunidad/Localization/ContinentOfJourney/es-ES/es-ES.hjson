				DisplayName: Poción derechista
				Tooltip:
					'''
					Daño recibido desde la derecha disminuido en un 10%
					Daño recibido desde la izquierda aumentado en un 10%
					'''
			}

			FlappyPotion: {
				DisplayName: Poción voladora
				Tooltip:
					'''
					Tu salto en el aire nunca se agota
					Deduce el 80% de tu vida al aterrizar y elimina el beneficio
					'''
			}

			GreedPotion: {
				DisplayName: Poción de codicia
				Tooltip:
					'''
					Muestra la ubicación de tesoros y minerales
					Los enemigos sueltan monedas al ser golpeados
					Aumenta la tasa de aparición de monstruos
					Aumenta el daño recibido en un 25%
					'''
			}

			KiwiPotion: {
				DisplayName: Poción de kiwi
				Tooltip:
					'''
					Concede tiempo de vuelo infinito
					Deduce el 80% de tu vida al aterrizar y elimina el beneficio
					'''
			}

			AttractPotion: {
				DisplayName: Poción de atracción
				Tooltip:
					'''
					Disminuye el daño recibido en un 15%
					Los proyectiles disparados hacia ti ganan un aumento de velocidad
					Disminuye la velocidad de los proyectiles que se alejan de ti
					'''
			}

			BravePotion: {
				DisplayName: Poción valiente
				Tooltip:
					'''
					Muestra un campo con un radio de 12.5 bloques
					Los enemigos dentro del campo reciben un 10% más de daño
					Los enemigos fuera del campo reciben un 10% menos de daño
					'''
			}

			HyperopiaPotion: {
				DisplayName: Poción de hipermetropía
				Tooltip:
					'''
					Aumenta la velocidad de disparo en un 25%
					Muestra un campo con un radio de 31 bloques
					Los enemigos dentro del campo reciben un 20% más de daño
					Los enemigos fuera del campo reciben un 20% menos de daño
					'''
			}

			MermaidPotion: {
				DisplayName: Poción de sirena
				Tooltip:
					'''
					Proporciona respiración acuática
					Aumenta la regeneración bajo el agua
					Sofocación cuando estás fuera del agua
					'''
			}

			ParasitePotion: {
				DisplayName: Poción de parásito
				Tooltip:
					'''
					Usar cualquier arma te cuesta un 5% de vida
					Golpear enemigos te restaura un 6% de vida
					El efecto tiene un tiempo de reutilización de 0.2 segundos
					No tiene efecto en objetos de invocación de súbditos
					'''
			}

			SignalPotion: {
				DisplayName: Poción de señal
				Tooltip:
					'''
					Disminuye la vida máxima en un 50%
					Los enemigos siempre apuntan a 10 bloques por encima de ti
					'''
			}

			NukePotion: {
