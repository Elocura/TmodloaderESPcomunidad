					'''
			}

			FlowerOil: {
				DisplayName: Aceite de flor
				Tooltip:
					'''
					Golpear enemigos con yoyós carga un escudo floral
					El escudo se carga completamente tras 15 golpes
					El escudo reduce hasta un 10% del siguiente daño que recibas
					El escudo aumenta la regeneración hasta en 10
					El escudo se lanza al recuperar el yoyó
					'''
			}

			FortressBelt: {
				DisplayName: Cinturón de fortaleza
				Tooltip:
					'''
					Al sostener un arma cuerpo a cuerpo, mantén clic izquierdo para cargar
					Las armas que no disparan proyectiles obtienen un bono de daño extra
					'''
			}

			GhostOil: {
				DisplayName: Aceite espectral
				Tooltip:
					'''
					Golpear enemigos con yoyós carga un escudo espectral
					El escudo se carga completamente tras 15 golpes
					El escudo reduce hasta un 10% del siguiente daño que recibas
					El escudo aumenta tu velocidad de movimiento hasta un 20%
					Un escudo espectral cargado al máximo otorga tiempo de vuelo infinito
					El escudo se lanza al recuperar el yoyó
					'''
			}

			GrindStone: {
				DisplayName: Piedra de afilar
