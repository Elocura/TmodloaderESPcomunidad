			BatSignal: {
				DisplayName: Señal de murciélago
				Tooltip:
					'''
					Aumenta tus espacios de súbdito en 1
					Tus súbditos incendiarán a los enemigos
					'''
			}

			BattalionsBackup: {
				DisplayName: Refuerzo del batallón
				Tooltip:
					'''
					Aumenta tu vida máxima en 4 y la defensa en 2 por cada súbdito invocado
