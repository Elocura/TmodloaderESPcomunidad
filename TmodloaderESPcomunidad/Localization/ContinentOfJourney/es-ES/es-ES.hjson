			FrameWooden: {
				DisplayName: Marco de madera
				Tooltip:
					'''
					Aumenta la velocidad de movimiento en un 4%
					Debe llenarse con un sello
					Pasar rozando enemigos y proyectiles hostiles llena el medidor de energía
					Pulsa ARRIBA dos veces para activar el poder del sello
					Nivel de potencia del sello: 1
					Máximo de sellos: 2
					'''
			}

			BadgeMushroom: {
				DisplayName: Sello de champiñón
				Tooltip:
					'''
					Puede colocarse en marcos de sello
					Activar el sello cura a tu equipo
					'''
			}

			BadgeBad: {
				DisplayName: Sello malo
				Tooltip:
					'''
					Puede colocarse en marcos de sello
					Activar el sello mejora tu movilidad
					Autorrelleno cuando no hay energía almacenada
					'''
			}

			BadgeClock: {
				DisplayName: Sello de reloj
				Tooltip:
					'''
					Puede colocarse en marcos de sello
					Activar el sello detiene el tiempo
					El medidor de sello de reloj almacenado se borrará al invocar a un jefe
					'''
			}

			BadgeFinal: {
				DisplayName: Sello final
				Tooltip:
					'''
					Puede colocarse en marcos de sello
					Activar el sello inflige daño verdadero a tus enemigos
					'''
			}

			BadgeForgotten: {
				DisplayName: Sello olvidado
