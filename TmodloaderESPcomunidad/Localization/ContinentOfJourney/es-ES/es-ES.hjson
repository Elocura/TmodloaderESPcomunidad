		Configs: {
			CoJConfigs: {
				DisplayName: Configuraciones del servidor Viaje hacia el hogar

				TheTwinsMasterAIToggle: {
					Label: Los Gemelos
					Tooltip: Alterna si los Gemelos ejecutan una IA personalizada en modo Maestro
				}

				SpearEnabled: {
					// Label: Spear Dash Enabled
					// Tooltip: Toggles if right-clicking when holding a spear will perform dashing
				}

				AirblastEnabled: {
					Label: Ráfaga de aire activada
					Tooltip: Alterna si al hacer clic derecho mientras sostienes un lanzallamas realizarás una ráfaga de compresión
				}

				TheMotherbrainMasterAIToggle: {
					Label: Alternar IA de Maestro del Cerebro Madre
					Tooltip: Alterna si el Cerebro Madre ejecuta una IA personalizada en modo Maestro
				}

				SlimeGodMasterAIToggle: {
					Label: Alternar IA de Maestro del Dios Slime
					Tooltip: Alterna si el Dios Slime ejecuta una IA personalizada en modo Maestro
				}

				AbyssAtTheSameSideWithJungle: {
					Label: El abismo se genera en el mismo lado que la jungla
					Tooltip: ""
				}

				AirblastDamageMaximumMultiplier: {
					Label: Multiplicador máximo de daño de ráfaga de aire
					Tooltip:
						'''
						El valor de esta configuración limita el multiplicador máximo de daño de los proyectiles reflejados
						El daño de los proyectiles reflejados aumenta a medida que avanzas
						Deberías mantenerlo en 7 en una partida normal, ya que esta configuración se usa para pruebas.
						0 para x1
						1 para x6.66-después de derrotar al Ojo de Cthulhu, Devorador de mundos/Cerebro de Cthulhu y Skeletron 
						2 para x9-después de derrotar al Muro de carne
						3 para x10-después de derrotar a los Gemelos, al Destructor y a Skeletron Prime
						4 para x12-después de derrotar al Gólem
						5 para x50-después de derrotar al Cerebro Madre
						6 para x90-después de derrotar al Muro de sombras
						7 para x120-después de derrotar al Observador, al Portador de vida y al Materializador
						'''
				}

				TheLifebringerMasterAIToggle: {
					Label: Alternar IA de Maestro del Portador de vida
					Tooltip: Alterna si el Portador de vida ejecuta una IA personalizada en modo Maestro
				}

				TheSonMasterAIToggle: {
					Label: Alternar IA de Maestro del Hijo
					Tooltip: Esta configuración no funciona actualmente
				}

				WorldsEndEverlastingFallingWhaleMasterAIToggle: {
					Label: Alternar IA de Maestro de la Ballena caída eterna del fin del mundo
					Tooltip: Alterna si la Ballena caída eterna del fin del mundo ejecuta una IA personalizada en modo Maestro
				}

				UseAltWhaleMusic: {
					Label: Usar tema alternativo para la Ballena caída eterna del fin del mundo
					Tooltip: ""
				}

				OverwatcherMasterAIToggle: {
					Label: Alternar IA de Maestro del Observador
					Tooltip: Alterna si el Observador ejecuta una IA personalizada en modo Maestro
				}

				EnableMasterAIInExpert: {
					Label: Habilitar IA de Maestro en Experto
					Tooltip:
						'''
						Ten en cuenta que las estadísticas en estas IA no están diseñadas para el modo Experto,
						y existe la posibilidad de que no funcionen correctamente.
						Por favor, informa de cualquier daño anormal que encuentres
						y algún día lo corregiremos a fondo. 
						'''
				}

				UseAltOverwatcherMusic: {
					Label: Usar tema alternativo para el Observador
					Tooltip: ""
				}

				TheMaterealizerMasterAIToggle: {
					Label: Alternar IA de Maestro del Materializador
					Tooltip: Alterna si el Materializador ejecuta una IA personalizada en modo Maestro
				}

				DialogueOn: {
					Label: Modo de diálogo
					Tooltip:
						'''
						El valor de esta configuración determina si algunos jefes iniciarán un diálogo.
						Estos diálogos solo funcionan en modo de un solo jugador.
						Establece esto en 0 para deshabilitar todos los diálogos
						Establece esto en 1 para permitir el diálogo en su primera invocación y primera derrota
						Establece esto en 2 para ejecutar siempre dichos diálogos
						'''
				}

				DisableWeather: {
					Label: Deshabilitar clima
					Tooltip: Activa esto en caso de que los climas de este mod causen problemas de compatibilidad o rendimiento
				}
			}

			CoJConfigsClient: {
				DisplayName: Configuraciones del cliente Viaje hacia el hogar

				SlimeGodEagleSoundVolumn: {
					Label: Volumen del sonido del águila del Dios Slime
					Tooltip: ""
				}

				WeatherVisualOverlayAlpha: {
					Label: Opacidad visual del clima
					Tooltip: Cuanto menor sea el valor, más transparente será el efecto climático
				}
			}
		}

