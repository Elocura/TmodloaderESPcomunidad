					Ignora parte de la armadura de los enemigos.
					'''
			}

			AncientBonds: {
				DisplayName: Lazos ancestrales
				Tooltip:
					'''
					Los enemigos alcanzados por este látigo son atravesados por una espada espectral en el siguiente ataque del súbdito
					La espada espectral inflige el 20% del daño del súbdito tres veces seguidas
					El daño por atravesamiento tiene 5 de penetración de armadura.
					'''
			}

			PrimalBonds: {
