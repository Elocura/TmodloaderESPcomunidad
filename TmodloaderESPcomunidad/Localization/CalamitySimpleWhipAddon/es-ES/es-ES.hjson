			SkybreakerCoil: {
				DisplayName: Bobina quebrantanubes
				Tooltip:
					'''
					Todos los enemigos alcanzados por este látigo reciben 1,30 veces más daño del siguiente ataque de un súbdito y desatan una descarga eléctrica
