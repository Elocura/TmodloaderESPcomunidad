					'''
			}

			Milkyway: {
				DisplayName: Vía láctea
				Tooltip:
					'''
					+10 de daño de etiqueta de invocación por acumulación
					Los enemigos alcanzados por este látigo reciben un golpe crítico garantizado de un súbdito que inflige 4 veces dicho daño
					El efecto de este látigo se acumula consigo mismo
					Un número de cometas igual al de las acumulaciones orbita alrededor del enemigo
					'''
			}

			KusariGama: {
				DisplayName: Kusari Gama
				Tooltip:
					'''
					Multiplica un 1,13 el daño de etiqueta de invocador
