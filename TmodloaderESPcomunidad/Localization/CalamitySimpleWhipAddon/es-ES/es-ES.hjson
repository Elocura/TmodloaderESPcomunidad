					'''
			}

			AurelianSanctum: {
				DisplayName: Santuario Aureliano
				Tooltip:
					'''
					80 de daño de etiqueta de invocación
					Al golpear a los enemigos, se desata una lluvia implacable de proyectiles que infligen el 200% del daño de los súbditos
					'''
			}

			KingsMajesty: {
				DisplayName: Su Majestad el Rey
				Tooltip:
					'''
					2 de daño de etiqueta de invocación
					4% de probabilidad de golpe crítico de la etiqueta de invocación
					Mientras empuñas este látigo, una gema te sigue
					y ataca cada vez que tus esbirros infligen daño a un enemigo marcado por el látigo
					El ataque de la gema inflige el 50% del daño del golpe que lo ha activado
					La gema se carga al instante antes de disparar,
					añadiendo a su ataque un 5% del daño infligido durante la carga
					'''
			}

			EmeraldSplash: {
				DisplayName: Salpicadura de esmeralda
				Tooltip:
					'''
