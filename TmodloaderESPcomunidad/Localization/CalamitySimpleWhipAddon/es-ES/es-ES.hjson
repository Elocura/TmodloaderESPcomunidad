			MandibleLash: {
				DisplayName: Látigo mandibular
				Tooltip:
					'''
					1 daño de etiqueta de invocador
					Los enemigos alcanzados por este látigo hacen que el siguiente ataque del súbdito lance una bola de arena
					La bola de arena se ve afectada por la gravedad e inflige el 40% del daño del súbdito
					La bola de arena explota al chocar contra un obstáculo, dañando a los enemigos cercanos
					'''
			}

			DarkMandibleLash: {
				DisplayName: Látigo mandibular oscuro
				Tooltip:
					'''
					2 daño de etiqueta de invocador
					Los enemigos alcanzados por este látigo hacen que el siguiente ataque del súbdito lance una bola de arena
					La bola de arena se ve afectada por la gravedad e inflige el 40 % del daño del súbdito
					La bola de arena explota al chocar contra un obstáculo, dañando a los enemigos cercanos
					'''
			}

			ShieldConduit: {
				DisplayName: Conducto blindado
				Tooltip:
					'''
					2 daño de etiqueta de invocador
					Cambia automáticamente entre dos modos:
					'''
				HoldShiftTooltip:
					'''
					-----------------------------
					Modo Defensa:
					Al golpear a un enemigo con el látigo, los ataques de los súbditos liberan fragmentos de escudo azul
					durante un breve periodo de tiempo.
					Al recoger los fragmentos, se acumula cargas de escudo.
					Con 50 cargas, se obtiene un escudo de 50 puntos de vida
					-----------------------------
					Modo Ataque:
					Al golpear a un enemigo con el látigo, los ataques de los súbditoss liberan fragmentos de escudo rojos 
					durante un breve periodo de tiempo
					Los fragmentos rojos se dirigen hacia los enemigos,
					infligiendo un 10% del daño de los súbditos +3 de daño fijo
					-----------------------------
					La liberación de fragmentos de escudo tiene un tiempo de enfriamiento muy corto.
					Cuando el escudo recibe daño, entra en un enfriamiento que dura entre 5 y 50 segundos, dependiendo del escudo restante.
					Si el escudo se rompe por completo, el tiempo de recarga pasa a ser de 60 segundos.
					Durante el tiempo de recarga, cambia al modo de ataque. Cuando finaliza el tiempo de recarga, cambia al modo de defensa.
					Si queda algo de escudo, al recoger fragmentos se restaurará la durabilidad del escudo
					'''
			}

			ShieldConduitMkII: {
				DisplayName: Conducto blindado Mk-II
				Tooltip:
