ClamitasSummoningItem: {
	DisplayName: Caparazón clamitoso
	Tooltip:
		'''
		Invoca a Clamitas cuando se usa en los Riscos de Azufre
		No se consume al usarlo
		'''
}

EyeofStupidity: {
	DisplayName: Ojo de la estupidez
	Tooltip:
		'''
		Invoca a una Calamitas suprema suprema legendaria de la supremacía con una camiseta de Xeroc suprema
		Hola, AdamChromeE
		'''
}

PyroKey: {
	DisplayName: Llave pirotécnica
	Tooltip:
		'''
		Invoca a Pirógeno cuando se usa en el desierto
		Haz clic derecho para invocarlo sin la animación de invocación
		Pirógeno se enfurecerá al salir del desierto
		No se consume al usarlo
		'Una llave para un horno cúbico.'
		'''
}

AncientConsole: {
	DisplayName: Consola antigua
	Tooltip:
		'''
		Cuando estés en el Infierno, haz clic derecho para invocar el Muro de Bronce
		El Muro de Bronce desaparecerá si sales del Infierno
		ADVERTENCIA: Si estás en modo multijugador, utiliza el objeto de invocación en lugar de ítem (que se fabrica a partir de este objeto).
		'''
}

WoBSummonItem: {
	Tooltip:
		'''
		Invoca al Muro de bronce 
		No se consume al usarlo
		'''
	DisplayName: Máquina de bronce técnica alternativa
}

