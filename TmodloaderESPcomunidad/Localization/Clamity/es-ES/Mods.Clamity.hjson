Items: {
	Mounts: {
		FlameCube: {
			DisplayName: Exo caja (Edición Calamity)
			Tooltip:
				'''
				Crea un trono exo volador al estilo Calamitas, muy acogedor y extremadamente ágil
				Presiona [KEY] mientras estás sentado en el trono para moverte con más lentitud y precisión
				"Un jugador enfadado es un jugador muy peligroso"
                "Nota al margen: lleva equipo de protección contra el fuego, por si se te había olvidado"
				'''
		}

		PlagueStation: {
			DisplayName: Exo caja (Edición Plaga)
			Tooltip:
				'''
				Crea un trono exo volador al estilo de la plaga, muy acogedor y extremadamente ágil.
				Presiona [KEY] mientras estás sentado en el trono para moverte con más lentitud y precisión
				'Un jugador radical es un jugador vírico'
				'''
		}
	}

	BaseBook1: {
		DisplayName: Papel de impresora
		ObtainmentHint: "[c/F79BC6:Este libro lo vende el comerciante habitual]"
		Tooltip: Solo una hoja de papel normal y corriente y en blanco
	}

	BaseBook2: {
		DisplayName: Folleto común
		ObtainmentHint: "[c/F79BC6:Este libro lo vende alguien que está maldito]"
		Tooltip:
			'''
			Es solo un folleto cualquiera, en el que te recomienda viajar a distintos lugares
			Está lleno de anuncios, como siempre
			'''
	}

	BaseBook3: {
		DisplayName: Libro básico
		ObtainmentHint: "[c/F79BC6:Este libro lo vende un archimago]"
		Tooltip: Es solo un libro cualquiera, no tiene nada de especial
	}

	BaseBook4: {
		DisplayName: Libro común
		ObtainmentHint: "[c/F79BC6:Este libro lo vende un mago al que le gusta vivir en la Bendición]"
		Tooltip:
			'''
			Está escrito en un idioma que sí entiendes
			Sin embargo, este tomo no sirve para nada...
			'''
	}

	HowToClamity: {
		DisplayName: Cómo hacer una "Clamidad"
		ObtainmentHint: "[c/F79BC6:Una almeja que se refugia en el Azafure tiene este libro en su poder]"
		Tooltip:
			'''
			Un manual sobre cómo provocar un suceso clamitoso
			A medida que lo lees, empiezas a sentir que tu mente se te escapa...
			Cerraste el libro antes de que fuera demasiado tarde, pero aún puedes oír el chasquido de las almejas en tu mente
			'''
	}
}

