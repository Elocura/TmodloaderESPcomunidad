		}

		UsesClamityWeaponsInCalamityRecipes: {
			Label: Armas de Clamity en las recetas de Calamity
			Tooltip: Añade armas de este mod a algunas recetas de Calamity
		}

		PermafrostSoldEnchantedMetal: {
