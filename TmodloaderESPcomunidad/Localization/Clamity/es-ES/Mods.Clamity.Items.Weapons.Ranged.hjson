DepthsEchoRifle: {
	DisplayName: Rifle de eco profundo
	Tooltip: Convierte las balas de mosquete en proyectiles de azufre teledirigidos
}

Obsidigun: {
	DisplayName: Pistobsidiana
	Tooltip: Convierte las balas de mosquete en balas de obsidiana de gran velocidad que se rompen en muchos fragmentos al impactar
}

RoseBow: {
	DisplayName: Arco de la rosa
	Tooltip:
		'''
		Dispara una lluvia de flechas y pétalos teledirigidos
		'Aunque no puedas verme, aunque no puedas oírme, estaré a tu lado'
		'''
}

WitheredBoneBow: {
	DisplayName: Arco tormentoso marchito
	Tooltip:
		'''
		Convierte flechas de madera en proyectiles de hueso marchito
		Los proyectiles crean una copia detrás del jugador al golpear hasta dos veces
		Los rayos infligen [cbuff:CalamityMod/WitherDebuff] y tienen 15 de penetración de armadura
		'¿He oído a alguien decir "taco"?'
		'''
}

