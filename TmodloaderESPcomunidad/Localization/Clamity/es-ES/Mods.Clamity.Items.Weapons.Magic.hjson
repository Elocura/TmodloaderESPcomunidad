Unicron: {
	DisplayName: Unicron
	Tooltip:
		'''
		Dispara una ráfaga continua de rayos láser y genera cuatro compañeros de escuadrón que orbitan a tu alrededor y disparan rayos láser o lanzan granadas hacia tu cursor
		Pulsa <right> mientras disparas para lanzar un rayo Omicron que se divide al impactar contra un enemigo
		Tras disparar un rayo Unicron, tus compañeros de escuadrón lanzarán un par de granadas
		Si impactas a un enemigo con un rayo Omicron justo en el momento en que se dispara, el daño infligido aumentará considerablemente y evitarás que se divida
		'''
}

TheGenerator: {
	DisplayName: El generador
	Tooltip: Lanza un sello maestro en forma de corona que se dirige hacia los enemigos cercanos y los atrae
}

MoonstoneKnives: {
	DisplayName: Cuchillos de piedra lunar
	Tooltip: Lanza varios cuchillos que restauran el maná al usuario
}

EtherealKnives: {
	DisplayName: Cuchillos etéreos
	Tooltip: Lanza una lluvia de cuchillos que restauran el maná al usuario
}

GaiaRose: {
	DisplayName: Rosa de Gaia
	Tooltip: Lanza una flor de la selva que estalla en pétalos
}

