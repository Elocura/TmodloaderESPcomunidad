Wings: {
	MetalWings: {
		DisplayName: Alas de metal
		Tooltip:
			'''
			Velocidad horizontal: 10,50
			Multiplicador de aceleración: 2,8
			Excelente velocidad vertical
			Tiempo de vuelo: 280
			La defensa de todos los jugadores de tu equipo aumenta en 20 mientras llevas puesta la Armadura helada
            Recupera parte del tiempo de vuelo al recibir daño
			'''
		HoldShiftTooltip: "La cantidad de tiempo de vuelo recuperado es igual a la relación entre el daño recibido y la vida máxima, dividida por 2"
	}
}


SoulOfPyrogen: {
	DisplayName: Alma de Pirógeno
	Tooltip:
		'''
		Aumenta un 10% el daño cuerpo a cuerpo y rogue
		Los ataques cuerpo a cuerpo verdaderos y ataques sigilosos invocan lanzas desde las profundidades del infierno
		'''
}

DraculasCharm: {
	DisplayName: Hechizo de Drácula
	Tooltip:
		'''
		Aumenta un 15% el daño rogue y aumenta en 10 el sigilo máximo
		Los golpes críticos rogue roban vida al enemigo
		Los golpes en sigilo otorgan un 15% de probabilidad de golpe crítico y un aumento del robo de vida a los golpes que no sean en sigilo durante 10 segundos
		Estos infligen Hemorragia grave y Aplastamiento de armadura, e infligen un 8% más de daño
		también invocan un enjambre de murciélagos vampiros que roban vida
		Los proyectiles rogue explotan en almas autoguiadas
		"Poseer el talismán te hace ansiar sangre y almas»
		'''
}

PyroStone: {
	DisplayName: Piedra pirotécnica
	Tooltip:
		'''
		Aumenta un 50% el daño de la desventaja Calor
		Crea un escudo de fuego que gira a tu alrededor, dañando en incendiando a los enemigos al tocarlo
		'Una de las reliquias antiguas'
		'''
}

HellFlare: {
	DisplayName: Llama infernal
	Tooltip:
		'''
		Todos los ataques y proyectiles infligen [cbuff:OnFire3]
		Otorga inmunidad a [cbuff:OnFire] y [cbuff:OnFire3]
		Si tienes más del 50% de vida, aumenta la probabilidad de crítico en un 10%
		Si tienes menos del 50% de vida, aumenta la reducción de daño en un 10%
		Otorga resistencia contra los ataques de frío
		'''
}

SupremeBarrier: {
	DisplayName: Barrera suprema
	Tooltip:
		'''
		{$Mods.CalamityMod.Common.KnockbackImmunity}
		Permite realizar un dash, potenciado por un infierno cósmico
		Este dash permite arrollar a los enemigos sin sufrir daño
		Lanza una ráfaga de abejas estelares autoguiadas [TOGGLE] y te cubre de [cbuff:Honey] tras recibir daño
		Aumenta la duración de la invencibilidad, que se incrementa aún más cuando tienes poca vida o recibes ataques que infligen mucho daño
		Reduce el daño recibido en un 25% cuando tienes menos del 50% de vida
		Absorbe el 25% del daño infligido a los jugadores de tu equipo cuando tienes más del 25% de vida
		[c/aaaaaa:Pulsa Mayús + <right> sobre este objeto en tu inventario para activarlo o desactivarlo] [i:PanicNecklace] [c/aaaaaa:Efecto del Collar del Pánico]
		'''
		ToggleEffect: ", aumenta la velocidad de movimiento,"
}

IcicleRing: {
	DisplayName: Anillo de carámbano
	Tooltip:
		'''
		Reduce el coste de maná a cero
		El portador sufre daño constante por el dolor que provoca este accesorio
		'''
}

RedDie: {
	DisplayName: Dado rojo
	Tooltip:
		'''
		1.5x de suerte
		La suerte aumenta un 20% extra
		'¿Estás listo para volver a tirar los dados?'
		'''
}

EidolonAmulet: {
	DisplayName: Amuleto de Eidolón
	Tooltip:
		'''
		<Se puede modificar tras la revisión de los accesorios>
		Aumenta un 60% el daño de la desventaja de Agua
		Acumula lentamente hasta tres espíritus abisales diferentes
		Haz una embestida para dispersar a los espíritus y hacer que ataquen a los enemigos
		Cuando se dispersan [c/CB7AD7:por debajo del 50% de vida], los espíritus te apoyan en su lugar
		Los espíritus aparecen en orden y tienen efectos diferentes según su color:
        [c/3CB371: Explota al impactar e inflige Profundidad aplastante] / [c/CB7AD7: Cura 8 puntos de vida]
        [c/FF4500: Atraviesa a los enemigos e inflige Fuego infernal] / [c/CB7AD7: Aumenta la defensa en 10 temporalmente]
		[c/1E90FF: Golpea varias veces e inflige Presión hadopelágica] / [c/CB7AD7: Cura el 5 % de los PV máximos]
        Los espíritus son transparentes y silenciosos cuando la visibilidad está desactivada
		'''
}

reasureOfClamity: {
	DisplayName: El tesoro de Clamity
	Tooltip:
		'''
		Aumenta la habilidad de pesca en 25
		Aumenta el rendimiento de los peces que sirven como ingredientes para pociones
		Aumenta en un 15 % la probabilidad de pescar cajas y peces que contienen botín
		Las capturas de cajas tienen un 25 % más de probabilidades de ser de mayor calidad y de ir acompañadas de perlas visuales[ACTIVAR/DESACTIVAR]
		[c/aaaaaa:Pulsa Mayús + <right> sobre este objeto en tu inventario para activarlo o desactivarlo] [i:CalamityMod/PearlofEnthrallment] [c/aaaaaa:Invocación de la Perla del encanto]
		'''
	ToggleEffect:
		'''

		Invoca a un elemental de agua para que proteja
		'''
}

SeaShell: {
	DisplayName: Caparzón marino
	Tooltip: Aumenta la defensa, la reducción del daño y la velocidad de movimiento mientras se está mojado
}

TheSubcommunity: {
	DisplayName: La subcomunidad
	Tooltip:
		'''
		[STATS]
		'La parte de La comunidad (de la calamidad)'
		'Cuenta con su propia especialización.'
		[c/B00BA5:¡Gracias a todos mis seguidores que hicieron posible este addon!]
		'''
	StatsList:
		'''
		Incrementa la velocidad de minería en {0}%
		Incremente la suerte en {1} y la capacidad de pesca en {2}
		Aumenta la velocidad al colocar bloques y paredes en {3}% y el rango de colocación en {4}
		Ganarás más poder al derrotar a jefes ({5}% de poder)
		'''
}

MagicDiamond: {
	DisplayName: Diamante mágico
	Tooltip:
		'''
		Infligir daño mágico crea una pequeña barrera
		Cada ataque mágico aumenta la durabilidad de la barrera
		Se puede almacenar hasta 20 de durabilidad
		'''
}

SharpAmethyst: {
	DisplayName: Amatista afilada
	Tooltip:
		'''
		Al disparar una flecha, existe la posibilidad de crear una flecha de gema adicional
		Las flechas de gema infligen un 20% más de daño que las flechas normales
		'''
}

BlightedSpyglass: {
	DisplayName: Catalejo arruinado
	Tooltip:
		'''
		+1 de capacidad de centinelas
		Los centinelas infligen [cbuff:CalamityMod/BrimstoneFlames]
		'''
}

CyanPearl: {
	DisplayName: Perla cian
	Tooltip:
		'''
		+7% de daño de invocación
		Reduce a la mitad la penalización de daño de invocación de las centinelas
		'''
	HoldShiftTooltip:
		'''
		Cuando se empuñen armas que no sean de invocación ni de tipo estándar, los centinelas infligirán 0,875 veces el daño en lugar de 0,75 veces
		Además, no se aplicará penalización si se empuñan armas sin clase o si está activo el Ejército de los Antiguos
		'''
}

SkullOfTheBloodGod: {
	DisplayName: Cráneo del Dios de la sangre
	Tooltip:
		'''
		Aumenta el daño un 15% y la probabilidad de golpe crítico mágico un 7
		Aumenta el maná máximo en 20
		Invoca una efigie sobre tu cabeza que almacena maná a medida que lo utilizas, hasta un máximo de 600 de maná
		La efigie emite pulsos ocasionalmente, restaurando 25 de maná, y los pulsos aparecen con mayor frecuencia cuanto más maná se almacena
		Al recibir un golpe, la efigie libera todo el maná almacenado en forma de almas vengativas que persiguen a tus enemigos
		La efigie es transparente y silenciosa si la visibilidad está desactivada
		Los golpes críticos maldicen a los enemigos con [cbuff:CalamityMod/Bane], cuyo efecto aumenta considerablemente en función de tu probabilidad de golpe crítico
		Al recibir un golpe crítico, los enemigos transmiten a los enemigos cercanos todas las desventajas que padecen y que sean más débiles que tu [cbuff:CalamityMod/Bane]
		Los golpes críticos infligen un 3% de daño adicional por cada desventaja que tenga el enemigo
		'''
	ToggleEffect: Llamas calamitosas llueven mientras se es invencible.
}

