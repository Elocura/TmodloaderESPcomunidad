			'''
			{$CommonItemTooltip.MajorStats}
			Aumenta en 1 el umbral de {$CalamityMod.Buffs.AlcoholPoisoning.DisplayName}
			'''
	}

	SoulBaguette: {
		DisplayName: Baguette del alma
		Tooltip: "{$CommonItemTooltip.MediumStats}"
	}

	Eldercherry: {
		DisplayName: Cereza anciana
		Tooltip:"{$CommonItemTooltip.MediumStats}"
	}

	EldercherryJuice: {
		DisplayName: Jugo de cereza anciana
		Tooltip: "{$CommonItemTooltip.MajorStats}"
	}

	SlagspitterPauldron: {
		DisplayName: Espaldares rompeescorias
		Tooltip: "{$CommonItemTooltip.MajorStats}"
	}

	ClamChowder: {
		DisplayName: Sopa de almejas
		Tooltip:
			'''
			"{$CommonItemTooltip.MediumStats}"
			'Es el nuevo estilo de Ilmeris'
			'''
	}

	Barolegs: {
		DisplayName: Patas de baro
		Tooltip:
			'''
			Mejoras variables en todas las estadísticas
			Derrota al elemental de agua que se encuentra en el océano y a su majestuosa bestia para mejorar su sabor
			Derrota a un enemigo fantasmal que se encuentra en la mazmorra para mejorar aún más su sabor
			'¡La carne parece provenir de un barocangrejo!
			No es que importe, de todos modos está rancia'
			'''
	}

	Calamitea: {
		DisplayName: Té de la calamidad
		Tooltip:
			'''
			"{$CommonItemTooltip.MajorStats}"
			'Menuda calamidad'
			'''
	}
}

SupremeLuckPotion: {
	DisplayName: Poción de suerte suprema
	Tooltip: Aumenta considerablemente la suerte del usuario
}

TitanScalePotion: {
	DisplayName: Poción de escama de titán
	Tooltip:
		'''
		Aumenta el retroceso, la defensa en 5 y la reducción de daño en un 5%
		Aumenta la defensa en 20 y la reducción de daño en un 5% durante unos segundos tras hacer un golpe cuerpo a cuerpo verdadero
		'''
}




