MoltenPiercer: {
	DisplayName: Perforador fundido
	Tooltip:
		'''
		Lanza dagas llameantes
		Las dagas generan fragmentos de obsidiana en llamas mientras vuelan en un ataque sigiloso
		'''
}

WulfrumShockCutter: {
	DisplayName: Cortador de choque de wulfrum
	Tooltip: ""
}

FrozenStarShuriken: {
	DisplayName: Shuriken de estrella congelada
	Tooltip:
		'''
		Invoca nieblas teleridigidas al impactar
		Los ataque sigilosos generan más proyectiles
		'''
}

ExoBall: {
	DisplayName: Exo esfera
	Tooltip:
		'''
		Lanza esferas con púas se dirigen hacia los enemigos y se adhieren a ellos
		Las esferas con púas adheridas invocan una tormenta localizada de exo esferas con cada impacto
		Los ataques sigilosos llegan a su objetivo más rápido y tienen una cadencia de disparo mayor
		'''
}

AuricKunai: {
	DisplayName: Kunai áurico
	Tooltip:
		'''
		Dispara una ráfaga rápida de kunais de corto alcance
		Los ataques sigilosos lanzan 5 rayos contra el enemigo más cercano
		'''
}

StarfishFromTheDepth: {
	DisplayName: Estrella de mar de las profundidades
	Tooltip:
		'''
		Las estrellas de mar se dirigen hacia los objetivos más cercanos y pueden infligir hasta 5 impactos antes de regresar
		Haz clic derecho o deja de sujetar esta arma para que las estrellas de mar activas regresen hacia ti
		Los ataques sigilosos lanzan tres estrellas de mar al mismo tiempo
		'''
}



