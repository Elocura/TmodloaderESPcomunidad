		AuricTeslaPlusSet: {
			Melee:
				'''
				Combina los efectos cuerpo a cuerpo de las armaduras Intergelática, Bloodflare y God Slayer
				Pulsa {0} para hacer que los asteroides sean más transparentes
				Los enemigos tienen más probabilidad de atacarte
				Todos los proyectiles generan orbes áuricos curativos al golpear enemigos
				'''
			Ranged:
				'''
				Combina los efectos a distancia de las armaduras Intergelática, Bloodflare y God Slayer
				Pulsa {0} para hacer que los asteroides sean más transparentes
				Todos los proyectiles generan orbes áuricos curativos al golpear enemigos
				'''
			Magic:
				'''
				Combina los efectos mágicos de las armaduras Intergelática, Bloodflare y Silva
				Pulsa {0} para hacer que los asteroides sean más transparentes
				Todos los proyectiles generan orbes áuricos curativos al golpear enemigos
				Velocidad máxima de carrera y aceleración aumentadas un 5%
				'''
			Summoner:
				'''
				Combina los efectos de invocador de las armaduras Intergelática, Bloodflare y Silva
				Pulsa {0} para hacer que los asteroides sean más transparentes
				Todos los proyectiles generan orbes áuricos curativos al golpear
				Velocidad máxima de carrera y aceleración aumentadas un 5%
				+6 a la cantidad máxima de súbditos y +75% de daño de súbditos
				'''
			Rogue:
				'''
				Combina los efectos de lanzador de las armaduras Intergelática, Bloodflare y God Slayer
				Pulsa {0} para hacer que los asteroides sean más transparentes
				Todos los proyectiles generan orbes áuricos curativos al golpear enemigos
				La furtividad de lanzador se carga al no atacar y más lentamente al moverte, hasta un máximo de 130
				Al alcanzar la furtividad máxima podrás realizar un golpe sigiloso
				La furtividad de lanzador solo se reduce al atacar, no al moverte
				A mayor furtividad de lanzador, mayor será tu daño, probabilidad de crítico y velocidad de movimiento
				'''
		}

