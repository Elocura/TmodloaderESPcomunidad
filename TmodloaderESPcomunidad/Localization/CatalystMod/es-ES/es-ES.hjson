			AscendedAstralSlimeBanner: {
				DisplayName: "Estandarte de {$Mods.CatalystMod.NPCs.AscendedAstralSlime.DisplayName}"
				Tooltip: "{$CommonItemTooltip.BannerBonus}{$Mods.CatalystMod.NPCs.AscendedAstralSlime.DisplayName}"
			}

			MetanovaSlimeBanner: {
				DisplayName: "Estandarte de {$Mods.CatalystMod.NPCs.MetanovaSlime.DisplayName}"
				Tooltip: "{$CommonItemTooltip.BannerBonus}{$Mods.CatalystMod.NPCs.MetanovaSlime.DisplayName}"
			}

			DivineJello: {
				DisplayName: Gelatina divina
				Tooltip:
					'''
					Invoca una Deidad slime
					'¡Un manjar digno de un Dios!'
					'''
			}

			AstrageldonRelic: {
				DisplayName: Reliquia de astrageldon
				Tooltip: ""
			}

			BreathofGlacies: {
				DisplayName: Aliento de glaciares
				Tooltip:
					'''
					Lanza un círculo rúnico cada quinto disparo
					El círculo rúnico dispara fragmentos de hielo que infligen el 50% de daño
					{$Mods.CatalystMod.Tooltips.Flamethrower}
					50% de probabilidad de no consumir munición
					'''
			}

			DesertScorcher: {
				DisplayName: Quemador del desierto
				Tooltip:
					'''
					Dispara una ráfaga de agua abrasadora
					Ignora 5 puntos de defensa del enemigo
					{$Mods.CatalystMod.Tooltips.Flamethrower}
					40% de probabilidad de no consumir munición
					'''
			}

			Ichorthrower: {
				DisplayName: Lanzador de ícor
				Tooltip:
					'''
					Enciende el gel formando una nube tóxica ardiente
					Esta nube puede condensarse en orbes de ícor
					{$Mods.CatalystMod.Tooltips.Flamethrower}
					40% de probabilidad de no consumir munición
					'''
			}

			Plasmilegion: {
				DisplayName: Legión de plasma
				Tooltip:
					'''
					Ioniza el gel en plasma puro
					Clic izquierdo para cargar un poderoso rayo de energía, pero con riesgo de sobrecalentamiento
					Clic derecho para disparar bolas de fuego sin sobrecalentamiento
					{$Mods.CatalystMod.Tooltips.Flamethrower}
					40% de probabilidad de no consumir munición
					'''
			}

			Repentance: {
				DisplayName: Arrepentimiento
				Tooltip:
					'''
					Invoca llamas del sexto círculo
					{$Mods.CatalystMod.Tooltips.Flamethrower}
					70% de probabilidad de no consumir munición
					'''
			}

			RookOfVengeance: {
				DisplayName: Torre de la anarquía
				Tooltip:
					'''
					Dispara bolas de fuego que se dividen perpendicularmente al impactar
					{$Mods.CatalystMod.Tooltips.Flamethrower}
					70% de probabilidad de no consumir munición
					'''
			}

			StaticInferno: {
				DisplayName: Tormenta de fuego voltaica
				Tooltip:
					'''
					Libera 3 orbes de electricidad que se materializan como plasma
					{$Mods.CatalystMod.Tooltips.Flamethrower}
					50% de probabilidad de no consumir munición
					'''
			}

			AstralNeutron: {
				DisplayName: Neutrón astral
				Tooltip: "'PokerFace'"
			}

			CongeledDuoWhip: {
				DisplayName: Doble látigo coagulado
				Tooltip:
					'''
					{$Mods.CatalystMod.Tooltips.WhipTooltip}
					5% de daño de invocación
					Clic izquierdo para lanzar ambos látigos delante de ti
					Clic derecho para lanzar un látigo al frente y el otro detrás
					'''
			}

			PrismBreak: {
				DisplayName: Ruptura prismática
				Tooltip:
					'''
					{$Mods.CatalystMod.Tooltips.WhipTooltip}
					Tus invocaciones liberarán cristales acuáticos buscadores al impactar
					'''
			}

			ResonantStriker: {
				DisplayName: Golpe resonante
				Tooltip:
					'''
					{$Mods.CatalystMod.Tooltips.WhipTooltip}
					Libera orbes eléctricos buscadores al impactar
					Tus esbirros aturden a enemigos no jefes al impactar
					'''
			}

			UnderBite: {
				DisplayName: Mordida cáustica
				Tooltip:
					'''
					{$Mods.CatalystMod.Tooltips.WhipTooltip}
					Lanza un cráneo cáustico que inflige Ácido ponzoñoso y 6% de daño de etiqueta de invocación
					'''
			}

			UnrelentingTorment: {
				DisplayName: Tormento incesante
				Tooltip:
					'''
					{$Mods.CatalystMod.Tooltips.WhipTooltip}
					Invoca una ráfaga de garras sobrenaturales que despedazan a tus enemigos
					'''
			}

			BlossomsBlessing: {
				DisplayName: Bendición de la floración
				Tooltip:
					'''
					{$Mods.CatalystMod.Tooltips.WhipTooltip}
					Lleva flores sobre el viento
					Toca el pétalo más grande para recibir una bendición de regeneración, daño y espinas
					'Florece, florece, se marchita y se inclina.'
					'''
			}

			Catharsis: {
				DisplayName: Catarsis
				Tooltip:
					'''
					{$Mods.CatalystMod.Tooltips.WhipTooltip}
					Balancear el látigo cuesta salud
					Golpear enemigos acumula una carga de sangre. Se pueden almacenar hasta 20 cargas
					Clic derecho activa las cargas, potenciando temporalmente a Catarsis y restaurando la vida perdida
					[c/c61b40:La luz purificadora, abandonada y consumida por el dolor,]
					[c/c61b40:Regresó a este reino como sombra destructora.]
					'''
			}

			SandstoneReigns: {
				DisplayName: Riendas de arenisca
				Tooltip:
					'''
					{$Mods.CatalystMod.Tooltips.WhipTooltip}
					Invoca un pequeño tiburón de arenisca para morder a tus enemigos
					'Ökenhaj!'
					'''
			}

			CoralCrusher: {
				DisplayName: Triturador de coral
				Tooltip:
					'''
					{$Mods.CatalystMod.Tooltips.WhipTooltip}
					Golpear a un enemigo con la punta incrusta una astilla de coral
					Los ataques de los esbirros pueden romper la astilla de coral, deteniendo su movimiento y provocando 6% de daño de invocación
					'''
			}

			WulfrumSatchelCharge: {
				DisplayName: Carga de satchel Wulfrum
				Tooltip:
					'''
					Provoca una enorme explosión que destruye bloques al atacar en sigilo
					'No te acerques demasiado'
					'''
			}

			WulfrumFlashlight: {
				DisplayName: Linterna Wulfrum
				Tooltip:
					'''
					'Iluminando el camino hacia una nueva actualización'
					Clic izquierdo para encender la linterna, doble clic para cambiar entre las lentes en tu inventario
					'''
			}

			AmethystFlashlightLens: {
				DisplayName: Lente de linterna de amatista
				Tooltip: "{$Mods.CatalystMod.Tooltips.LensTooltip}"
			}

			TopazFlashlightLens: {
				DisplayName: Lente de linterna de topacio
				Tooltip: "{$Mods.CatalystMod.Tooltips.LensTooltip}"
			}

			SapphireFlashlightLens: {
				DisplayName: Lente de linterna de zafiro
				Tooltip: "{$Mods.CatalystMod.Tooltips.LensTooltip}"
			}

			EmeraldFlashlightLens: {
				DisplayName: Lente de linterna de esmeralda
				Tooltip: "{$Mods.CatalystMod.Tooltips.LensTooltip}"
			}

			RubyFlashlightLens: {
				DisplayName: Lente de linterna de rubí
				Tooltip: "{$Mods.CatalystMod.Tooltips.LensTooltip}"
			}

			DiamondFlashlightLens: {
				DisplayName: Lente de linterna de diamante
				Tooltip: "{$Mods.CatalystMod.Tooltips.LensTooltip}"
			}

			AmberFlashlightLens: {
				DisplayName: Lente de linterna de ámbar
				Tooltip: "{$Mods.CatalystMod.Tooltips.LensTooltip}"
			}

			TeamFlashlightLens: {
				DisplayName: Lente de linterna de equipo
				Tooltip:
					'''
					{$Mods.CatalystMod.Tooltips.LensTooltip}
					El color depende del equipo seleccionado
					'''
			}

			WulfrumMineBanner: {
				DisplayName: "{$Mods.CatalystMod.NPCs.WulfrumMine.DisplayName} Banner"
				Tooltip: "{$CommonItemTooltip.BannerBonus}{$Mods.CatalystMod.NPCs.WulfrumMine.DisplayName}"
			}

			WulfrumSlimeBanner: {
				DisplayName: "{$Mods.CatalystMod.NPCs.WulfrumSlime.DisplayName} Banner"
				Tooltip: "{$CommonItemTooltip.BannerBonus}{$Mods.CatalystMod.NPCs.WulfrumSlime.DisplayName}"
			}
		}

		ItemTooltip.Extra.HideofAstrumDeus: Resistencia del 50% al Debuff Plaga astral
		ItemTooltipExtra0.AstralCommunicator: Haz clic derecho para invocar a Astrageldon en su primera fase
		ItemTooltipExtra1.AstralCommunicator: El núcleo ha sido destruido por la energía liberada por la muerte de una deidad lunar...

		ArmorSetBonus: {
			IntergelacticAll:
				'''
				Dos anillos de asteroides te rodean con cuyos daños escalan con tus estadísticas
				Pulsa {0} para hacer que los asteroides sean más transparentes
				'''
			IntergelacticMelee:
				'''
				Cuatro anillos de asteroides te rodean con cuyos daños escalan con tus estadísticas
				Otorga inmunidad al retroceso y a múltiples desventajas de movimiento
				Eres inmune a la Plaga astral y tus ataques la infligen
				'''
			IntergelacticRanged:
				'''
				Las armas a distancia invocan estrellas con un 30% de daño
				Eres inmune a la Plaga astral y tus ataques la infligen
				'''
			IntergelacticMagic:
				'''
				Los golpes críticos mágicos hacen que las estrellas estallen al golpear a los enemigos
				Disminución del 20% en el consumo de maná
				Aumenta el maná recibido de las pociones en un 100
				Eres inmune a la Plaga astral y tus ataques la infligen
				'''
			IntergelacticSummon:
				'''
				Aumenta tu número máximo de súbditos en 3
				Los súbditos tienen un 6% de probabilidad de golpe crítico
				Los súbditos lanzan asteroides recolectados contra los enemigos
				Eres inmune a la Plaga astral y tus ataques la infligen
				'''
			IntergelacticRogue:
				'''
				+120 sigilo máximo
				Los ataques sigilosos liberarán el cinturón de asteroides para apuntar a los enemigos
				Eres inmune a la Plaga astral y tus ataques la infligen
				'''
		}

