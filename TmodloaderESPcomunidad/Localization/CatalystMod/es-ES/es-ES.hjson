				Tooltip: Otorga máximo maná y regeneración de maná
			}

			Lean: {
				DisplayName: Astracola
				Tooltip:
					'''
					Otorga máximo maná y poder 
					Aumenta la regeneración de maná 
					¡Siente la carbonatación cósmica!
					'''
			}

			AstralTransmogrifier: {
				DisplayName: Transfigurador astral
