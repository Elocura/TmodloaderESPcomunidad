Mods: {
	CatalystMod: {
		Common: {
			UnboundKey: "[Tecla no asignada]"
			BoundKey: "{0}"
		}

		Items: {
			Lore: {
				LoreAstrageldon: {
					DisplayName: Astrageldon
					Lore:
						'''
						Una existencia así desafía toda comprensión. Draedon una vez informó sobre este poder anómalo en su estudio de la Infección Astral.
						Pero incluso con todo su ingenio, no pudo comprender por completo su singular naturaleza astral-gelatinosa.
						Descubrió, sin embargo, que la entidad había sido contaminada con una cepa más potente de la infección.
						Su mera densidad era incalculable, superando con creces los límites de la razón. Y aun así, su extraña viscosidad desafiaba cualquier explicación.
						Si en verdad es gelatinosa, entonces su ambición es casi ilimitada. El huésped ideal para tal infección.
						Su hambre sería insaciable. Incontrolable e indomable. Una perfección del orden natural.
						El codicioso Dios Slime habría sentido envidia con tan solo imaginar tal potencial.
						Ahora que ha sido erradicado, solo queda preguntarse qué amenazas mayores aguardan en lugares más lejanos.
						'''
					Tooltip: ""
				}
			}

			AstrageldonBag: {
				DisplayName: Vaina del tesoro
				Tooltip: "{$CommonItemTooltip.RightClickToOpen}"
			}

			AstrageldonMask: {
				DisplayName: Máscara Astrageldon
				Tooltip: ""
			}

			InterstellarCorruptionDye: {
				DisplayName: Tinte de corrupción interestelar
				Tooltip: ""
			}

			AstrageldonPhase1MusicBox: {
				DisplayName: Caja de música (Astrageldon - Fase 1)
				Tooltip: Reproduce 'Cosmic Disgust' De DM DOKURO
			}

			AstrageldonPhase2MusicBox: {
				DisplayName: Caja de música (Astrageldon - Fase 2)
				Tooltip: Reproduce 'Galactic Destruction' De Heart Plus Up!
			}

			AstrageldonTitleMusicBox: {
				DisplayName: Caja de música (Título de Astrageldon)
				Tooltip: Reproduce 'Heaven's Hell-Sent Gift' Por DM DOKURO
			}

			MetanovaOre: {
				DisplayName: Mineral de metanova
				Tooltip: ""
			}

			MetanovaBar: {
				DisplayName: Lingote de metanova
				Tooltip: Un universo entero comprimido
			}

			LoreAstrageldon: {
				DisplayName: "{$Mods.CatalystMod.NPCs.Astrageldon.DisplayName}"
				Tooltip:
					'''
					[c/E3AF40:Susurros de una danza celestial bailan en tus oídos...]
					[c/BEBEBE:Presiona "Shift Izq" Para escuchar de cerca]
					'''
			}

			AstralCommunicator: {
				DisplayName: Comunicador astral
				Tooltip:
					'''
					Invoca a Astrageldon en la Infección astral
					[c/870808:Si no matas al Astrageldon antes de derrotar al Señor de la Luna, este objeto dejará de funcionar.]
					{$Mods.CatalystMod.Tooltips.NotConsumable}
					'''
			}

			IntergelacticHeadMelee: {
				DisplayName: Casco intergaláctico
				Tooltip:
					'''
					22% más de daño y probabilidad de golpe crítico
					10% más de velocidad de ataque cuerpo a cuerpo y movimiento
					Reduce el daño recibido en un 15%
					'''
			}

			IntergelacticHeadRanged: {
				DisplayName: Visor intergaláctico
				Tooltip:
					'''
					Aumenta el daño a distancia y la probabilidad de golpe crítico en un 14%
					Reduce el daño recibido en un 12%
					'''
			}

			IntergelacticHeadMagic: {
				DisplayName: Máscara intergaláctica
				Tooltip:
					'''
					Aumenta el maná máximo en 100
					15% más de daño mágico y probabilidad de golpe crítico
					Reduce el daño recibido en un 12%
					'''
			}

			IntergelacticHeadSummon: {
				DisplayName: Yelmo cornudo intergaláctico
				Tooltip:
					'''
					Aumenta el número máximo de súbditos en 1
					Reduce el daño recibido en un 12%
					'''
			}

			IntergelacticHeadRogue: {
				DisplayName: Casco de pícaro intergaláctico
				Tooltip:
					'''
					Aumenta el daño y la probabilidad de golpe crítico de lanzador en un 22%
					12% más de reducción de daño
					'''
			}

			IntergelacticBreastplate: {
				DisplayName: Coraza intergelática
				Tooltip: Proporciona inmunidad a la Infección astral y multiples buffs de reducción defensa
			}

			IntergelacticGreaves: {
				DisplayName: Mallas intergelácticas
				Tooltip:
					'''
					20% más de velocidad de movimiento
					Aumenta la velocidad de salto y otorga resistencia adicional a las caídas
					'''
			}

			AstralsEnd: {
				DisplayName: Fin de astral
				Tooltip: Invoca un poderoso asteroide de un universo paralelo
			}

			Astragelgun: {
				DisplayName: Arma de gel astral
				Tooltip:
					'''
					Dispara una bomba supernova que explota al contactar 
					Click Derecho para disparar una bola de plasma que inflige un 200% de daño
					{$Mods.CatalystMod.Tooltips.Flamethrower}
					75% probalidad de no gastar gel
					'''
			}

			InterstellarVolution: {
				DisplayName: Volución interestelar
				Tooltip:
					'''
					Explota en slimes de nova teledirigidos 
					Los ataques sigilosos hacen que los slimes disparen láseres
					'''
			}

			ExaltedHorizon: {
				DisplayName: Horizonte exaltado
				Tooltip:
					'''
					Emite una lanza astral que acumula corrupción en los enemigos
					A las 5 acumulaciones el enemigo explotará violentamente haciendo daño extremo
					'''
			}

			AstralpodStaff: {
				DisplayName: Báculo de medusas astrales
				Tooltip: Invoca una Medusa astral que dispara bombardeos de laseres y rayos mortales para protegerte
			}

			ScytheoftheAbandonedGod: {
				DisplayName: Guadaña del Dios olvidado
				Tooltip:
					'''
					Gira, invocando varias bolas de gel teledirigido y desacelera para desatar una tormenta de truenos
					Click Derecho para lanzarte hacia el cursor
					{$Mods.CatalystMod.Tooltips.FlawlessDrop}
					'''
			}

			AstralLash: {
				DisplayName: Gancho astral
				Tooltip:
					'''
					Alcance: 40 tiles
					Velocidad de lanzamiento: 50
					Velocidad de retroceso: 72
					Velocidad de arrastre: 16
					Te teletransporta a la ubicación del gancho
					Ignora cualquier bloque que obstruya el camino entre tú y el gancho
					'''
			}

			AstrageldonTrophy: {
				DisplayName: Trofeo astrageldon
				Tooltip: ""
			}

			InfluxCluster: {
