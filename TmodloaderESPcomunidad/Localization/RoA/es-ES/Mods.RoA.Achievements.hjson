	FriendlyName: ¿Qué es ese olor?
	Description: Extrae tu primera pepita de mercurio sin enfermarte.
}

OpenRootboundChest: {
	FriendlyName: Botín de Groot
	Description: Abre un cofre entrelazado con raíces en las profundidades de los bosques remotos.
}

SurviveBackwoodsFog: {
	FriendlyName: Colinas Silenciosas
	Description: Sobrevive a la niebla, un evento matutino en los bosques donde no se puede ver más allá de una pulgada.
}

