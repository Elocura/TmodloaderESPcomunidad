	}

	HighlightMode: {
		Label: Resaltado de Palabras Clave de Recursos
		Tooltip: ""
	}

	WreathDrawingMode: {
		Label: Estilo de Interfaz de Corona
		Tooltip: ""
	}

	VanillaResprites: {
		Label: Cambios de Sprites Vanilla
		Tooltip: Reemplaza algunas texturas, por ejemplo hierbas alquímicas y Espina Vil
	}

	Headers: {
		Mods: {
			RoA: {
				Configs: {
					GeneralOptionsHeader: Opciones Generales
					DruidOptionsHeader: Opciones de Druida
				}
			}
		}
	}

	WreathPosition: {
		Label: Posición de la Interfaz de la Corona
		Tooltip: ""
	}

	DamageTooltipOption: {
		Label: Formato de Descripción de Daño de Druida
		Label2: Vista Previa
		Tooltip: ""
	}

	DamageTooltipOption_Internal: {
		Label: ""
		Tooltip: ""
	}

	DamageScaling: {
		Label: Indicador de Escalado de Daño de Druida
		Tooltip: ""
	}

	WreathSoundMode: {
		Label: Estilo de Sonido de la Corona
		Tooltip: ""
	}
}

RoAServerConfig: {
	DisplayName: Configuración

	DropDevSets: {
		Label: Soltar Conjuntos de Vanidad de Desarrollador
		Tooltip: Si está activado, los conjuntos de desarrollador de RoA caerán de las Bolsas de Tesoro en pre-hardmode
	}

	BackwoodsWidthMultiplier: {
		Label: Multiplicador de Anchura del Bioma Bosques Remotos
		Tooltip: ""
	}

	BackwoodsHeightMultiplier: {
		Label: Multiplicador de Altura del Bioma Bosques Remotos
		Tooltip: ""
	}

	EvilBiomeExtraItemChance: {
		Label: Probabilidad de Ítem Extra en Biomas Malignos
		Tooltip: Permite que las Orbes de Sombra/Corazones Carmesí suelten dos objetos a la vez
	}

	Headers: {
		Mods: {
			RoA: {
				Configs: {
					GeneralOptionsHeader2: Opciones Generales
					GenerationOptionHeader: Opciones de Generación de Mundo
				}
			}
		}
	}

	ChangeVanillaRecipes: {
		Label: Cambios en Recetas Vanilla
		Tooltip: Reemplaza varias recetas de objetos, por ejemplo pociones
	}
}

