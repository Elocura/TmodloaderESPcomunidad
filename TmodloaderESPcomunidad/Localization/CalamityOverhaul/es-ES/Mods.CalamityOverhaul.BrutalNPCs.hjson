HeadPrimeAI.SkeletronPrime_Text: ¡No intentes matarme con esta tontería! ¡Muere, organismo!

WallOfFleshAI: {
	CurtainDeathReason: "{0} fue engullido por la marea de sangre"
	NetDeathReason: "{0} fue destrozado por la red de los Hambrientos"
}

EmpressOfLightAI: {
	# Líneas de transformación de la fase 3, pronunciadas en intervalos fijos; la séptima suena cuando termina el anillo de cierre y se la puede volver a matar
	Ascension_0: ...¿Eh?
	Ascension_1: ¿Cómo es posible?
	Ascension_2: He llevado mi luz hasta el límite. ¿Cómo es que sigues en pie?
	Ascension_3: ...No.
	Ascension_4: No me doblegaré ante ti de esta manera.
	Ascension_5: Si quieres luchar, te llevarás hasta el último rayo de mi ser
	Ascension_6: Ahora. Te toca a ti
	# Monólogo de rendición, una línea por tiempo de la actuación de muerte
	Farewell_0: ...Ya basta
	Farewell_1: Eres mucho más fuerte de lo que pareces
	Farewell_2: Esas mariposas lo son todo para mí. Déjalas en paz y este cielo seguirá siendo nuestro para compartirlo
	Farewell_3: La luz te recordará
	# Sombra de la Luna: motivo de muerte para un jugador atrapado fuera de los conos de sombra durante la tormenta de nieve
	WhiteoutDeath: "{0} se evaporó en su luz"
}
