ExcavationBoosterModule: {
	DisplayName: Módulo de refuerzo de excavación
	Tooltip:
		'''
		Instálalo en una máquina minera para acortar su ciclo de trabajo un 30%
		Los engranajes cuentan ahora con un juego de dientes más resistentes
		'''
}

PickPowerBoosterModule: {
	DisplayName: Módulo de refuerzo de potencia de pico
	Tooltip:
		'''
		Instálalo en una máquina minera para aumentar su potencia de excavación en un 60%
		Permite que una máquina chapada en estaño devore el mitril
		'''
}

ChlorophyteDrillModule: {
	DisplayName: Módulo de perforación de clorofita
	Tooltip: La broca en sí está fundida en clorofita — un mineral que extrae otros minerales
}

EfficiencyModule: {
	DisplayName: Módulo de eficiencia
	Tooltip:
		'''
		Instálalo en una máquina minera para reducir el coste energético de cada ciclo en un 60%
		Las bobinas por fin dejaron de calentarse
		'''
}

YieldBoosterModule: {
	DisplayName: Módulo de mejora de rendimiento
	Tooltip:
		'''
		Instálalo en una máquina minera para aumentar en un 3 % la probabilidad de obtener lingotes
		El tamiz tiene un grado de finura más fino.
		'''
}

ProspectorModule: {
	DisplayName: Módulo prospector
	Tooltip:
		'''
		Instálalo en una máquina minera para triplicar el peso de los subproductos raros: gemas, fósiles, meteoritos y chatarra
		Bajo la lupa, hasta la arena tiene una jerarquía
		'''
}

SurveyArrayModule: {
	DisplayName: Módulo de matriz de exploración
	Tooltip:
		'''
		Instálalo en una máquina de extracción para ampliar y profundizar su alcance de exploración en un 50%
		El eco llega antes que la broca
		'''
}

VeinFocusModule: {
	DisplayName: Módulo de enfoque en vetas
	Tooltip:
		'''
		Instálalo en una máquina minera para aumentar en un 60% la influencia de las vetas reales en la producción
		Sigue la veta; no te pelees con la roca
		'''
}

DoubleLoadModule: {
	DisplayName: Módulo de doble carga
	Tooltip:
		'''
		Instálalo en una máquina minera para que cada producción tenga un 25% de probabilidades de duplicarse
		La tolva se ha ampliado un tamaño.
		'''
}

OverdriveCoreModule: {
	DisplayName: Módulo de núcleo de sobremarcha
	Tooltip:
		'''
		Instálalo en una máquina minera para acortar su ciclo de trabajo en un 45%, con un coste energético un 60% mayor
		No hay planes de detenerla hasta que los cojinetes se calienten.
		'''
}

ThrottleValveModule: {
	DisplayName: Módulo de válvula de mariposa
	Tooltip:
		'''
		Instálalo en una máquina de minera para alargar su ciclo de trabajo en un 50% y reducir el coste energético en un 45%
		Es lento, pero toda la noche es suya
		'''
}

ChestLinkModule: {
	DisplayName: Módulo de conexión torácica
	Tooltip:
		'''
		Instálalo en una máquina minera para que deposite los recursos directamente en los cofres cercanos, y solo los suelte cuando estén llenos
		Así te ahorras tener que agacharte
		'''
}

SmelterModule: {
	DisplayName: Módulo de fundición de campo
	Tooltip:
		'''
		Instálalo en una máquina minera para fundir minerales y convertirlos en lingotes según las proporciones del horno antes de la producción, con un coste energético un 40% mayor
		Lingotes directamente desde la boca del pozo.
		'''
}

MachineModuleText: {
	TagText: Módulo de mejora de máquina
	TargetsLine: Compatible con: {0}
	HowToText: Haz clic derecho en una máquina compatible e insértalo en su panel
	SocketOnly: ¡Esta máquina no admite ese módulo!
	SocketDuplicate: ¡Ya hay un módulo de este tipo instalado!
	SocketEmptyHint: Inserta un módulo de mejora
	SlotLabel: Modules
	NameMining: Máquina minera
	NameThermal: Generador térmico
	NameWind: Turbina eólica
	NameHydro: Generador hidráulico
	NameIncinerator: Incineradora
	NameCrusher: Trituradora de mineral
	NameRecycler: Reciclador
	NameMagma: Generador térmico de magma
	NameBiomass: Generador de biomasa
	NameTurret: Torreta defensiva
	NameSolar: Panel solar
}

InsulationLiningModule: {
	DisplayName: Módulo de revestimiento aislante
	Tooltip:
		'''
		Instálalo en un generador térmico para reducir la disipación de calor en un 55%
		Tres capas de amianto: el calor nunca sale de ahí
		'''
}

ForcedDraftModule: {
	DisplayName: Módulo de ventilación forzada
	Tooltip:
		'''
		Instálalo en un generador térmico para que arda un 45% más rápido y a mayor temperatura
		Con solo una bombeada del fuelle, las brasas se enderezan
		'''
}

SlowBurnValveModule: {
	DisplayName: Módulo de válvula de combustión lenta
	Tooltip:
		'''
		Instálalo en un generador térmico para reducir la combustión al 60% y así aprovechar al máximo cada trozo de combustible
		Reduce la llama al mínimo y un trozo de carbón te durará media noche
		'''
}

HeatRecoveryModule: {
	DisplayName: Módulo de recuperación de calor
	Tooltip:
		'''
		Instálalo en un generador térmico para aumentar el rendimiento calorífico por unidad de combustible en un 25%
		Dos codos adicionales en el conducto de humos recogen el calor que se escapa
		'''
}

AutoFeedHopperModule: {
	DisplayName: Tolva de alimentación automática
	Tooltip:
		'''
		Instálalo en un generador térmico, un incinerador o un generador de biomasa para extraer la materia prima del almacén cercano
		La tolva solo responde cuando hay una ranura vacía.
		'''
}

ExtendedBladesModule: {
	DisplayName: Módulo de palas extendidas
	Tooltip:
		'''
		Instálalo en un aerogenerador para aumentar la producción en un 30%
		Cada pulgada más allá de la punta de la pala antigua es viento libre
		'''
}

LowWindGearboxModule: {
	DisplayName: Módulo para de vientos flojos
	Tooltip:
		'''
		Instálalo en un aerogenerador para aumentar el factor de viento mínimo de 0,8 a 1,3
		El engranaje de corte fino aprovecha hasta la más mínima brisa.
		'''
}

TallTowerModule: {
	DisplayName: Módulo de torre alta
	Tooltip:
		'''
		Se instala en un aerogenerador para aumentar la producción en un 15%; se puede combinar con el Módulo de palas extendidas
		Diez metros más alto, con un poco más de viento
		'''
}

FlowShroudModule: {
	DisplayName: Módulo de protección del flujo
	Tooltip:
		'''
		Instálalo en un generador hidráulico para aumentar la producción en un 30%
		La boca acampanada recoge el agua dispersa en un solo chorro
		'''
}

QuickSpinModule: {
	DisplayName: Módulo de giro rápido
	Tooltip:
		'''
		Instálalo en un generador hidráulico para triplicar la velocidad de aceleración
		Bobinado apretado; alcanza la velocidad de funcionamiento en cuanto entra en contacto con el agua
		'''
}

DeepBearingModule: {
	DisplayName: Módulo de cojinetes para aguas profundas
	Tooltip:
		'''
		Instálalo en un generador hidráulico para aumentar la potencia en un 15%; se puede combinar con el Módulo de protección del flujo
		El eje no desperdicia nada; la rueda lo aprovecha todo
		'''
}

HighTempElectrodeModule: {
	DisplayName: Módulo de electrodos para altas temperaturas
	Tooltip:
		'''
		Instálalo en un incinerador para fundir un 45% más rápido
		Apunta las agujas una hacia la otra y el arco extinguirá el fuego en ese punto
		'''
}

EconomizerCoilModule: {
	DisplayName: Módulo de bobina económica
	Tooltip:
		'''
		Instálalo en un incinerador para reducir el coste energético de la fundición en un 60%
		Se ha rebobinado con alambre esmaltado fino; ahora el contador gira con suavidad
		'''
}

TwinCrucibleModule: {
	DisplayName: Módulo de crisol doble
	Tooltip:
		'''
		Instálalo en un incinerador para tener un 25% de probabilidades de duplicar la producción por lote
		Un fuego, dos tazas
		'''
}

AutoEjectChuteModule: {
	DisplayName: Tolva de expulsión automática
	Tooltip:
		'''
		Instálalo en un incinerador para enviar los productos directamente al almacén cercano
		Conecta la rampa y el horno se encargará de llenar las estanterías por sí solo
		'''
}

CapacityCellModule: {
	DisplayName: Módulo de celdas de capacidad
	Tooltip:
		'''
		Instálala en cualquier máquina para aumentar la capacidad energética en un 50%
		Todas las tomas de corriente del taller admiten estas placas
		'''
}

TurretRangefinderModule: {
	DisplayName: Módulo de telémetro para torreta
	Tooltip:
		'''
		Instálalo en una torreta defensiva para ampliar la puntería en un 25%
		Las torres de escudo y de curación amplían su aura en su lugar
		La lente detecta al enemigo antes que el cañón.
		'''
}

TurretAutoloaderModule: {
	DisplayName: Módulo de carga automática de torreta
	Tooltip:
		'''
		Instálalo en una torreta defensiva para disparar un 30% más rápido
		Las torretas de aura no tienen ritmo de disparo, por lo que no tiene ningún efecto en ellas
		La siguiente bala se carga antes de que la anterior impacte
		'''
}

TurretPowerSaverModule: {
	DisplayName: Módulo de ahorro de energía para torreta
	Tooltip:
		'''
		Instálalo en una torreta defensiva para reducir su consumo de energía al 75%
		Aplica tanto al consumo por disparo como al consumo continuo
		El medidor por fin se ralentiza durante un asedio
		'''
}

CopperTinDrill: {
	DisplayName: Broca de cobre/estaño
	Tooltip: La primera pieza que puliste hasta dejarla reluciente
}

IronLeadDrill: {
	DisplayName: Broca de hierro/plomo
	Tooltip: La broca dura más que el mineral; eso es todo lo que necesita
}

SilverTungstenDrill: {
	DisplayName: Broca de plata/tungsteno
	Tooltip: Su filo está recubierto de una dignidad que se niega a oxidarse
}

GoldPlatinumDrill: {
	DisplayName: Broca de oro/platino
	Tooltip: Me ha entrado el gusto por el metal suave
}

EvilOreDrill: {
	DisplayName: Broca para mineral maligno
	Tooltip: Sumergido en ambos males; cada bando lo reclama
}

MeteoriteDrill: {
	DisplayName: Broca de meteorito
	Tooltip: Lo que cae del cielo se enfrenta al acero forjado en el cielo
}

ObsidianDrill: {
	DisplayName: Broca de obsidiana
	Tooltip: Un lugar donde el agua se encuentra con el fuego
}

HellstoneDrill: {
	DisplayName: Broca de piedra infernal
	Tooltip: El mango todavía está caliente
}

FossilDrill: {
	DisplayName: Broca de fósiles
	Tooltip: Los pinceles iban demasiado lentos
}

CoalDrill: {
	DisplayName: Broca para vetas de carbón
	Tooltip: En la sala de calderas la piden por su nombre
}

GemClusterDrill: {
	DisplayName: Broca para racimos de gemas
	Tooltip: Una mandíbula de diamante que solo muerde lo que brilla
}

CobaltPalladiumDrill: {
	DisplayName: Broca de cobalto/paladio
	Tooltip: Aún tiene fragmentos del altar entre los dientes
}

MythrilOrichalcumDrill: {
	DisplayName: Broca de mithril/oricalco
	Tooltip: Gira con un zumbido que tiene un aire ligeramente sagrado
}

AdamantiteTitaniumDrill: {
	DisplayName: Broca de adamantita/titanio
	Tooltip: Los huesos duros de las profundidades son asunto suyo
}

LuminiteDrillModule: {
	DisplayName: Módulo de perforación de luminita
	Tooltip: Los restos lunares se extraen igual que cualquier otra cosa
}

ProcessingFeedHopper: {
	DisplayName: Tolva de alimentación para procesamiento
	Tooltip: Instalada en una trituradora o un reciclador, la máquina recoge por sí sola el material de un almacén cercano
}

ProcessingEjectChute: {
	DisplayName: Tolva de expulsión del proceso
	Tooltip: Una vez instalado en una trituradora o un reciclador, los productos pasan directamente al almacén cercano
}