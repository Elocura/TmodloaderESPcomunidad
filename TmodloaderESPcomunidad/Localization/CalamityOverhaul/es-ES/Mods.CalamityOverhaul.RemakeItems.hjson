ModifyChargingStationItem: {
	DisplayName: Estación de carga
	Tooltip:
		'''
		Utiliza electricidad para cargar dispositivos eléctricos  
		Se pueden colocar baterías en su interior para almacenar electricidad  
		Se puede conectar a cables para la transmisión de energía  
		Haz clic derecho del ratón sobre el bloque mientras sostienes un objeto recargable para insertarlo rápidamente  
		Shift + clic derecho para recuperar objetos
		'''
}

DyeVatItem: {
	DisplayName: "{$ItemName.DyeVat}"
	Tooltip:
		'''
		Se usa para para crear tintes
		Haz clic derecho después de colocarlo para abrir el panel de control, permitiéndote teñir objetos.
		Coloca un cubo de agua en la ranura de tinte para lavar los tintes de los objetos
		'''
}

RDemonConch: {
	DisplayName: Caracola demoníaca
	Tooltip:
		'''
		Si prestas atención, oirás gritos
		"Ten cuidado."
		'''
}

RBloodButcherer: {
	DisplayName: "{$ItemName.BloodButcherer}"
	Tooltip:
		'''
		Hace una combinación de tres golpes del Carnicero; el tercer golpe es más amplio y contundente
		Los golpes lanzan chorros de sangre oscura que describen un arco hacia abajo y salpican al impactar
		Los enemigos golpeados sufren "Masacre sangrienta"
		'''
}

RTerraBlade: {
	DisplayName: "{$ItemName.TerraBlade}"
	Tooltip:
		'''
		Hace una combinación de cinco golpes: dos tajos verticales potentes, dos barridos elípticos rápidos y, a continuación, un gran giro
		Cada golpe libera "Luces terra" autoguiadas a lo largo de la trayectoria de la espada: 1 por tajo, 2 por barrido y 4 durante el giro
		La "Luz terra" que impacta en un enemigo invoca una de las almas forjadas de la espada, alternando entre luz y noche
		Alma de luz: una Excalibur verdadera espectral desciende desde lo alto y atraviesa al objetivo
		Alma de noche: una Hoja de la noche verdadera espectral gira en el punto de impacto, golpeando repetidamente
		'''
}
