	Description: Aumenta la velocidad de movimiento. Acércate y haz clic derecho para lanzar la mordedura del Destructor
}

DestroyerFrenzyBuff: {
	DisplayName: Protocolo de aniquilación
	Description: La espada se sobrecarga: aumenta el daño, los proyectiles se dirigen hacia el enemigo y los golpes finales lanzan cabezas de Destructor
}

EyekiteBuff: {
	DisplayName: Mirada cautiva
	Description: Un pequeño Ojo de Cthulhu está atado a ti mediante un cordón empapado en sangre
}

DeepclawBuff: {
	DisplayName: Langosta profunda
	Description: Una langosta abisal merodea a tu lado, con las pinzas listas para atacar
}

BloomCallerBuff: {
	DisplayName: Empresa Floración silvestre
	Description: Un brote de flor silvestre se balancea a tu lado, con las espinas listas para atacar
}

EyetoothWound: {
	DisplayName: Herida por mordedura
	Description: La mordedura sigue sangrando
}

FrenziedMachineSoul: {
	DisplayName: Alma de máquina frenética
	Description: ¡El espíritu de la máquina está encantado!
}

FishoilBuff: {
