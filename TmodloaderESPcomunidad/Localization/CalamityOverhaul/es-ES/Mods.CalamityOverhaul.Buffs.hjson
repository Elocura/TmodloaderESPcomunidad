	DisplayName: Sello de tinta
	Description: Marcadas con la tinta de Kikasa, las invocaciones infligen daño adicional a este objetivo.
}

DivineSourceChargeBuff: {
	DisplayName: Oleada áurica
	Description: La Espada de la fuente divina funciona a plena potencia, el daño se dispara y llueven los rayos
}

VoidErosion: {
	DisplayName: Erosión del vacío
	Description: La nada te está consumiendo
}

