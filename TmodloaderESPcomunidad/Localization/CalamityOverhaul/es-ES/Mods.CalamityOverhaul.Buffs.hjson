	DisplayName: Bendición de la riqueza
	Description: Al morir, se desata una lluvia dorada y devota
}

VerificationBuff: {
	DisplayName: El ojo de la verificación
	Description: Thomas lo ha comprobado: tus golpes seguro que serán críticos.
}

ZealotFervorBuff: {
	DisplayName: Fervor
	Description: El fuego sagrado del fanático arde en su interior; tu velocidad de ataque y de movimiento se disparan
}

