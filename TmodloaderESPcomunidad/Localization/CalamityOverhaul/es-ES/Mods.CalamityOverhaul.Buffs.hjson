	Description: Dejemos que el objetivo se desintegre desde dentro
}

FocusMark: {
	DisplayName: Marca de enfoque
	Description: Los rayos mortales infligen daño adicional a esta marca
}

TemporalStasis: {
	DisplayName: Estasis temporal
	Description: El tiempo se detiene a su alrededor
}

GravitationalCollapse: {
	DisplayName: Colapso gravitacional
	Description: Arrastrado al abismo por su propio peso...
}

