CWRServerConfig: {
	DisplayName: Configuración de contenido
	Headers.CWRWorldGen: Configuraciones de generación del mundo

	GenWindGrivenGenerator: {
		Label: Generar generador eólico
		Tooltip: Coloca Generadores eólicos por todo el mundo.
	}

	GenWGGCollector: {
		Label: Generar puestos avanzados de chatarreros
		Tooltip: Genera aleatoriamente estructuras hostiles de chatarreros por todo el mundo. Esta configuración solo surte efecto en mundos legendarios.
	}

	GenJunkmanBase: {
		Label: Generar base de chatarreros
		Tooltip: Genera una base fortificada de chatarreros en páramos o bajo tierra
	}

	GenRocketHut: {
		Label: Generar cabaña de cohetes
		Tooltip: Genera una misteriosa cabaña que contiene componentes de cohetes o reliquias tecnológicas.
	}

	GenSylvanOutpost: {
		Label: Generar puesto avanzado silvano
		Tooltip: Genera puestos avanzados de madera de los elfos o de los guardianes del bosque en lo más profundo del bosque.
	}

	GenSHPCCradle: {
		Label: Generar isla de la cuna del SHPC
		Tooltip: Genera una planetoide con una nave estrellada sobre el punto de spawn, con el SHPC sellado en su interior. Cuando está desactivada, el arma solo se puede encontrar en el laboratorio de Calamity.
	}

	ConfigChangePrefix: Usuario
	ConfigChangeSuffix: se ha modificado la configuración del servidor
}

CWRClientConfig: {
	DisplayName: Configuración del cliente

	Headers: {
		CWRWeapon: Configuraciones de armas
		CWRDisplay: Display Configs
	}

	ScreenVibration: {
		Label: Vibración de la pantalla al usar armas
		Tooltip: Si se activa, la pantalla vibrará durante algunos ataques, lo que puede hacer que el impacto se perciba con mayor intensidad
	}

	DomainConciseDisplay: {
		Label: Visualización mínima de dominios
		Tooltip: Desactivado por defecto. Cuando está activado, solo se reducen los efectos visuales de los dominios de tipo Ciberespacio y Dominio marino. El dominio Oni de Onikiri no se ve afectado, al igual que los efectos visuales de armas y ciberimplantes, como Desmembrar, Omokage y Modo hackeo.
	}

	LensEasing: {
		Label: Suavizado de la cámara
		Tooltip: Cuando está activado, los desplazamientos rápidos a larga distancia ralentizarán la cámara, lo que evita la sensación de moverse demasiado rápido
	}

	AmbienceDensity: {
		Label: Densidad ambiental
		Tooltip: Solo ajusta la densidad de las partículas ambientales decorativas; las señales de advertencia y los peligros nunca se reducen.
	}

	RarityTextEffects: {
		Label: Rarity Name Effects
		Tooltip: Animated item-name effects for this mod's rarities (Lapis, Jade, Copper, Gilt, Starsilver and the four Legends). When disabled, names are drawn in plain color.
	}
}
