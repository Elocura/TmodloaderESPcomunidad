SHPCModTooltipDraw: {
	InstalledHeader: MÓDULOS INSTALADOS
	NoModules: NINGUNO
	BonusHeader: TOTAL DE BONIFICACIONES DE MÓDULOS
}

MoldProcessingTable: {
	DisplayName: Mesa de procesamiento de moldes
	Tooltip:
		'''
		Haz clic derecho para abrir la tabla de procesamiento de moldes
		Desmontar: funde las piezas de modificación sobrantes y las convierte en fragmentos
		Refundir: consume fragmentos para producir nuevos moldes; puede fijarse en objetivos específicos en el índice
		'''
}

ElementWhip: {
	DisplayName: Látigo elemental
	Tooltip:
		'''
		{$CommonItemTooltip.Whips}
		Incendia a los enemigos con fuego elemental
		"La esencia primordial de Terra impregna el mundo junto con los elementos del cosmos"
		'''
}

AzureDragonRage: {
	DisplayName: Ira del dragón celeste
	Tooltip:
		'''
		{$CommonItemTooltip.Whips}
		Desprende un intenso aroma a hierba fresca
		'''
}

BleedingScourge: {
	DisplayName: Azote sangrante
	Tooltip: Marca a los enemigos para acabar con ellos al impactar y desata una lluvia de sangre
}

GhostFireWhip: {
	DisplayName: Látigo de fuego fantasmal
	Tooltip:
		'''
		{$CommonItemTooltip.Whips}
		Un látigo extremadamente largo tejido con la furia de los espíritus inquietos de la mazmorra
		[c/d4bc75:La pura pasión irradia desde las profundidades del infierno, instándote a encontrar a quien te hizo daño]
		'''
}

DivineSourceBlade: {
	DisplayName: Hoja de la Fuente divina
	Tooltip:
		'''
		Hace una combinación de cuatro golpes: un corte en sentido antihorario, un corte en sentido horario,
		luego un tajo elíptico amplio y un corte inverso siguiendo la misma trayectoria
		Cada golpe lanza una lluvia cada vez mayor de rayos tecnológicos teledirigidos; el corte inverso lanza una colosal media luna azul
		Al infligir daño a los enemigos se va acumulando carga; haz clic derecho para gastar una barra completa y potenciar la espada durante 7 segundos
		Mientras está potenciada, su daño se dispara, los rayos se multiplican y siguen mejor al objetivo, y la luz adquiere un tono dorado auríaco
		"La vida nunca se detiene"
		'''
}

CursedflameBloodfist: {
	DisplayName: Llama maldita puño sangriento
	Tooltip:
		'''
		Hace tanto daño ataque cuerpo a cuerpo como mágico, y se beneficia de todas las bonificaciones de cada uno
		Mantén pulsado clic izquierdo para lanzar una rápida ráfaga de puñetazos, y puedes moverte mientras lo haces
		Cada puñetazo inflige un golpe de daño de área a tu alrededor con un retroceso muy leve
		Cada puñetazo también dispersa una ráfaga de puños de fuego voladores a lo largo del cursor
		Los objetivos arden con Infierno maldito
		La ráfaga consume maná mientras dura y se detiene en cuanto te quedas sin él
		"Sea quien sea a quien perteneciera este brazo, el fuego lo ha reducido a cenizas"
		'''
}

FoodStallChair: {
	DisplayName: Silla para puesto de comida
	Tooltip: I AM THE CHAIR THAT IS APPROACHING!
}

Arbiter: {
	DisplayName: Árbitro
	ManifestInteractHint: "[Clic derecho] Desatascar el hacha"
	ManifestInventoryFullHint: El inventario está lleno: libera espacio antes de sacar el hacha
	Tooltip:
		'''
		Mantén pulsado clic izquierdo del ratón para cargar y levantar el hacha del juicio.
		Suelta el botón para asestar un tajo hacia abajo, lo que provocará una onda de choque llameante que se extenderá a ambos lados a ras de suelo.
		Cuanto más tiempo se cargue, mayor será el alcance y la potencia de las llamas.
		"El juicio desciende a través del fuego"
		'''
}

Cloudwalking: {
	DisplayName: Caminar sobre nubes
	Tooltip:
		'''
		Mantén pulsado clic izquierdo del ratón para cargar y levantar el hacha gigante
		Suelta el botón para lanzar el hacha hacia delante, dejando una estela de humo a su paso
		El hacha volverá automáticamente hacia ti
		'''
}

AnnihilatingUniverse: {
	DisplayName: Aniquilador universal
	Tooltip:
		'''
		Las flechas dejan una estrella brillante en el punto de impacto tras golpear a un enemigo
		Haz clic derecho para destruir a los enemigos con el poder del Devorador
		'''
}

NeutronStarIngot: {
	DisplayName: Lingote de estrella de neutrones
	Tooltip: El peso de todas las cosas, reunido en la yema de tus dedos
}

InfinityCatalyst: {
	DisplayName: Catalizador infinito
	Tooltip: "Tu codicia está a punto de alcanzar su punto álgido"
}

DawnshatterAzure: {
	DisplayName: Rompeamaneceres celeste
	Tooltip:
		'''
		Mantén pulsado clic izquierdo para encadenar un combo de cinco golpes; el giro final provocará una corona de luz
		Haz clic derecho para cargar y, a continuación, lánzate hacia el cursor
		"Deja que las llamas purifiquen tu alma y saqueen por completo a tus enemigos"
		'''
}

Flawless: {
	DisplayName: Impecable
	Tooltip:
		'''
		Hace una combinación de cuatro golpes: barrido, estocada, barrido hacia atrás y estocada final, cada uno más contundente que el anterior
		Los golpes de estocada utilizan la punta del arma para ganar alcance, esparciendo cristales de hielo al impactar
		"Cambió la punta siete veces. El objetivo tiene un solo agujero"
		'''
}

StormGoddessSpear: {
	DisplayName: Lanza de la Diosa de la tormenta
	Tooltip:
		'''
		Una lanza capaz de lanzar feroces besos fulgurantes que rebotan en los enemigos.
		Cuando se sostiene, invoca al espíritu persistente de la Diosa de la tormenta para que te ayude en combate.
		[legend]
		'''
	Legend:
		'''
		Alina fue en su día la guerrera más hábil de Terra, y empuñaba una espada de trueno que atravesaba la oscuridad,
		con una fe inquebrantable y absoluta. Pero la fe no pudo protegerla de la indiferencia de los dioses.
		Cuando la Deidad Suprema dictó sentencia, sus compañeros, familiares, juramentos y gloria quedaron reducidos a cenizas.
		Ella fue testigo de cómo la "justicia" lo pisoteaba todo hasta convertirlo en polvo, de cómo el orden no era más que un velo para ocultar la más cruel de las destrucciones.
		Ya no buscaba la luz, sino que se reforjó a sí misma en el abismo. Un poder antiguo y 
		prohibido consumió su alma, otorgándole una fuerza más allá de la comprensión mortal.
		Su armadura se convirtió en escombros forjados en las profundidades, sus ojos ardían con los restos del trueno y la oscuridad entrelazados.
		Ya no era la guardiana de Terra, sino la tormenta misma: una venganza que no podía detenerse.
		Su furia arrasó el campo de batalla como una tempestad rugiente, su trueno destrozó tronos y templos.
		Ella no luchó por la justicia, ni por Terra, ni por los dioses.
		Luchó por la venganza, por la aniquilación, para que aquellos que se consideraban justos comprendieran el verdadero significado del miedo.
		'''
}

DragonsScaleGreatsword: {
	DisplayName: Gran espada del Dragón de algas
	Tooltip:
		'''
		La espada golpea tres veces, y el tercer golpe desata un poderoso remate draconiano
		Al atacar lanza rayos en espiral de hojas de algas marinas que, al impactar, se convierten en nubes de algas tóxicas
		Los golpes cuerpo a cuerpo verdaderos generan numerosas nubes de algas tóxicas
		Haz clic derecho para invocar un alma de dragón verde que se abalanza hacia el cursor, esparciendo nubes de algas tóxicas a su paso
		'''
}

CosmicCalamity: {
	DisplayName: Desastre galáctico
	Tooltip: Atacar genera ondas de choque con forma de media luna.
}

SpearOfLonginus: {
	DisplayName: Lanza de Longinus
	Tooltip:
		'''
		Mientras la sujetas, se forma una cruz sagrada bajo tus pies que se va llenando poco a poco de energía divina.
		Cada vez que se llena la barra, la Lanza gana una carga, hasta un máximo de seis campos de poder sagrado.
		Marca al enemigo más cercano con la cruz del destino mientras la mantienes.
		Al golpear a un enemigo marcado con un lanzamiento cargado, se desata la Furia del Peregrino.
		[legend]
		'''
	Legend:
		'''

		Oh, dios destrozado, permíteme expiar mis pecados. 
		La guerra se ha prolongado durante siglos, y yo, un fugitivo que huye de la gran civilización,
		llevo una existencia precaria en este planeta desolado en los confines del universo.
		A miles de años luz de distancia, las colosales máquinas de guerra del conflicto reducen las estrellas a polvo.
		Ataques salvajes y terribles borran en un abrir y cerrar de ojos años luz de extensión estelar, transformándola en un dominio de silencio.
		Durante incontables siglos, esta guerra ha sido encarnizada. Ahora, la poderosa civilización a la que pertenezco se tambalea al borde del abismo,
		y me convertiré en un pecador cósmico, el blasfemo más insolente.
		Mi carne se ha descompuesto, mis huesos reflejan las arrugas del paso del tiempo. 
		Estoy a punto de convertirme en una de las débiles máquinas que yo mismo creé. 
		Antes de que ese destino me alcance, que los dioses me concedan el perdón y me abuselvan de mi falta de respeto hacia este ser supremo. 
		Déjame descender al abismo del purgatorio, soportando un tormento sin fin mientras mi alma cae.
		Sin embargo, por el bien de mi civilización, por la victoria en esta guerra que se prolonga durante siglos, debo aprovechar el poder de este dios fragmentado.
		Para gobernar su misteriosa fuerza, no tengo más remedio que infundir su forma divina destrozada con el frío abrazo del metal.
		Esto es un sacrilegio inevitable. Por la continuidad de la civilización, por el triunfo de la guerra, 
		Debo convertirme en el seguidor más devoto de esta entidad suprema, el blasfemo más insolente de la historia.
		'''
}

BloodAltar: {
	DisplayName: Altar de sangre
	Tooltip:
		'''
		Clic derecho sobre el altar con una lágrima de sangre para invocar a la Luna de sangre
		Recoge automáticamente lás lágrimas de sangre los orbes de sangre caídos por todo el mundo y las almacena en el almacenamieto más cercano.
		"Deja que el mundo se tiña de carmesí."
		'''
}

StarMyriadChanges: {
	DisplayName: Estrella de los cambios sin fin
	Tooltip: ¡Alabado sea el Dios del cambio!
}

TerminusOver: {
	DisplayName: El toque final
	Tooltip: La batalla final aguarda, pero hay un precio que pagar.
}

PestilenceIngot: {
	DisplayName: Lingote de pestilencia
	Tooltip: Huele a caramelo ácido de manzana
}

ReminiscenceBreastplate: {
	DisplayName: Coraza de la reminiscencia
	Tooltip: Te recuerda el viaje que has realizado y lo lejos que has llegado.
}

MurasamaMould: {
	DisplayName: Molde dorado sanguíneo
	Tooltip: Un material que parece provenir de otro plano de la existencia. Es cálido y electrizante al tacto, y parece buscar un derramamiento de sangre.
}

OverhaulTheBibleBook: {
	DisplayName: La biblia de Overhaul
	Tooltip: Úsalo para ver tutoriales relacionados con Calamity Overhaul... Es posible que más adelante se añadan más
}

BarrenBow: {
	DisplayName: Arco estéril
	Tooltip: Las flechas disparadas provocarán una corriente estéril al impactar contra el enemigo
}

ElementMuzzleBrake: {
	DisplayName: Freno de boca elemental
	Tooltip:
		'''
		Aumenta el daño a distancia en un 12%
		Aumenta la probabilidad de golpe crítico a distancia en un 15%
		Aumenta la velocidad de disparo a distancia en un 12%
		A los enemigos les cuesta más detectarte
		'''
}

EyeOfSingularity: {
	DisplayName: Ojo de la singularidad
	Tooltip:
		'''
		Aumenta el daño a distancia en un 100%
		Aumenta la probabilidad crítico a distancia en un 100%
		Aumenta la velocidad de disparo a distancia en un 100% y evita el consumo de munición
		Establece el multiplicador de daño crítico para todas las armas a distancia en un 500%
		Tus proyectiles a distancia atraviesan el espacio, creando pequeños agujeros negros al impactar que arrastran y aplastan a los enemigos
		Mientras permaneces quieto, entras en el estado 'Horizonte de sucesos':
		  - Otorga invisibilidad e inmunidad a todo el daño por contacto.
		  - Los ataques liberan ráfagas de rayos gamma adicionales que rastrean a los enemigos.
		Otorga la habilidad de Salto cuántico; pulsa [KEY] para teletransportarte al cursor, borrando los proyectiles enemigos a lo largo del camino
		Haz clic con el botón derecho para activar el 'Protocolo de colapso':
		  - Consume todo el maná para hacer que todos los ataques a distancia ignoren los marcos de inmunidad y forcen golpes críticos durante 10 segundos
		  - 60 segundos de enfriamiento.
		Si recibes daño fatal, te conviertes en una supernova, infligiendo daño extremo en el área, y te reformas en un lugar seguro después de 3 segundos.
		Este efecto tiene un enfriamiento de 60 segundos.
		[c/33ff33:"El Dios dragón dormido se conecta a tus nervios, descomponiendo la lógica basal del espíritu máquina"]
		[c/ffaa00:"Una constelación voraz devora el destello de tu boca, drenando el último calor de las estrellas moribundas"]
		[c/00ffff:"El segador sin forma se convierte en tu sombra, cosechando la fatalidad igual e inevitable de toda vida sensible"]
		'''
}

ArcaneThroneOfEternity: {
	DisplayName: Trono arcano de la Eternidad
	Tooltip:
		'''
		Aumenta el daño mágico en un 100%
		Aumenta la probabilidad de golpe crítico mágico en un 100%
		Aumenta la velocidad de ataque mágico en un 100%
		Aumenta el maná máximo en 1000; la regeneración de maná se potencia enormemente y nunca se interrumpe
		Todos los proyectiles mágicos obtienen perforación infinita
		Tus ataques mágicos rasgan el velo de la realidad, abriendo al impacto Grietas arcanas que no dejan de erupcionar
		Todos los ataques mágicos infligen una maldición prohibida aleatoria:
		Erosión del Vacío, Estasis Temporal, Quema de Almas, Colapso Gravitacional o Hiperdesintegración
		Mientras tengas más del 90% de maná, entras en el estado "Omnisciencia":
		Todos los proyectiles mágicos se dirigen automáticamente hacia los enemigos, y el multiplicador de daño crítico aumenta al 1000 
		Otorga la habilidad Salto de la Verdad; pulsa [KEY] para rasgar el espacio y entrar en una dimensión superior:
		Te vuelves inmune a todo daño y te mueves libremente durante un breve periodo de tiempo, desatando un devastador Temblor de la realidad al terminar
		Enfriamiento de 30 segundos
		Haz clic derecho para activar "Cálculo de la raíz":
		Durante los siguientes 10 segundos, cada ataque mágico lanza simultáneamente 5 hechizos reflejados.
		Enfrentamiento de 60 segundos.
		Si recibes daño mortal, el tiempo retrocede hasta tu estado de hace 5 segundos, restaurando tu vida, maná y posición.
		Este efecto tiene un enfrentamiento de 60 segundos.
		Los enemigos son más propensos a atacarte.
		[c/b84dff:"Un sabio anónimo te abre el cráneo y graba verdades olvidadas más allá de las estrellas"]
		[c/ffdd66:"El Señor del flujo teje la trama y la urdimbre del destino, tratando la realidad como un borrador sin terminar"]
		[c/66ffff:"El cadáver que yace sobre el trono dorado te mira, habiendo olvidado hace tiempo lo que es la muerte"]
		'''
}

PrecisionMuzzleBrake: {
	DisplayName: Freno de boca de precisión
	Tooltip:
		'''
		Aumenta el daño a distancia en un 8%
		Aumenta la probabilidad de golpe crítico a distancia en un 10%
		Aumenta la velocidad de disparo a distancia en un 8%
		A los enemigos les cuesta más detectarte
		'''
}

SimpleMuzzleBrake: {
	DisplayName: Freno de boca simple
	Tooltip:
		'''
		Aumenta el daño a distancia en un 5%
		Aumenta la probabilidad de golpe crítico a distancia en un 5%
		Aumenta la velocidad de disparo a distancia en un 5%
		A los enemigos les cuesta más detectarte
		'''
}

HalibutItem: {
	DisplayName: Halibut
	Tooltip: ""
}

HalibutPilotChart: {
	DisplayName: Carta de navegación
	Tooltip:
		'''
		Úsalo para abrir la guía de Halibut desde el principio, o vuelve a utilizarlo a mitad de la guía para cerrarla
		Se queda contigo si rechazas la guía de inicio; la guía no se consume y se puede volver a utilizar
		'''
	NeedFish: Halibut no está en tu bolsa, por lo que la carta no sirve para orientarse
	HoldFish: La carta está desplegada; coge el Halibut y comienza la guía
	Closed: La guía está guardada; vuelve a usar la carta para reabrirla
	NotNow: En este momento hay otra cosa ocupando el lugar
}

OnikiriItem: {
	DisplayName: Onikiri
	Tooltip:
		'''
		Mantén pulsado clic izquierdo para ejecutar el combo Desgarro carmesí de cinco golpes; cada golpe acertado aumenta la "Postura"
		Pulsa [DASH] para gastar "Vigor" en un "Empuje de Kamui"
		La tecla de expansión del dominio despliega o pliega el dominio Oni; la tecla de cambio de dominio alterna entre Omote y Ura
		En Omote, mantén pulsado [SAKURA] para desplazarte como pétalos de sakura (también se puede encadenar con una carrera); suelta el botón o agota la energía para reaparecer en el mismo lugar
		En Ura, apunta a un enemigo y haz clic izquierdo para desmembrar su cuerpo verdadero; el portador sufrirá entonces un contragolpe del 25% de su vida máxima
		En el breve intervalo tras finalizar un dash o un Vuelo Sakura, haz clic izquierdo para realizar un "Golpe Zanshin"
		Con la Postura a la mitad o más, pulsa [DASH] de nuevo en mitad de un dash o en el segundo siguiente a su finalización para encadenar un dash extra
		Tras un dash de ejecución, haz clic izquierdo para realizar un Destello Aniquilador; con la postura al máximo, un dash de ejecución que atraviese a su objetivo desata directamente un Tajo Final
		Con la postura al máximo, pulsa [EXECUTE] para fijar automáticamente el objetivo, lanzarte y desatar un "Tajo Final"; si no hay ningún objetivo, el ataque se dirige hacia el cursor.
		El dash de ejecución no consume Vigor; una que nunca se convierte no pierde nada.
		[Lang4]
		legend_Text
		'''
}

KikasaItem: {
	DisplayName: Kikasa
	Tooltip:
		'''
		Si mantienes pulsado atacar, Kikasa se queda detrás de tu hombro y se inclina para rociar tinta sobre los enemigos cercanos cuando no estás atacando
		Mantén pulsado clic izquierdo para mantener el paraguas en alto, lanzando una lluvia de tinta autoguiada al ritmo de un compás constante
		Mantén pulsado clic derecho para cargar tinta boca abajo; suéltalo para verter un torrente de tinta
		Mientras lo mantienes pulsado, pulsa "Expansión de dominio" para elevar el Lago de Sangre; pulsa de nuevo para cerrarlo
		Una vez que el agua te llegue a los pies, mantén pulsado un objeto y pulsa "Sumergirse en el lago" para guardarlo; recupéralo en el Corazón del Lago
		Pulsa la misma tecla apuntando a un enemigo para ahogarlo; un jefe ahogado deja tras de sí una sombra hundida.
		Haz clic en la campana de viento de la esquina inferior izquierda para abrir el Corazón del lago y colocar sombras en tres ranuras; lucharán por ti como súbditos
		Mantén pulsada la tecla de la rueda para llamar o retirar a las sombras una a una; cuantas menos haya en el campo de batalla, más fuerte golpeará cada una
		El sector de llama dorada de la rueda enciende el fuego fantasma, que se propaga a lo largo de la orilla y abrasa a los enemigos que toca
		Cuando el nivel de agua esté al máximo, pulsa "Dar la vuelta al lago" (por defecto, botón central del ratón) para alternar entre el «Lago de Sangre» y la «Lluvia Fantasma»
		Los enemigos abatidos bajo la lluvia fantasma resucitan como súbditos-paraguas que luchan a tu lado
		En la lluvia fantasma con el nivel de agua al máximo, pulsa "Reinicio automático" para rebobinar el lugar cercano unos segundos, recargando tu vida y eliminando los efectos negativos
		Con el nivel de agua al máximo, mantén pulsado "Dar la vuelta al lago" para sumergirte en el "Sueño fantasmal": allí los enemigos están indefensos y no pueden existir proyectiles
		Los objetos quedan sellados en el sueño; mantén pulsado clic izquierdo para soltar a los sabuesos y vuelve a pulsar la misma tecla para despertar
		Pulsa «Teletransporte de dominio» para deslizarte a través de un charco de agua hasta tu cursor; serás más rápido dentro del Lago de Sangre
		Un mayor número de ranuras de súbditos acelera el ritmo de la lluvia, añade más gotas y acelera la carga
		4 ranuras: cada latido lanza una gota extra a un segundo objetivo
		7 ranuras: cada cuarto latido lanza todas las gotas a la vez
		10 ranuras: las gotas pesadas dejan charcos de tinta ardiente; un torrente completo estalla en tres géiseres de tinta
		[Lang4]
		legend_Text
		"Bajo el paraguas no llueve, solo se oye el sonido del agua"
		'''
}

KikasaTalismanLin: {
	DisplayName: Talismán de lluvia fina
	Tooltip: Los golpes de lluvia se aceleran y se vuelven más densos a medida que la lluvia persiste; cada gota es ligeramente más ligera
	Origin: El viejo escriba dijo: no hace falta molestar al Rey Dragón para que llueva; basta con un talismán de Lluvia Fina. Las gotas pequeñas están bien, siempre y cuando no dejen de caer nunca
	Power: 
		'''
		"'Lluvia fina': El ritmo de la lluvia de tinta aumenta un 20%; las gotas caen una tras otra; unos diez segundos de lluvia ininterrumpida dan forma a “Lin”: 
		un velo de llovizna cuelga bajo el paraguas y el ritmo se acelera otro 10%; la acumulación se desvanece cuando cesa la lluvia, y al recordar el paraguas, esta se reduce a la mitad de inmediato."
		'''
	Burden: Daño por caída: -6%
}

KikasaTalismanLao: {
	DisplayName: Talismán de charco de tinta
	Tooltip: Toda gota de tinta que toca el suelo forma un charco; el charco bebe la lluvia, sube de nivel y, al llenarse, se desborda; el impacto directo es un poco más leve
	Origin: Al talismánico le fastidiaba que la lluvia se secara en cuanto caía y se malgastara toda la tinta, así que dibujó este talismán para dejarla en el suelo. Un instante más de inundación ya es ganancia
	Power: 
		'''
		«Charcos» Toda gota de tinta que toca el suelo forma un charco (no hace falta llegar al cuarto umbral «Inclinación del lago»); duración del charco +50%, radio +30%; 
		las gotas que se unen a un charco existente suben el nivel del agua, y la tercera lo desborda: la superficie se ensancha un paso y lanza ondas de desborde a ambos lados (50% del daño del charco cada una)
		'''
	Burden: Daño directo de las gotas de tinta -5%
}

KikasaTalismanPei: {
	DisplayName: Talismán de diluvio
	Tooltip: Al invertir la sombrilla la tinta se acumula más rápido; cuando el cuenco está lleno, verter es abrir la compuerta; la lluvia habitual se vuelve un poco más lenta
	Origin: Lo peor al pedir lluvia es que no duela. Este talismán solo atiende una cosa: si va a llover, que sea un diluvio
	Power: 
		'''
		«Diluvio» Velocidad de acumulación invertida +35%, daño de los surtidores de tinta +20%; al llenarse, el borde del cuenco rebosa perlas y emite un zumbido grave: 
		verter en ese instante es abrir la compuerta: el origen de la cascada estalla con un impacto (80% del daño de la cascada) y la cascada de tinta se ensancha
		'''
	Burden: El ritmo de la lluvia de tinta se ralentiza un 8%
}

KikasaTalismanSha: {
	DisplayName: Talismán de lluvia veloz
	Tooltip: La sombrilla se abre en un instante; el primer tiempo suelta tres gotas rápidas seguidas; el tiempo siguiente se retrasa un poco
	Origin: El talismánico iba de noche y se topó con salteadores: abrió la sombrilla, dejó caer la lluvia y la recogió, todo en un parpadeo. Después escribió esa «rapidez» en un talismán
	Power: «Lluvia veloz» Tiempo de apertura de la sombrilla -75%; el primer tiempo al abrirla suelta siempre tres gotas rápidas (75% de daño cada una)
	Burden: Tras el triple, el intervalo del siguiente tiempo +40%
}

KikasaTalismanYin: {
	DisplayName: Talismán de flor de tinta
	Tooltip: Las gotas de tinta que impactan apilan marcas de tinta; al completar cinco capas estalla una flor de tinta; el impacto directo es un poco más leve
	Origin: Una gota de tinta en papel húmedo, si no la limpias, se abre sola en flor. El talismánico decía que los enemigos son igual: unas gotas más, y florecen
	Power: «Flor de tinta» Las gotas dejan una marca al impactar (hasta cinco capas, cada una sangra con el tiempo); al completar cinco se abre la flor, inflige 160% del daño de gota y limpia las capas
	Burden: Daño directo de las gotas de tinta -8%
}

KikasaTalismanLu: {
	DisplayName: Talismán de rocío
	Tooltip: Al impactar, las gotas a veces condensan una perla de rocío; recogerla restaura vida; el ritmo de la lluvia se ralentiza un poco
	Origin: Dicen los textos que el rocío cae del cielo y aleja toda enfermedad. El talismánico no logró ese milagro, así que se conformó con lo segundo: que cada gota lleve un poco de dulzura
	Power: «Rocío» Las gotas de tinta tienen un 12% de condensar una perla de rocío al impactar; recogerla restaura 2 de vida; como máximo tres en el campo
	Burden: El ritmo de la lluvia de tinta se ralentiza un 6%
}

KikasaTalismanFei: {
	DisplayName: Talismán de niebla
	Tooltip: Cada tercera gota se vuelve gota de niebla y deja en el impacto una bruma de tinta que hiere y ralentiza; la gota de niebla en sí es más leve
	Origin: A mitad de la lluvia de montaña, a menudo se vuelve niebla y se pega a la gente. El talismánico pensó que ese aferramiento era peor que las gotas, así que lo metió en el talismán para que trabajara por él
	Power: «Niebla» Cada tercera gota de tinta se vuelve gota de niebla: en el impacto deja bruma de tinta dos segundos; los enemigos dentro sufren daño continuo y -10% de velocidad de movimiento
	Burden: Daño de la gota de niebla -30%
}

KikasaTalismanXian: {
	DisplayName: Talismán de perlas salpicadas
	Tooltip: Las gotas grandes se rompen al caer en cinco perlas de tinta que rebotan; los charcos son un poco más pequeños
	Origin: La lluvia gruesa contra las losas levanta perlas a media altura y te empapa. El talismánico escribió ese bote en el talismán y enseñó a las perlas a morder
	Power: «Perlas salpicadas» Las gotas grandes se rompen al caer en cinco perlas de tinta (30% de daño cada una); cada perla aún puede rebotar dos veces
	Burden: Radio de los charcos de tinta -15%
}

KikasaTalismanXi: {
	DisplayName: Talismán de marea
	Tooltip: Los charcos de tinta respiran con la marea y se abalanzan solos sobre los enemigos cercanos; su duración es un poco más corta
	Origin: El talismánico vivió tres años junto al mar y solo aprendió una cosa: el agua no espera a que la pisen, ella misma se lanza
	Power: «Marea» Los charcos de tinta ganan naturaleza de marea: suben y bajan al respirar; cuando cae tinta nueva en un charco, este se lanza hacia el enemigo más cercano y el borde de la ola inflige 50% del daño del charco
	Burden: Duración de los charcos de tinta -20%
}

KikasaTalismanZi: {
	DisplayName: Talismán de impregnación
	Tooltip: Los enemigos que se empapan en un charco de tinta acumulan capas de impregnación y reciben más daño de tinta; el charco en sí es más leve
	Origin: Para teñir tela hay que dejarla tres días en la tina, o el color no cala. El talismánico teñó tela y sabe mejor que nadie lo que vale un «remojo»
	Power: «Impregnación» Los enemigos dentro de un charco de tinta acumulan impregnación sin cesar (hasta ocho capas); cada capa aumenta un 2.5% el daño de tinta que reciben
	Burden: Daño del charco de tinta -25%
}

KikasaTalismanTing: {
	DisplayName: Talismán de surtidor del trueno
	Tooltip: Los surtidores de tinta se vuelven columnas de agua y trueno que encadenan electricidad a los enemigos cercanos; las cascadas que tocan el suelo a veces levantan un surtidor menor; acumular tinta es un poco más lento
	Origin: Nada asusta tanto como un lago en una noche de tormenta. El rayo entra en el agua y todo el lago se enciende. El talismánico dibujó este talismán a partir de esa escena
	Power: 
		'''
		«Surtidor del trueno» Altura de la columna del surtidor +50%; al impactar encadena electricidad a hasta dos enemigos cercanos (50% del daño del surtidor cada uno); 
		una cascada de tinta que aún no está llena tiene un 25% de levantar un surtidor menor al tocar el suelo
		'''
	Burden: Velocidad de acumulación invertida -13%
}

KikasaTalismanHong: {
	DisplayName: Talismán de puente iris
	Tooltip: Al recogerse la cascada de tinta se alza un puente iris: bajo el puente hay beneficios, el arco quema a los enemigos; la cascada es un poco más estrecha
	Origin: Ver un arcoíris después de la lluvia es buen augurio. El talismánico lo dibujó en el talismán: en cuanto para la lluvia, se tiende el puente, y quien se pone debajo recibe su parte
	Power: 
		'''
		«Puente iris» Al recogerse la cascada de tinta, se alza un puente iris cinco segundos sobre el punto de caída: 
		bajo el puente, velocidad de movimiento +10% y daño de invocación +10%; los enemigos que cruzan el arco reciben 40% del daño de la cascada cada medio segundo
		'''
	Burden: Anchura de la cascada de tinta -10%
}

KikasaTalismanHang: {
	DisplayName: Talismán de miasma nocturno
	Tooltip: De noche el daño de tinta aumenta y los charcos evaporan columnas de miasma; de día baja un poco
	Origin: Dicen que el vapor del agua de noche no se toca. El talismánico guardó una botella de todos modos, y resultó que no se toca. Entonces que lo toquen los enemigos
	Power: «Miasma nocturno» De noche el daño de tinta +15%; los charcos evaporan sin cesar columnas de miasma (30% del daño de gota cada medio segundo)
	Burden: De día el daño de tinta -5%
}

KikasaTalismanBao: {
	DisplayName: Talismán de granizo
	Tooltip: Cada cuarto tiempo todas las gotas se vuelven granizo gigante: golpes que rompen armadura y no dejan charco; el daño habitual de las gotas es un poco más leve
	Origin: El granizo es el mal genio de la lluvia: parte tejas y cubos y nadie lo detiene. El talismánico no quiso domesticarlo; solo pactó: cada cuatro tiempos, uno es suyo
	Power: «Granizo» Cada cuarto tiempo es una descarga conjunta: todas las gotas se vuelven granizo gigante: tamaño x1.6, daño x2.2, rompe armadura y empuja con fuerza; el granizo gigante no deja charcos de tinta
	Burden: Daño de gota de los tiempos normales -8%
}

KikasaTalismanShu: {
	DisplayName: Talismán de lluvia oportuna
	Tooltip: Tras recibir daño, tres segundos de lluvia densísima y cada gota cura; el ritmo habitual se ralentiza un poco
	Origin: En el mundo flotante llaman «lluvia oportuna» a quien llega justo a tiempo. Este talismán sigue esa regla: si el dueño de la sombrilla recibe un golpe, la lluvia tiene que acudir al instante
	Power: «Lluvia oportuna» Durante tres segundos tras recibir daño, el intervalo de la lluvia se reduce a la mitad, los hilos se vuelven dorados y cada gota que impacta restaura 1 de vida; 12 segundos de enfriamiento
	Burden: Intervalo habitual de la lluvia +5%
}

KikasaTalismanLong: {
	DisplayName: Talismán de cascada impetuosa
	Tooltip: La cascada de tinta se vuelve un torrente que empuja a los enemigos; dura menos
	Origin: Cuando baja una riada, nadie se tiene en pie. El talismánico lo vio una vez desde el risco y, al volver, solo escribió un «empuje» en el talismán
	Power: «Cascada impetuosa» La cascada de tinta se vuelve un torrente: el cuerpo de la cascada empuja sin cesar a los enemigos de la línea de caída y el retroceso del impacto directo del origen +35%
	Burden: Duración de la cascada de tinta -20%
}

KikasaTalismanShuang: {
	DisplayName: Talismán de espejo de escarcha
	Tooltip: Los charcos se congelan en espejos de escarcha: pisarlos ralentiza, una gota los rompe y estallan; los charcos no pueden renovarse
	Origin: Tras la escarcha, el agua de los charcos se congela en una noche: parece un espejo, y solo al pisarlo se entiende. Lo que guardó el talismánico fue precisamente esa capa de «parece inofensivo»
	Power: 
		'''
		«Espejo de escarcha» Las gotas grandes se congelan solas en charcos de escarcha (no hace falta llegar al cuarto umbral «Inclinación del lago»); el charco se vuelve espejo: ya no quema, 
		quien lo pisa se ralentiza un 40%; una gota de tinta que golpea el espejo lo rompe al instante, convierte la vida restante del espejo en daño explosivo y alza estalactitas
		'''
	Burden: Cada espejo de escarcha existe por separado; los charcos no pueden fusionarse para renovar su duración
}

KikasaTalismanZha: {
	DisplayName: Talismán de tambor de lluvia
	Tooltip: Si impactas en siete tiempos seguidos, el octavo triplica el daño de todas las gotas; después la lluvia calla un tiempo
	Origin: Las gotas contra la sombrilla ya son un tambor. El talismánico oyó el truco: si no fallas ni un tiempo, el octavo es el más sonoro
	Power: «Tambor de lluvia» Sobre la sombrilla cuelga un anillo de siete puntos: si en siete tiempos seguidos al menos una gota impacta en cada uno, el octavo inflige x3 de daño en todas las gotas, como un redoble; si fallas un tiempo, se cuenta de nuevo
	Burden: Tras el redoble, la lluvia calla un tiempo
}

KikasaTalismanNi: {
	DisplayName: Talismán tricolor
	Tooltip: Las gotas de tinta rotan tres colores: rojo estalla, cian ralentiza, violeta vulnera; el daño de gota baja un poco
	Origin: Que la tinta tenga cinco colores es jerga del oficio; el talismánico solo podía permitirse tres. Aun así, el rojo explota, el cian ata y el violeta corroe: basta
	Power: «Tricolor» Las gotas de tinta rotan tres colores en orden: las rojas estallan en un área pequeña (40% de daño de salpicadura), las cianes ralentizan un 15% y las violetas hacen que el enemigo reciba +5% de daño de tinta
	Burden: Daño de las gotas de tinta -5%
}

KikasaTalismanWen: {
	DisplayName: Talismán de escritura de nubes
	Tooltip: Tres estrellas-talismán en el borde de la sombrilla se cargan con cada impacto y, al llenarse, se lanzan solas como saetas de tinta rastreadoras; el ritmo de la lluvia se ralentiza un poco
	Origin: La escritura de nubes es la letra que el Dao pone en las nubes; un mortal no puede copiarla. El talismánico copió lo que pudo: los caracteres no salieron bien, pero aprendieron a volar
	Power: «Escritura de nubes» Tres estrellas de escritura de nubes rodean el borde de la sombrilla; cada impacto de gota las carga; al llenarse, la estrella de turno se lanza sola como una saeta de tinta rastreadora (120% del daño de gota)
	Burden: Intervalo de la lluvia +8%
}

KikasaTalismanPo: {
	DisplayName: Talismán de alma lunar
	Tooltip: De noche los impactos llenan la luna; en luna llena la siguiente cascada de tinta se vuelve cascada lunar; de día no hace nada
	Origin: El talismánico practicaba de noche y vio una luna pequeña sobre la sombrilla: cuantos más golpes, más redonda. Si la criaba hasta el quince, justo caía una buena cascada
	Power: «Alma lunar» De noche cuelga una luna de tinta sobre la sombrilla y se llena con cada impacto; en luna llena la siguiente cascada se vuelve cascada lunar: anchura x1.5, los golpes dejan estallidos de marca lunar (35% de daño de salpicadura)
	Burden: Este talismán no hace nada de día
}

KikasaTalismanXiao: {
	DisplayName: Talismán de los Nueve Cielos
	Tooltip: La sombrilla suspendida sube a gran altura; las gotas caen más rápido y duelen más; el ritmo de la lluvia se ralentiza un poco
	Origin: La misma gota, desde el alero, solo salpica; desde los Nueve Cielos abre un cráter. El razonamiento del talismánico era así de sencillo
	Power: «Nueve Cielos» La altura de la sombrilla suspendida se duplica; las gotas caen en picado desde lo alto: velocidad terminal +40%, daño +25%, y en el punto de caída aparece primero un anillo de sombra de lluvia
	Burden: Intervalo de la lluvia +10%
}

KikasaTalismanMei: {
	DisplayName: Talismán de lluvia de moho
	Tooltip: Las gotas cuelgan moho que sangra; al morir, un enemigo mohoso infecta a los de alrededor con esporas; el impacto directo es un poco más leve
	Origin: La lluvia de ciruelo duró cuarenta días y el cofre de talismanes crió moho. El talismánico no quiso limpiarlo. Si lo crió la lluvia, también cuenta como de la casa
	Power: «Lluvia de moho» Las gotas de tinta aplican «corrosión de moho» (hasta diez capas, sangrado por capas); al morir, un enemigo mohoso escupe una niebla de esporas que transmite la mitad de las capas a los enemigos cercanos e inflige un poco de daño
	Burden: Daño directo de las gotas de tinta -10%
}

KikasaTalismanPi: {
	DisplayName: Talismán de trueno celestial
	Tooltip: Tras verter una cascada de tinta, durante diez segundos las gotas a veces llaman un rayo que cae en vertical; los surtidores son un poco más leves
	Origin: Los Cinco Truenos del Dao dicen «llamar al rayo con la lluvia». El talismánico no aprendió bien el oficio y solo se quedó con la segunda mitad. Aun así, de lluvia no le faltaba
	Power: «Trueno celestial» Cada vez que vanas una cascada de tinta se abre una ventana de diez segundos: dentro de ella, las gotas tienen un 20% de llamar un rayo que cae en el punto de impacto (180% de daño, atraviesa todo el trayecto del rayo)
	Burden: Daño de los surtidores de tinta -20%
}

KikasaTalismanXia: {
	DisplayName: Talismán de bruma incendiada
	Tooltip: Al amanecer y al atardecer el daño de tinta se dispara y las gotas encienden llama de bruma; al mediodía y en plena noche baja un poco
	Origin: La bruma es lluvia que arde en el horizonte. El talismánico recogió un puñado antes del alba: el papel se tostó, pero el talismán quedó
	Power: «Bruma incendiada» Durante hora y media antes y después del alba y del ocaso, el daño de tinta +18% y las gotas encienden «llama de bruma», una quemadura breve; en esas horas todo el equipo de lluvia se tiñe de naranja dorado
	Burden: Al mediodía y en plena noche el daño de tinta -6%
}

KikasaTalismanJi: {
	DisplayName: Talismán de cielo despejado
	Tooltip: Mientras sostienes la sombrilla, los impactos acumulan serenidad; al recogerla, un haz de luz celestial cae sobre el cursor; durante la apertura el daño de tinta baja un poco
	Origin: En el instante en que escampea, por la rendija de las nubes cae una columna de luz. El talismánico esperó medio mes y, antes de que las nubes se cerraran, la calcó en el talismán
	Power: «Despejar» Los impactos con la sombrilla abierta acumulan serenidad; al recogerla, las nubes se abren un instante y un haz de luz celestial cae sobre el cursor; el daño se calcula según lo acumulado y, al llenarse, es el más feroz
	Burden: Mientras la sombrilla está abierta, el daño de tinta -8%
}

KikasaTalismanYu: {
	DisplayName: Talismán de danza Yu
	Tooltip: Los impactos acumulan ofrendas; al llenarse se abre el altar y se danza: lluvia densa, gotas feroces, charcos y surtidores a pleno; al terminar, tres surtidores a la vez; fuera del gran rito, todo es un poco más romo
	Origin: Los antiguos pedían lluvia alzando un altar y danzando, con las ocho músicas completas; a ese rito lo llamaban «danza Yu». El talismánico metió todo el ceremonial en un solo talismán: la sombrilla es la bruja, la lluvia es la respuesta
	Power: 
		'''
		«Gran Yu» Los impactos de la lluvia de tinta acumulan ofrendas; al llenarse se abre el altar y entra «Gran Yu» diez segundos: el intervalo de la lluvia se reduce a la mitad, 
		las gotas se tiñen de tinta iris y su daño +15%, todas dejan charco al caer y los surtidores se abren del todo; al terminar, tres surtidores brotan a la vez bajo la sombrilla
		'''
	Burden: Fuera del Gran Yu, el daño de tinta -10%
}

SHPCItem: {
	DisplayName: SHPC
	Tooltip: ""
}

AvalancheM60: {
	DisplayName: Avalancha M60
	Tooltip:
		'''
		Usa bolas de nieve como munición.
		Dispara una lluvia de bolas de nieve.
		La potencia de fuego aumenta a medida que disminuye la munición.
		Cada 20 disparos el arma de sobrecarga,
		creando una pequeña avalancha.
		"Denji, hagamos una pelea de bolas de nieve."
		'''
}

CrystalDimming: {
	DisplayName: Atenuación cristalina
	Tooltip:
		'''
		Lanza proyectiles de cristal que hacen surgir picos glaciares del suelo en el punto de impacto
		Los picos crecen más cuando surgen cerca de grupos de cristales ya existentes
		Al hacer clic derecho se desata una oleada glaciar, que forma una cresta de hielo cada vez más alta a lo largo del terreno
		"La tierra recuerda cada helada"
		'''
}

DarkFrostSolstice: {
	DisplayName: Solsticio de escarcha oscura
	Tooltip:
		'''
		Usa bolas de nieve como munición.
		Dispara granizo y llamas polares.
		Cada 20 disparos el arma de sobrecarga,
		invocando la divinidad invernal en el cursor.
		'''
}

SnowQuay: {
	DisplayName: Víbora de las nieves M16
	Tooltip:
		'''
		Utiliza bolas de nieve como munición
		Mantén pulsado el botón izquierdo del ratón para lanzar una densa ráfaga de nieve contra tus enemigos
		Al soplar la nieve, se acumula presión en la cámara de compresión
		Suelta el botón izquierdo del ratón cuando haya suficiente presión para lanzar un proyectil de bola de nieve compactada
		"La alegría del invierno empieza con un lanzanieve"
		'''
}

NeutronGlaive: {
	DisplayName: Cuchilla de la zona negra
	Tooltip:
		'''
		Al agitarla, libera poderosas ondas gravitacionales en forma de espada, lo que provoca una explosión de estrella de neutrones al impactar contra un objetivo
		Clic derecho para cargar la hoja; al soltarlo cuando esté completamente cargada, se producirá una gran explosión estelar de neutrones en el cursor.
		Si se libera antes de estar completamente cargado, la energía se esparcirá.
		'''
}

NeutronBow: {
	DisplayName: La cuerda de Roche
	Tooltip:
		'''
		Dispara flechas gravitacionales que generan rayos gamma al impactar contra un objetivo.
		Clic derecho para realizar un ataque con tres niveles y lanzar tres potentes flechas gravitatorias cuando esté completamente cargado.
		'''
	Lang1: Atrapando la gravedad
	Lang2: Haciendo que la gravedad ceda
	Lang3: ¡¡Terminado!!
}

NeutronGun: {
	DisplayName: Cazador estelar
	Tooltip:
		'''
		Dispara proyectiles gravitacionales que crean puntos de distorsión al impactar contra un objetivo.
		Clic derecho para cambiar al modo francotirador y disparar balas gravitacionales más potentes que invocan rayos gamma al impactar.
		Cada disparo carga el arma y, cuando está completamente cargada, el siguiente disparo provoca una explosión estelar de neutrones en el cursor.
		"¡Derriba al sol!".
		'''
}

NeutronWand: {
	DisplayName: Luz de la tumba estelar
	Tooltip:
		'''
		Al hacer clic izquierdo, se lanza un pulso hacia el cursor; este frena hasta detenerse y gira cada vez más rápido
		Sus dos haces magnéticos barren el campo mientras gira, y pueden coexistir tres a la vez
		Mantén pulsado clic derecho para aplicar un frenado magnético, lo que canaliza la energía del giro hacia la corteza
		Suéltalo para provocar un terremoto estelar: la corteza se parte, la magnetosfera se reconecta y los supervivientes se aceleran
		"El psíquico pretendía aplastar estrellas para convertirlas en agujeros negros, pero solo consiguió crear restos
		congelados en materia degenerada. Los nómadas llaman a ese tramo de cielo la Tumba Estelar".
		'''
}

NeutronScythe: {
	DisplayName: Mensajero del agujero negro
	Tooltip:
		'''
		Una guadaña de neutrones que gira a gran velocidad dispara rayos gamma contra los enemigos cercanos y deja puntos de detonación deformados a su paso.
		Haz clic derecho para lanzar una "Explosión de agujero negro", que lanza trece guadañas hacia fuera en un círculo completo
		'''
}

RebelBlade: {
	DisplayName: Espada rebelde
	Tooltip:
		'''
		Los golpes cuerpo a cuerpo verdaderos generan una gran cantidad de esferas de luz demoníacas alrededor del objetivo.
		Clic derecho para controlar el vuelo de la espada y cortar hacia el cursor
		'''
}

MG42: {
	DisplayName: MG42
	Tooltip:
		'''
		Disparar continuamente provocará que el cañon se sobrecaliente
		Convierte las balas de mosquete en balas perforantes
		'''
}

DragonsWord: {
	DisplayName: Palabra del dragón
	Tooltip:
		'''
		Lanza lágrimas de dragón que giran durante un tiempo antes de dirigirse hacia los enemigos.
		Clic derecho para lanzar una magia de mando del dragón en el cursor, emitiendo una orden de muerte a los enemigos dentro del área.
		"Un dragón solo puede derramar lágrimas una vez en toda su vida"
		'''
}

SnowQuayMK2: {
	DisplayName: Vívora de las nieves MK2
	Tooltip:
		'''
		Una versión militar equipada con un criocompresor que lanza bolas de nieve convertidas en carámbanos a gran velocidad
		Al hacer clic izquierdo se disparan ráfagas de tres disparos; el último disparo es una punta pesada que estalla en cristales
		Al hacer clic derecho se libera una ráfaga de carámbanos de corto alcance por sobrepresión
		"La Vívora de las nieves de segunda generación ya no necesita precalentamiento"
		'''
}

JusticeUnveiled: {
	DisplayName: Justicia revelada
	Tooltip:
		'''
		Los ataques a distancia acumulan cargas de "Golpe del juicio", hasta un máximo de 5.
		Presiona [UP] para gastar 1 carga y provocar un devastador impacto sagrado.
		"Si se invoca la justicia, atenderé la llamada, dondequiera que me lleve."
		'''
}

WeaverGrievances: {
	DisplayName: Quejas de los tejedores
	RitualInteractHint: "[Clic derecho] Saca la cuchilla"
	RitualInventoryFullHint: Tu inventario está lleno. Haz espacio antes de sacar la hoja.
	Tooltip:
		'''
		Desata una gran cantidad de garras de espíritus malignos y consigue efectos especiales en entornos infernales y mazmorras.
		El arma hace tres golpes, y el tercero desata un remate arrollador
		Haz clic derecho y rueda en la dirección del cursor transformándote en una rueda de almas vengativas. Si golpeas a un enemigo durante el giro, obtendrás un fotograma de invencibilidad
		El esquive será perfecto si te lanzas en el momento justo.
		[legend]
		'''
	Legend:
		'''
		La eterna mazmorra se extiende por toda la tierra, con sus paredes grabadas con inscripciones y gritos de antiguos guerreros.
		Cada piedra está saturada de malicia persistente, como cadenas de los condenados, atándola a la oscuridad infinita al final del tiempo.
		Estos guerreros fueron en su día las espadas de su rey, librando guerras por todos los reinos, 
		sus espadas habían iluminado innumerables campos de batalla, y su sangre forjó el imponente imperio.
		Su lealtad era tan duradera como las estrellas, y su convicción era tan inquebrantable como el hierro.
		Sin embargo, cuando cesaron las guerras y las banderas del Señor de los demonios fueron destrozadas a los pies del rey,
		en el momento en que descendió la paz, el rey decretó su envío al abismo. 
		"¡Nosotros nunca cometimos traición, pero el rey nos ha traicionado!". Los angustiados lamentos de los condenados rasgaron el vacío, rompiendo el silencio de la eternidad.
		Sus nobles espíritus no volvieron al polvo, sino que quedaron aprisionados en el abismo del vacío, condenados a ser testigos de la noche eterna.
		Los incesantes lamentos se transformaron en una acusación silenciosa, que llegó hasta los confines más lejanos de las estrellas.
		Se dice que el rey, temeroso de su inquebrantable lealtad y del infierno de su ira, 
		hizo caso a los susurros de los hechiceros del Señor de los demonios, y optó por relegar a estos guerreros a las sombras de la historia.
		Pero la malicia, como una marea, ha distorsionado la realidad de la mazmorra. Su sufrimiento ha sacudido las barreras del tiempo y el espacio, tejiendo una profecía de venganza:
		"¡El Señor de los demonios regresará; el vacío se desgarrará y nuestra ira lo consumirá todo!".
		Cuando Terra se enfrente una vez a la aniquilación, estos muertos inquietos se levantarán de las tinieblas.
		Sus espadas ya no lucharán por la gloria de un imperio, sino por el juicio del traidor.
		La gloria y la lealtad hace tiempo que se han desvanecido; solo quedan las llamas de la venganza, destinadas a consumirlo todo.
		'''
}

Starship: {
	DisplayName: Nave espacial
	Tooltip: 
		'''
		Disparar de forma continuada genera calor, lo que aumenta la cadencia de fuego con el tiempo
		Haz clic derecho para consumir munición y cargar un proyectil cometa; el siguiente disparo lo lanza, causando un daño enorme e infligiendo Hiperdesintegración
		Cuando el calor alcanza su punto álgido, dos escoltas vuelan a tu lado disparando rayos estelares teledirigidos; periódicamente se lanzan planetas desde tu espalda
		Al soltar el gatillo se desata el final: 14 meteoritos teledirigidos que ignoran la defensa y una microgalaxia caen sobre el cursor
		'''
}

SandDagger: {
	DisplayName: Daga de arena
	Tooltip:
		'''
		Se lanza en línea recta y ligeramente cae hacia abajo por la gravedad
		Se clava al impactar; si se clava en la arena, se acumula antes de estallar hacia arriba y desatar una onda de choque en el suelo y una lluvia de picos de arena
		'''
}

UnderTheSand: {
	DisplayName: Colmillo del páramo
	Tooltip:
		'''
		Lanza dos oleadas de arena que caen en arco hacia abajo por la fuerza de la gravedad
		Al impactar contra el suelo, brota de debajo una estela vertical de arena que lanza a los enemigos por los aires
		'''
}

WastelandFang: {
	DisplayName: Colmillo del páramo
	Tooltip:
		'''
		Rebota en los bloques y se acelera al retraerse.
		Al abrir la boca escupe varias esferas de arena
		'''
}

Flawless: {
	DisplayName: Impecable
	Tooltip: ""
}

MelodyTheSand: {
	DisplayName: Canción de las arenas
	Tooltip:
		'''
		Lanza un pequeño tornado de arena que cae al suelo por la fuerza de la gravedad
		Una vez en el suelo, recorre la superficie de un lado a otro, dando marcha atrás al llegar a paredes y salientes
		Lanza repetidamente por los aires a los enemigos a los que golpea
		'''
}

SandVortexOfTheDecayedSea: {
	DisplayName: Vórtice de arena marina descompuesta
	Tooltip:
		'''
		Invoca un colosal vórtice marino putrefacto en el cursor
		El vórtice atrae sin piedad a los enemigos cercanos y los desgarra, llegando incluso a desintegrar los proyectiles hostiles
		Lanza periódicamente hacia fuera orbes marinos putrefactos que siguen al objetivo
		Al disparar de nuevo, se renueva el vórtice existente; cuando se desintegra de forma natural, estalla en un anillo de orbes
		"El rugido de las profundidades en descomposición se convirtió en arena"
		'''
}

DuneStalker: {
	DisplayName: Acechador de las dunas
	Tooltip:
		'''
		Lanza un gancho con cadena en lugar de gastar la munición directamente
		El gancho atraviesa a los enemigos a su paso y, a continuación, se recoge automáticamente al impactar o al alcanzar su alcance máximo
		'''
}

SeasonalKunai: {
	DisplayName: Kunai estacional
	Tooltip:
		'''
		Lanza cuatro kunais principales en forma de abanico; cada uno penetra profundamente y aumenta de tamaño a medida que vuela
		Al impactar o al agotarse, cada hoja se divide en tres kunais secundarios que se dispersan hacia afuera
		Amanecer durante el día, Marcha de la Noche durante la noche.
		"Reflejando las cuatro estaciones".
		'''
}

WraithKunai: {
	DisplayName: Kunai espectral
	Tooltip:
		'''
		Lanza tres espadas carmesí en abanico; cada una de ellas se mantiene suspendida en el aire brevemente antes de abalanzarse a gran velocidad sobre el enemigo más cercano
		Las embestidas estallan con chispas carmesí y sacuden la pantalla, y las espadas detonan al final de su trayectoria, provocando ondas de choque que queman el alma
		Incendia a los enemigos durante el día y les quema el alma por la noche
		'''
}

CalSelfPortrait: {
	DisplayName: Fotografía olvidada
	Tooltip:
		'''
		Una fotografía olvidada
		[legend]
		'''
	Legend: ¿Qué más quieres ver? :)
}

WUTIVSelfPortrait: {
	DisplayName: Gracias, Wuti
	Tooltip: ""
}

HandmadeDoll: {
	DisplayName: Muñeca cosida a mano
	Tooltip:
		'''
		Se usa en el Inframundo para invocar al Muro carnoso.
		Si el Guía está vivo, será sacrificado al usarlo.
		"Hecho a mano, y el Guía no lo sabe"
		'''
}

ScapegoatDoll: {
	DisplayName: Muñeca de chivo expiatorio
	Tooltip:
		'''
		Mientras esté en tu inventario, te protege de la muerte en tu lugar
		La muñeca se hace añicos y se pierde tras recibir el golpe fatal
		'''
	ShatterText: La muñeca que hacía las veces de chivo expiatorio se hizo añicos
}

Snowblindness: {
	DisplayName: Ceguera por nieve
	Tooltip:
		'''
		Lanza bolas de nieve y rayos de hielo a alta frecuencia.
		Al impactar, genera múltiples rayos de hielo EX alrededor del objetivo.
		"Perdido en la ventisca, una espera eterna, un mapa doloroso, un giro brusco,
		lentes agrietadas, manchas de sangre seca, hielo rojo, un castor llorando, una sombra en el hielo".
		'''
}

WhiplashGalactica: {
	DisplayName: Espinazo galáctico
	Tooltip:
		'''
		{$CommonItemTooltip.Whips}
		Marca a los enemigos al golpearlos y lanza bolas de fuego cósmicas.
		"La columna vertebral de la serpiente cósmica, rebosante de energía celestial, guía la furia del universo".
		'''
}

FocusingGrimoire: {
	DisplayName: Grimorio de concentración
	Tooltip:
		'''
		Al hacer clic izquierdo se lanzan anillos térmicos autoguiados que marcan a los enemigos al impactar
		Al hacer clic derecho se disparan rápidamente rayos mortales, que infligen daño adicional y siempre causan un golpe crítico contra los enemigos marcados
		"Mejor que seis libros juntos".
		'''
}

CommandersStaff: {
	DisplayName: Bastón del comandante
	Tooltip:
		'''
		Dispara un rayo de desintegración térmica que atraviesa a los enemigos.
		"Tomado del brazo de esa máquina, ¿qué tal si usamos energía psiónica en lugar de diésel?"
		'''
}

RaiderGun: {
	DisplayName: Asaltante
	Tooltip:
		'''
		Convierte las balas de mosquete en balas de alta velocidad.
		Clic derecho para lanzarte y recargar el cargador.
		La primera bala disparada tras lanzarte se convierte en una granada destructora.
		"Perfecto para rescates de rehenes en interiores".
		'''
}

HyperionBarrage: {
	DisplayName: Torreta automática Hiperión
	Tooltip:
		'''
		Lanza misiles de crucero térmicos que detonan al impactar y prenden fuego a los enemigos
		Cada cuatro veces que se aprieta el gatillo, se lanza verticalmente una salva de tres misiles que se lanzan en picado hacia tu punto de mira
		"Aprovecha todo al máximo".
		'''
}

RaiderGunEX: {
	DisplayName: Asaltante EX
	Tooltip:
		'''
		Convierte las balas de mosquete en balas de alta velocidad.
		Además, dispara una ráfaga de misiles autodirigidos destructores
		Clic derecho para lanzarte y recargar el cargador
		La primera bala disparada tras lanzarte se convierte en una granada destructora.
		"Bombardeo intensivo"
		'''
}

CommandersChainsaw: {
	DisplayName: Motosierra del comandante
	Tooltip:
		'''
		Genera chispas al impactar contra un objetivo
		"Añade más diésel''
		'''
}

GeminisTribute: {
	DisplayName: Homenaje a los gemelos
	Tooltip:
		'''
		Lanza alternativamente una guadaña Retinator y una guadaña Espasmatizador, trazando un recorrido sinusoidal de un lado a otro
		Al hacer clic derecho, lanza ambas guadañas en un arco cruzado; al impactar, un ojo de los Gemelos fusionado se condensa y lanza una lluvia de pulsos bicolores por toda la zona
		"Solo puede existir una personalidad dominante y, claramente, el ojo Espasmatizador ha ganado".
		'''
}

Dicoria: {
	DisplayName: Dicoria
	Tooltip:
		'''
		Dispara dos balas, se puede cargar.
		Los disparos completamente cargados liberan un rayo térmico.
		"Por cierto, ¿esto no nos dejará bizcos?"
		'''
}

DestroyersBlade: {
	DisplayName: Hoja del destructor
	Tooltip:
		'''
		Dispara barreras térmicas.
		"Contiene el inmenso núcleo energético del Destructor"
		'''
}

Observer: {
	DisplayName: Observador
	Tooltip: '''"Todavía te está observando"'''
}

StaffoftheDestroyer: {
	DisplayName: Bastón del destructor
	Tooltip:
		'''
		Invoca a un Destructor en miniatura para que luche por ti.
		Cuanto mayor sea el límite de espacios de súbditos, más fuerte será el Destructor.
		Se requieren al menos cuatro espacios de súbditos.
		'''
}

EyekiteStaff: {
	DisplayName: Cometa de la mirada atada
	Tooltip:
		'''
		Invoca un pequeño Ojo de Cthulhu atado a ti mediante un cordón de tendón rojo y blanco
		Flota como una cometa, esforzándose por escapar antes de que la cuerda lo arrastre de vuelta
		Se abalanza con fuerza sobre los enemigos cercanos y, a continuación, la cuerda lo arrastra de vuelta como golpe final
		Se pueden invocar varios ojos a la vez
		'''
}

BloodshotBomb: {
	DisplayName: Bomba sangrienta
	Tooltip:
		'''
		Su mecha se enciende en cuanto lo agarras; la mecha se consume en tres fases, de aproximadamente dos segundos cada una
		Cuanto más corta sea la mecha, más rojo será el ojo, más intensa será la explosión y más carne lanzará por los aires
		Lánzalo en cualquier momento con clic izquierdo; estalla al entrar en contacto, y al clavarse en la carne hace que salgan volando trozos de esta
		Si la mecha se consume mientras aún lo sostienes, explota en tu mano
		"No soporta la idea de dejarte"
		'''
	SelfBoom: "{0} echó una mirada de más"
}

Eyetooth: {
	DisplayName: Diente de ojo
	Tooltip:
		'''
		Lanza a tus enemigos un colmillo arrancado del Ojo de Cthulhu
		Al morder a un enemigo, el colmillo se eleva por encima de su cabeza, apunta y luego se lanza en picado para asestar un segundo mordisco
		Inflige un 150% de daño rogue, y las heridas causadas por el colmillo siguen sangrando
		'''
}

Shatterfang: {
	DisplayName: Colmillo rompedor
	Tooltip:
		'''
		Encadena tres golpes para realizar un tajo devastador que desgasta enormemente la hoja
		El tajo que agota la hoja la hace añicos de golpe, lanzando un enorme fragmento de diente desprendido
		Los golpes normales lanzan de forma intermitente pequeños fragmentos de diente sujetos a la gravedad
		La espada de media hoja se balancea más rápido, pero golpea con menos fuerza y ya no lanza fragmentos.
		Los ataques continuados también desestabilizan la hoja hasta que se desmorona silenciosamente.
		Haz clic derecho para dedicar un momento a reparar la hoja; también se va reparando lentamente mientras descansas, y emite un tintineo cuando queda intacta
		"Un colmillo roto de las fauces rechinantes, que aún ansía morder".
		'''
}

CommandersClaw: {
	DisplayName: Garra del comandante
	Tooltip:
		'''
		Lanza una lanza de comandante ornamentada cuya punta siempre apunta hacia delante.
		Cada impacto provoca una lluvia de chispas metálicas, ondas de choque y un fuerte temblor de la pantalla.
		Pueden volar varias lanzas a la vez, clavándose en el terreno al impactar contra una pared y atravesando a los enemigos al golpearlos.
		'''
}

CommandersStaffEX: {
	DisplayName: Bastón del comandante EX
	Tooltip:
		'''
		Dispara cinco rayos sobrecargados que giran en espiral y convergen como un taladro cortante
		"Adecuado para cortar metal"
		'''
}

CommandersChainsawEX: {
	DisplayName: Motosierra del comandante EX
	Tooltip: '''"Destruye todo lo que se interponga en tu camino"'''
}

SoulofFrightEX: {
	DisplayName: Alma de terror EX
	Tooltip:
		'''
		Contiene pulsos de energía terrorífica concentrados en el interior
		Se obtiene al derrotar a la máquinas rebeldes durante la revelión de las máquinas.
		'''
}

SoulofMightEX: {
	DisplayName: Alma de poder EX
	Tooltip:
		'''
		Contiene pulsos de energía destructiva concentrados en el interior
		Se obtiene al derrotar a la máquinas rebeldes durante la revelión de las máquinas
		'''
}

SoulofSightEX: {
	DisplayName: Alma de visión EX
	Tooltip:
		'''
		Contiene pulsos de energía sapiente concentrados en el interior
		Se obtiene al derrotar a la máquinas rebeldes durante la revelión de las máquinas
		'''
}

DestroyersBladeEX: {
	DisplayName: Hoja del destructor EX
	Tooltip:
		'''
		Los golpes contundentes desatan cortes de color negro-carmesí, rayos de energía y descargas de sombra
		Envainar la espada activa momentáneamente el Protocolo de acecho: aumenta la velocidad de movimiento
		Mientras acechas, haz clic derecho para convertirte en las fauces del Destructor y morder a tu presa; si no hay ningún objetivo, se abalanzará hacia el cursor
		Una mordedura acertada inflige un daño enorme y activa el Protocolo de aniquilación:
		todos los proyectiles adquieren capacidad de seguimiento, y los golpes finales lanzan cabezas del Destructor
		"Siempre es más fácil destruir que construir"
		'''
}

ThermalGenerator: {
	DisplayName: Generador térmico
	Tooltip:
		'''
		Pon combustible para generar energía.
		Clic derecho sobre el bloque para insentar comustible rápidamente,y clic derecho presionando MAYUS para quitar el combustible
		'''
}

FluidPipeline: {
	DisplayName: Tubería de fluidos
	Tooltip:
		'''
		Transporta agua, lava, miel o fulgor
		Cada tubería transporta solo un fluido a la vez; debe vaciarse por completo antes de cambiar a otra
		Haz clic derecho para retirarla rápidamente
		'''
}

FluidPump: {
	DisplayName: Bomba de líquidos
	Tooltip:
		'''
		Mientras está encendida, aspira el líquido del entorno situado debajo de la máquina hacia su depósito interno
		Cuesta 2 UE por casilla de líquido drenado; el fluido se transporta a través de tuberías hasta los depósitos y las máquinas
		'''
}

FluidTank: {
	DisplayName: Depósito de fluidos
	Tooltip:
		'''
		Almacena hasta 32 bloques de líquido; la ventana muestra el nivel de llenado
		Se conecta a bombas y máquinas a través de tuberías de fluidos
		Si se rompe el depósito, se vacía su contenido
		'''
}

LargeFluidTank: {
	DisplayName: Depósito de fluidos de gran capacidad
	Tooltip:
		'''
		Almacena hasta 128 bloques de líquido; la ventana muestra el nivel de llenado
		Se conecta a bombas y máquinas a través de tuberías de líquido
		Si se rompe el depósito, se vacía su contenido
		'''
}

CircuitBoard: {
	DisplayName: Placa de circuito impreso
	Tooltip: Componente electrónico básico de las máquinas industriales
}

FluidInjector: {
	DisplayName: Inyector de fluidos
	Tooltip:
		'''
		Consume líquido almacenado para verterlo en el lugar situado debajo de la máquina
		Cuesta 2 UE por bloque de líquido vertido
		Ten cuidado por donde pisas al verter lava
		'''
}

BottlingMachine: {
	DisplayName: Máquina embotelladora
	Tooltip:
		'''
		Llena botellas y cubos vacíos con el líquido almacenado, o vacía los recipientes llenos de nuevo en el depósito
		Cada tarea cuesta 5 UE; los productos se envían a la ranura de salida
		Ambas ranuras están conectadas a conductos de objetos para su transferencia automática
		'''
}

MagmaThermalGenerator: {
	DisplayName: Generador térmico de magma
	Tooltip:
		'''
		Genera un poco de energía al entrar en contacto con la lava, y su energía estará al máximo mientras su depósito contenga magma
		Aliméntalo a través de tuberías de fluidos o haz clic derecho con un cubo de lava para verterla directamente
		La primera fuente de energía fundamental para una fábrica infernal
		'''
}

FluidText: {
	WaterName: Agua
	LavaName: Lava
	HoneyName: Miel
	ShimmerName: Fulgor
	EmptyName: Vacío
	BarFormat: "{0} {1}/{2}"
}

ShimmerTransmuter: {
	DisplayName: Transmutador de fulgor
	Tooltip:
		'''
		Inserta un objeto y gasta fulgor para transformarlo; los resultados se colocan en las ranuras de salida
		Cada conversión cuesta 10 UE y 64 unidades de fulgor, que se bombean desde el estanque de fulgor a través de tuberías
		Admite transformaciones y desmontaje de objetos; se rechazan las monedas y los objetos que liberan criaturas
		Las ranuras de entrada y salida se conectan a tuberías de objetos para una carga automática
		'''
}

ThermalBattery: {
	DisplayName: Batería térmica
	Tooltip: Almacena cierta cantidad de energía eléctrica
}

WindGrivenGenerator: {
	DisplayName: Generador eólico
	Tooltip: Las aspas se mueven con el viento para generar electricidad
	UnderstandWindGriven: Es necesario comprender cómo funciona la energía eólica
	UnderstandWindGriven2: Es necesario desenterrar antiguas máquinas eólicas en asteroides para comprender cómo están fabricadas
}

WindGrivenGeneratorMK2: {
	DisplayName: Generador eólico MK2
	Tooltip: Las aspas se mueven con el viento para generar electricidad
	UnderstandWindGrivenMK2: Se requiere un profundo conocimiento de la energía eólica
	UnderstandWindGrivenMK2Remind: Es necesario extraer las gigantescas turbinas eólicas de los asteroides para comprender sus principios de fabricación
}

ThermalGeneratorMK2: {
	DisplayName: Generador térmico MK2
	Tooltip:
		'''
		Pon combustible para generar energía.
		Clic derecho sobre el bloque para insentar comustible rápidamente,y clic derecho presionando MAYUS para quitar el combustible.
		'''
}

WGGMK2Wilderness: {
	DisplayName: Aerogeneradores gigantes en medio de la naturaleza salvaje
	Tooltip: ""
}

WGGWilderness: {
	DisplayName: Aerogeneradores en la naturaleza salvaje
	Tooltip: ""
}

TeslaElectromagneticTower: {
	DisplayName: Torre electromagnética Tesla
	Tooltip:
		'''
		Requiere energía eléctrica para funcionar
		Clic derecho después de colocarlo en el suelo para cambiar entre el modo de ataque y el modo de defensa
		En modo ataque, emite arcos eléctricos a los enemigos cercanos
		En modo defensa, electrocuta a todos los enemigos dentro de su alcance; si un jugador se encuentra dentro su alcance
		y sostiene un objeto recargable, la torre emitirá arcos eléctricos para cargar el objeto del jugador de forma remota
		"Ingenieros, manténganse alejados"
		'''
}

FlameTurret: {
	TurretOnText: Torreta lanzallamas activada
	TurretOffText: Torreta lanzallama desactivada
	NoEnergyText: ¡Energía insuficiente!
	FuelLoadText: Gel cargado x{0}
	FuelTakeText: Gel extraído x{0}
	DisplayName: Torreta lanzallama
	Tooltip:
		'''
		Necesita energía eléctrica para funcionar
		Lanza llamas de forma continua contra los enemigos que se acercan; el fuego atraviesa a las multitudes y aplican Fuego infernal
		Haz clic derecho en la torreta mientras sostienes gel para cargar combustible; el gel en llamas hace que las llamas tengan más fuerza
		Pulsa Mayús + clic derecho para recuperar el gel; los conductos de objetos también pueden introducir gel en la ranura de combustible
		Haz clic derecho con la mano vacía, o envía una señal por cable, para activar o desactivar la torreta
		"Huele a gel asado"
		'''
}

CryoTurret: {
	TurretOnText: Torreta criogénica activada
	TurretOffText: Torreta criogénica desactivada
	NoEnergyText: ¡Energía insuficiente!
	DisplayName: Torreta criogénica
	Tooltip:
		'''
		Necesita energía eléctrica para funcionar
		Esparce escarcha de forma continua sobre todos los enemigos que se encuentren dentro de su alcance, congelándolos y ralentizándolos
		Un enemigo que permanezca cubierto de escarcha durante unos dos segundos queda congelado momentáneamente
		Su función es ralentizar y congelar; el daño que inflige es solo una leve quemadura por escarcha
		Haz clic derecho o envía una señal por cable para activar o desactivar la torreta
		"Tranquilo"
		'''
}

LaserTurret: {
	TurretOnText: Torreta láser activada
	TurretOffText: Torreta láser desactivada
	NoEnergyText: ¡Energía insuficiente!
	DisplayName: Torreta láser
	Tooltip:
		'''
		Necesita energía eléctrica para funcionar
		Dispara rayos de gran daño a los enemigos que se encuentran en su línea de visión; tiene un alcance muy largo y una cadencia de fuego lenta
		No se fija en objetivos bloqueados por el terreno; da prioridad a los jefes
		Haz clic derecho o envía una señal por cable para activar o desactivar la torreta
		"Un disparo, un enemigo abatido"
		'''
}

ShieldGenerator: {
	FieldOnText: Campo de escudo activado
	FieldOffText: Campo de escudo desactivado
	NoEnergyText: ¡Energía insuficiente!
	DisplayName: Generador de escudo
	Tooltip:
		'''
		Necesita energía eléctrica para funcionar
		Mientras esté activado, los jugadores que se encuentren dentro de su radio de acción obtienen un escudo de energía
		El escudo se recarga lentamente, absorbe parte del daño recibido y desaparece al salir del radio de acción
		Cuantos más jugadores proteja, más rápido se agota su energía
		Haz clic derecho o envía una señal por cable para activar o desactivar el campo
		'''
}

HealStation: {
	FieldOnText: Aura curativa activada
	FieldOffText: Aura curativa desactivada
	NoEnergyText: ¡Energía insuficiente!
	DisplayName: Estación de curación
	Tooltip:
		'''
		Necesita energía eléctrica para funcionar
		Mientras está encendido, regenera lentamente la salud de todos los jugadores que se encuentren dentro de su radio de acción
		Haz clic derecho o envía una señal por cable para activar o desactivar el aura
		"¿Accidentes laborales? Nunca he oído hablar de eso"
		'''
}

EmblemOfDread: {
	DisplayName: Emblema del terror
	Tooltip:
		'''
		Aumenta el daño cuerpo a cuerpo en un 100%
		Aumenta la probabilidad de golpe crítico cuerpo a cuerpo en un 100%
		Aumenta la velocidad cuerpo a cuerpo en un 100%
		Aumenta la defensa en 100, ignorando todo el daño y la reducción de defensa
		Reduce el daño recibido en un 75 % y refleja 100 veces el daño al atacante
		Todos los ataques cuerpo a cuerpo infligen la desventaja 'Erosión del vacío'.
		Los ataques cuerpo a cuerpo verdaderos tienen la posibilidad de eliminar instantáneamente a los enemigos con menos de 250.000 puntos de vida.
		Moverse a altas velocidades deja puntos de teletransporte en tu camino, lo que inflige un daño extremo a los enemigos. Otorga la habilidad de usar Salto de gravedad; pulsa [KEY] para correr una larga distancia y liberar rayos gravitacionales masivos
		Si recibes daño fatal, recuperas inmediatamente todos los HP y obtienes un Gravity Shield (tiempo de recarga de 60 segundos).
		Los enemigos son más propensos a atacarte
		[c/d94fff:"Un ángel santificado vela tu mirada, susurrando mentiras eternas y empalagosas"]
		[c/ff4d4d:"Un carnicero empapado en sangre levanta tus espadas gemelas y declara que solo la matanza trae gloria"]
		[c/4da6ff:"Una paloma azul picotea tu frente, burlándose de tu insignificante lucha"]
		'''
}

ElectricMinRocket: {
	DisplayName: Mini cohete eléctrico
	Tooltip:
		'''
		Clic derecho para usar el cohete, o colócalo en el suelo y haz clic derecho para lanzarlos.
		Pulsa las teclas direcionales en el aire para ajustar la dirección.
		Mantén pulsado ABAJO para descender lentamente; volar consumirá energía gradualmente.
		Pulsa la barra espaciadora para interrumpir el vuelo.
		"Fabricado en la Unión Soviética, robusto y fiable, casi llegó a la Luna".
		'''
}

TeleportStation: {
	NoEnergyText: ¡Energía insuficiente!
	TargetNoEnergyText: ¡La estación de destino no tiene electricidad!
	UnnamedText: Estación sin nombre ({0}, {1})
	DisplayName: Estación de teletransporte
	Tooltip:
		'''
		Crea una red de teletransporte con todas las demás estaciones del mundo
		Haz clic derecho para abrir el panel y, a continuación, haz clic en un destino para viajar
		El teletransporte consume energía en función de la distancia; además, el destino necesita un poco de energía en modo de espera
		Se puede asignar un nombre a las estaciones para que sean fáciles de encontrar en la lista.
		'''
}

ElectricSundial: {
	NoEnergyText: ¡Energía insuficiente!
	BusyText: ¡El tiempo ya está avanzando a toda prisa!
	SkipBroadcast: "{0} activó el reloj de sol eléctrico; el tiempo vuela hasta el amanecer"
	DisplayName: Reloj de sol eléctrico
	Tooltip:
		'''
		Almacena 1000 de energía y, a continuación, haz clic derecho para avanzar rápidamente en el tiempo hasta el amanecer
		Funciona con su propia fuente de energía, sin tener en cuenta el tiempo de recarga de 7 días del Reloj de sol encantado
		Notifica a todo el servidor cuando se utiliza
		'''
}

WeatherController: {
	NoEnergyText: ¡Energía insuficiente!
	RainBroadcast: "{0} activó el controlador de climas; las nubes de lluvia se están reuniendo"
	ClearBroadcast: "{0} activó el controlador de climas; escamparon las nubes"
	DisplayName: Controlador de climas
	Tooltip:
		'''
		Haz clic derecho para gastar 500 puntos de poder y provocar una lluvia, o para detenerla mientras llueve
		Solo controla la lluvia; el viento no te hará caso
		Al usarla, se envía una notificación a todo el servidor
		'''
}

SolarPanel: {
	DisplayName: Panel solar
	Tooltip:
		'''
		Genera energía durante el día, alcanzando su máximo al mediodía
		Su producción se reduce considerablemente cuando llueve y deja de funcionar por completo durante los eclipses
		Deja de funcionar cuando hay bloques sólidos que lo cubren desde arriba.
		'''
}

SolarPanelMK2: {
	DisplayName: Panel solar MK2
	Tooltip:
		'''
		Genera energía durante el día, alcanzando su máximo a mediodía, y es tres veces más eficiente que el original
		Su rendimiento se reduce considerablemente con la lluvia y deja de funcionar por completo durante los eclipses
		Deja de funcionar cuando hay bloques sólidos que lo cubren desde arriba.
		'''
}

CapacitorMatrix: {
	DisplayName: Matriz de condensadores
	Tooltip:
		'''
		Un gran acumulador de energía con una capacidad de hasta 40.000 de potencia
		Tiene un rendimiento de carga y descarga mucho mayor que el de la batería térmica, el volante de inercia de cualquier red eléctrica de gran tamaño.
		'''
}

UEPipeline: {
	DisplayName: Tubería de energía
	Tooltip:
		'''
		Se utiliza para transmitir energía eléctrica
		Clic derecho para desmontar rápidamente y recuperar la tubería en la posición del cursor
		Se conecta a generadores y otras fuentes de energía para transferir energía a baterías o dispositivos eléctricos
		'''
}

WireInterface: {
	ModeBridgeText: Solo puente: una señal por cable activa o desactiva las máquinas adyacentes
	ModeFullText: Aviso de lleno: emite una señal por cable cuando las máquinas adyacentes están completamente cargadas
	ModeEmptyText: Aviso de vacío: emite una señal por cable cuando las máquinas adyacentes se quedan sin combustible
	MachineOffText: En espera
	MachineOnText: Activo
	DisplayName: Interfaz de cables
	Tooltip:
		'''
		Un adaptador bidireccional entre los cables mecánicos y la red eléctrica
		Al recibir una señal por cable, alterna entre el estado activo y el de espera las máquinas situadas junto a él
		Haz clic derecho para activar el modo de informe cíclico: emite una señal por cable cuando las máquinas adyacentes se llenan o se vacían
		Colócalo junto a la máquina que quieras controlar y, a continuación, conecta un cable a él
		'''
}

Sensor: {
	TitleText: Sensor multimodo
	ConditionLabelText: Condición de disparo
	ModeOffText: Apagado
	ModeChargeAboveText: Carga por encima del umbral
	ModeChargeBelowText: Carga por debajo del umbral
	ModeEnemyText: Alerta de enemigos
	ModeBloodMoonText: Luna de Sangre
	ModeEclipseText: Eclipse solar
	ModeSlimeRainText: Lluvia de slimes
	ModeInvasionText: Invasión
	ThresholdLabelText: Umbral de disparo
	RangeLabelText: Radio de alerta
	EventHintText: Lee eventos del mundo, no necesita parámetros
	OutputLabelText: Modo de salida
	OutputLevelText: Nivel continuo
	OutputPulseText: Pulso único
	StatusActiveText: Condición cumplida
	StatusIdleText: En espera
	StatusNoPowerText: Sin electricidad
	StatusOffText: Apagado
	EnergyLabelText: Electricidad
	DisplayName: Sensor multimodo
	Tooltip:
		'''
		Es el ojo electrónico de la red; haz clic derecho para abrir el panel de configuración
		Vigila los umbrales de carga adyacentes, los enemigos cercanos o las lunas de sangre, los eclipses, la lluvia de slimes y las invasiones
		Emite una señal a lo largo de su cableado cuando se cumple la condición, con salida de nivel continuo o de pulso único
		Consume 0,1 de energía por tick en modo de espera; las evaluaciones se detienen cuando se queda sin energía
		'''
}

GridSwitch: {
	OpenText: Abierto
	CloseText: Cerrado
	DisplayName: Conmutador de red
	Tooltip:
		'''
		Interruptor de corriente integrado en el trazado de la tubería
		Se activa haciendo clic derecho o mediante una señal por cableado; no pasa corriente mientras está abierto
		Colócalo entre dos segmentos de tubería para poner en marcha y detener secciones de la red
		'''
}

EnergySword: {
	DisplayName: Espada de energía
	Tooltip:
		'''
		Gasta energía para disparar láseres que dañarán a múltiples enemigos.
		"Apenas se usa"
		'''
}

LaserPistol: {
	DisplayName: Pistola láser
	Tooltip:
		'''
		Gasta energía para disparar láseres que dañarán a múltiples enemigos.
		"Apenas se usa"
		'''
}

HyperionBarrageEX: {
	DisplayName: Torreta automática Hiperión EX
	Tooltip:
		'''
		Tras alcanzar el objetivo, el misil guiado por calor se dividirá en múltiples partes para causar daños secundarios.
		"Más allá de su uso previsto"
		'''
}

MiningMachine: {
	DisplayName: Máquina minera
	Tooltip:
		'''
		Consume energía eléctrica para perforar minerales
		Debe colocarse en un lugar adecuado para que funcione correctamente
		Se pueden extraer minerales especiales en entornos especiales
		'''
	DontWork: Debe colocarse sobre una superficie firme para poder llevar a cabo las operaciones mineras.
}

ExcavationBoosterModule: {
	DisplayName: Módulo de refuerzo de excavación
	Tooltip:
		'''
		Instálalo en una máquina minera para acortar su ciclo de trabajo un 30%
		Los engranajes cuentan ahora con un juego de dientes más resistentes
		'''
}

PickPowerBoosterModule: {
	DisplayName: Módulo de refuerzo de potencia de pico
	Tooltip:
		'''
		Instálalo en una máquina minera para aumentar su potencia de excavación en un 60%
		Permite que una máquina chapada en estaño devore el mitril
		'''
}

ChlorophyteDrillModule: {
	DisplayName: Módulo de perforación de clorofita
	Tooltip: La broca en sí está fundida en clorofita — un mineral que extrae otros minerales
}

EfficiencyModule: {
	DisplayName: Módulo de eficiencia
	Tooltip:
		'''
		Instálalo en una máquina minera para reducir el coste energético de cada ciclo en un 60%
		Las bobinas por fin dejaron de calentarse
		'''
}

YieldBoosterModule: {
	DisplayName: Módulo de mejora de rendimiento
	Tooltip:
		'''
		Instálalo en una máquina minera para aumentar en un 3 % la probabilidad de obtener lingotes
		El tamiz tiene un grado de finura más fino.
		'''
}

ProspectorModule: {
	DisplayName: Módulo prospector
	Tooltip:
		'''
		Instálalo en una máquina minera para triplicar el peso de los subproductos raros: gemas, fósiles, meteoritos y chatarra
		Bajo la lupa, hasta la arena tiene una jerarquía
		'''
}

SurveyArrayModule: {
	DisplayName: Módulo de matriz de exploración
	Tooltip:
		'''
		Instálalo en una máquina de extracción para ampliar y profundizar su alcance de exploración en un 50%
		El eco llega antes que la broca
		'''
}

VeinFocusModule: {
	DisplayName: Módulo de enfoque en vetas
	Tooltip:
		'''
		Instálalo en una máquina minera para aumentar en un 60% la influencia de las vetas reales en la producción
		Sigue la veta; no te pelees con la roca
		'''
}

DoubleLoadModule: {
	DisplayName: Módulo de doble carga
	Tooltip:
		'''
		Instálalo en una máquina minera para que cada producción tenga un 25% de probabilidades de duplicarse
		La tolva se ha ampliado un tamaño.
		'''
}

OverdriveCoreModule: {
	DisplayName: Módulo de núcleo de sobremarcha
	Tooltip:
		'''
		Instálalo en una máquina minera para acortar su ciclo de trabajo en un 45%, con un coste energético un 60% mayor
		No hay planes de detenerla hasta que los cojinetes se calienten.
		'''
}

ThrottleValveModule: {
	DisplayName: Módulo de válvula de mariposa
	Tooltip:
		'''
		Instálalo en una máquina de minera para alargar su ciclo de trabajo en un 50% y reducir el coste energético en un 45%
		Es lento, pero toda la noche es suya
		'''
}

ChestLinkModule: {
	DisplayName: Módulo de conexión torácica
	Tooltip:
		'''
		Instálalo en una máquina minera para que deposite los recursos directamente en los cofres cercanos, y solo los suelte cuando estén llenos
		Así te ahorras tener que agacharte
		'''
}

SmelterModule: {
	DisplayName: Módulo de fundición de campo
	Tooltip:
		'''
		Instálalo en una máquina minera para fundir minerales y convertirlos en lingotes según las proporciones del horno antes de la producción, con un coste energético un 40% mayor
		Lingotes directamente desde la boca del pozo.
		'''
}

MachineModuleText: {
	TagText: Módulo de mejora de máquina
	TargetsLine: Compatible con: {0}
	HowToText: Haz clic derecho en una máquina compatible e insértalo en su panel
	SocketOnly: ¡Esta máquina no admite ese módulo!
	SocketDuplicate: ¡Ya hay un módulo de este tipo instalado!
	SocketEmptyHint: Inserta un módulo de mejora
	SlotLabel: Modules
	NameMining: Máquina minera
	NameThermal: Generador térmico
	NameWind: Turbina eólica
	NameHydro: Generador hidráulico
	NameIncinerator: Incineradora
	NameCrusher: Trituradora de mineral
	NameRecycler: Reciclador
	NameMagma: Generador térmico de magma
	NameBiomass: Generador de biomasa
	NameTurret: Torreta defensiva
	NameSolar: Panel solar
}

InsulationLiningModule: {
	DisplayName: Módulo de revestimiento aislante
	Tooltip:
		'''
		Instálalo en un generador térmico para reducir la disipación de calor en un 55%
		Tres capas de amianto: el calor nunca sale de ahí
		'''
}

ForcedDraftModule: {
	DisplayName: Módulo de ventilación forzada
	Tooltip:
		'''
		Instálalo en un generador térmico para que arda un 45% más rápido y a mayor temperatura
		Con solo una bombeada del fuelle, las brasas se enderezan
		'''
}

SlowBurnValveModule: {
	DisplayName: Módulo de válvula de combustión lenta
	Tooltip:
		'''
		Instálalo en un generador térmico para reducir la combustión al 60% y así aprovechar al máximo cada trozo de combustible
		Reduce la llama al mínimo y un trozo de carbón te durará media noche
		'''
}

HeatRecoveryModule: {
	DisplayName: Módulo de recuperación de calor
	Tooltip:
		'''
		Instálalo en un generador térmico para aumentar el rendimiento calorífico por unidad de combustible en un 25%
		Dos codos adicionales en el conducto de humos recogen el calor que se escapa
		'''
}

AutoFeedHopperModule: {
	DisplayName: Tolva de alimentación automática
	Tooltip:
		'''
		Instálalo en un generador térmico, un incinerador o un generador de biomasa para extraer la materia prima del almacén cercano
		La tolva solo responde cuando hay una ranura vacía.
		'''
}

ExtendedBladesModule: {
	DisplayName: Módulo de palas extendidas
	Tooltip:
		'''
		Instálalo en un aerogenerador para aumentar la producción en un 30%
		Cada pulgada más allá de la punta de la pala antigua es viento libre
		'''
}

LowWindGearboxModule: {
	DisplayName: Módulo para de vientos flojos
	Tooltip:
		'''
		Instálalo en un aerogenerador para aumentar el factor de viento mínimo de 0,8 a 1,3
		El engranaje de corte fino aprovecha hasta la más mínima brisa.
		'''
}

TallTowerModule: {
	DisplayName: Módulo de torre alta
	Tooltip:
		'''
		Se instala en un aerogenerador para aumentar la producción en un 15%; se puede combinar con el Módulo de palas extendidas
		Diez metros más alto, con un poco más de viento
		'''
}

FlowShroudModule: {
	DisplayName: Módulo de protección del flujo
	Tooltip:
		'''
		Instálalo en un generador hidráulico para aumentar la producción en un 30%
		La boca acampanada recoge el agua dispersa en un solo chorro
		'''
}

QuickSpinModule: {
	DisplayName: Módulo de giro rápido
	Tooltip:
		'''
		Instálalo en un generador hidráulico para triplicar la velocidad de aceleración
		Bobinado apretado; alcanza la velocidad de funcionamiento en cuanto entra en contacto con el agua
		'''
}

DeepBearingModule: {
	DisplayName: Módulo de cojinetes para aguas profundas
	Tooltip:
		'''
		Instálalo en un generador hidráulico para aumentar la potencia en un 15%; se puede combinar con el Módulo de protección del flujo
		El eje no desperdicia nada; la rueda lo aprovecha todo
		'''
}

HighTempElectrodeModule: {
	DisplayName: Módulo de electrodos para altas temperaturas
	Tooltip:
		'''
		Instálalo en un incinerador para fundir un 45% más rápido
		Apunta las agujas una hacia la otra y el arco extinguirá el fuego en ese punto
		'''
}

EconomizerCoilModule: {
	DisplayName: Módulo de bobina económica
	Tooltip:
		'''
		Instálalo en un incinerador para reducir el coste energético de la fundición en un 60%
		Se ha rebobinado con alambre esmaltado fino; ahora el contador gira con suavidad
		'''
}

TwinCrucibleModule: {
	DisplayName: Módulo de crisol doble
	Tooltip:
		'''
		Instálalo en un incinerador para tener un 25% de probabilidades de duplicar la producción por lote
		Un fuego, dos tazas
		'''
}

AutoEjectChuteModule: {
	DisplayName: Tolva de expulsión automática
	Tooltip:
		'''
		Instálalo en un incinerador para enviar los productos directamente al almacén cercano
		Conecta la rampa y el horno se encargará de llenar las estanterías por sí solo
		'''
}

CapacityCellModule: {
	DisplayName: Módulo de celdas de capacidad
	Tooltip:
		'''
		Instálala en cualquier máquina para aumentar la capacidad energética en un 50%
		Todas las tomas de corriente del taller admiten estas placas
		'''
}

TurretRangefinderModule: {
	DisplayName: Módulo de telémetro para torreta
	Tooltip:
		'''
		Instálalo en una torreta defensiva para ampliar la puntería en un 25%
		Las torres de escudo y de curación amplían su aura en su lugar
		La lente detecta al enemigo antes que el cañón.
		'''
}

TurretAutoloaderModule: {
	DisplayName: Módulo de carga automática de torreta
	Tooltip:
		'''
		Instálalo en una torreta defensiva para disparar un 30% más rápido
		Las torretas de aura no tienen ritmo de disparo, por lo que no tiene ningún efecto en ellas
		La siguiente bala se carga antes de que la anterior impacte
		'''
}

TurretPowerSaverModule: {
	DisplayName: Módulo de ahorro de energía para torreta
	Tooltip:
		'''
		Instálalo en una torreta defensiva para reducir su consumo de energía al 75%
		Aplica tanto al consumo por disparo como al consumo continuo
		El medidor por fin se ralentiza durante un asedio
		'''
}

CopperTinDrill: {
	DisplayName: Broca de cobre/estaño
	Tooltip: La primera pieza que puliste hasta dejarla reluciente
}

IronLeadDrill: {
	DisplayName: Broca de hierro/plomo
	Tooltip: La broca dura más que el mineral; eso es todo lo que necesita
}

SilverTungstenDrill: {
	DisplayName: Broca de plata/tungsteno
	Tooltip: Su filo está recubierto de una dignidad que se niega a oxidarse
}

GoldPlatinumDrill: {
	DisplayName: Broca de oro/platino
	Tooltip: Me ha entrado el gusto por el metal suave
}

EvilOreDrill: {
	DisplayName: Broca para mineral maligno
	Tooltip: Sumergido en ambos males; cada bando lo reclama
}

MeteoriteDrill: {
	DisplayName: Broca de meteorito
	Tooltip: Lo que cae del cielo se enfrenta al acero forjado en el cielo
}

ObsidianDrill: {
	DisplayName: Broca de obsidiana
	Tooltip: Un lugar donde el agua se encuentra con el fuego
}

HellstoneDrill: {
	DisplayName: Broca de piedra infernal
	Tooltip: El mango todavía está caliente
}

FossilDrill: {
	DisplayName: Broca de fósiles
	Tooltip: Los pinceles iban demasiado lentos
}

CoalDrill: {
	DisplayName: Broca para vetas de carbón
	Tooltip: En la sala de calderas la piden por su nombre
}

GemClusterDrill: {
	DisplayName: Broca para racimos de gemas
	Tooltip: Una mandíbula de diamante que solo muerde lo que brilla
}

CobaltPalladiumDrill: {
	DisplayName: Broca de cobalto/paladio
	Tooltip: Aún tiene fragmentos del altar entre los dientes
}

MythrilOrichalcumDrill: {
	DisplayName: Broca de mithril/oricalco
	Tooltip: Gira con un zumbido que tiene un aire ligeramente sagrado
}

AdamantiteTitaniumDrill: {
	DisplayName: Broca de adamantita/titanio
	Tooltip: Los huesos duros de las profundidades son asunto suyo
}

LuminiteDrillModule: {
	DisplayName: Módulo de perforación de luminita
	Tooltip: Los restos lunares se extraen igual que cualquier otra cosa
}

HoChaMeditatorItem: {
	DisplayName: Meditador HoCha
	Tooltip: ""
}

Collector: {
	DisplayName: Coleccionista
	Tooltip:
		'''
		Recoge automáticamente los objetos caídos a su alrededor para luego colocarlos en el almacenamiento más cercano
		No funcionará si no hay almacenamientos cerca.
		Haz clic derecho del sobre el coleccionista mientras sostienes un objeto para marcarlo, de modo que solo recoja ese tipo de objeto
		'''
	Text1: ¡Cantidad excesiva!
	Text2: ¡No hay cajas alrededor!
	Text3: ¡No hay electricidad!
}

WGGCollector: {
	DisplayName: Reclicador
	Tooltip:
		'''
		Le apasiona el reciclaje, y eso te incluye a ti.
		Para él, no hay diferencia real entre una botella de plástico y tu médula espinal.
		'''
}

LaserEnergyTrans: {
	DisplayName: Transporte de energía láser
	Tooltip:
		'''
		Transmisión remota de energía.
		Después de colocarlo, haz clic derecho para activar la navegación láser y, 
		a continuación, haz clic derecho en otros dispositivos de energía para conectarlos.
		Cuanto mayor sea la distancia de transmisión, mayor será la pérdida de energía. 
		La pérdida máxima es del 100%
		'''
}

MetalMusicBox: {
	DisplayName: Caja de música (Revelión de las máquinas)
	Tooltip: Reproduce "Fall of the Bit" de Ryusa
}

Hydroelectric: {
	DisplayName: Generador hidroeléctrico
	Tooltip:
		'''
		Genera electricidad al sumergir esta máquina en el agua
		'Una aplicación de la mecánica de fluidos'
		'''
}

HydroelectricMK2: {
	DisplayName: Generador hidroeléctrico MK2
	Tooltip:
		'''
		Genera electricidad al sumergir esta máquina en el agua
		'Una aplicación de la mecánica de fluidos'
		'''
}

CreativeUEPipeline: {
	DisplayName: Tubería creativa de energía
	Tooltip: ""
}

ItemFilter: {
	DisplayName: Tablero filtrador de objetos
	Tooltip:
		'''
		Úsalo para abrir el editor de listas; haz clic en el panel con un objeto sobre el cursor para registrarlo
		Úsalo mientras apuntas a un colector para copiar su lista, o a un cofre para copiar su contenido
		Haz clic derecho sobre un colector, una línea de transporte de objetos u otra máquina mientras mantienes pulsado para instalar la lista
		'''
	StateFormat: "{0} · {1} entradas registradas"
	CopiedFromChest: Contenido del cofre copiado
	CopiedFromCollector: Lista del recolector copiada
}

SporeBubbleBlaster: {
	DisplayName: Disparador de burbujas de esporas
	Tooltip: Proyecta un chorro de aire con esporas
}

TomeofFungalDecay: {
	DisplayName: Libro del deterioro fúngico
	Tooltip: ""
}

FungalRevolver: {
	DisplayName: Revólver fúngico
	Tooltip:
		'''
		Convierte las balas de mosquete en proyectiles fúngicos
		"Limpiarlo solo empeoró las cosas"
		'''
}

FungalFeed: {
	DisplayName: Alimento fúngico
	Tooltip:
		'''
		Lanza un cangrejo de esporas que puedes domesticar
		Un cangrejo de esporas domesticado te seguirá y luchará a tu lado
		Puede equiparse con un [i:CalamityOverhaul/MushroomSaddle] sillín fúngico para convertirlo en montura.
		"Les encantan las setas"
		'''
}

MushroomSaddle: {
	DisplayName: Sillín fúngico
	Tooltip:
		'''
		Se puede equipar en un cangrejo esporas domesticado con [i:CalamityOverhaul/FungalFeed] un alimento fúngico
		Clic izquierdo en el cangrejo fúngico mientras sostienes el sillín para equiparselo
		Clic derecho aun cangrejo espora equipado con el sillín para montar
		'''
	UseCombat: Solo se puede equipar en un Cangrejo de esporas
}

SporeboundRoller: {
	DisplayName: Bobina de esporas
	Tooltip:
		'''
		Genera una pequeña seta flotante tras golpear a un enemigo
		Les encanta seguir dando vueltas"
		'''
}

Spectrometer: {
	DisplayName: Espectrómetro
	Tooltip:
		'''
		Permite teñir artículos con color.
		Requiere energía para funcionar
		'''
}

SporeburstPouch: {
	DisplayName: Bolsa explosiva de esporas
	Tooltip:
		'''
		Lanza una granada de esporas giratoria que detona al impactar o cuando se agota su tiempo de vida
		Libera una onda de choque tóxica y una lluvia de metralla de esporas autoguiadas; los enemigos alcanzados quedan envenenados
		'''
}

Pallbearer: {
	DisplayName: Portador del féretro
	Tooltip:
		'''
		Presiona clic izquierdo para cargar y suéltalo para disparar una flecha.
		Cuando mayor sea el tiempo de carga, más poderosa será la flecha
		Clic derecho para lanzar la ballesta
		Golpear a un enemigo potencia significativamente la siguiente flecha y acelera la velocidad de carga.
		"También conocido como el portador del ataúd"
		'''
}

EncyclopediaofOceanicKnowledge: {
	DisplayName: Enciclopedia del conocimiento oceánico
	Tooltip:
		'''
		Aprenderás al instante todas las especies de peces. 
		Desbloquea todas las habilidades relacionadas con los peces.
		[c/FFD700: La sabiduría del océano convergerá en ti]
		'''
	Text1: Has dominado todo el conocimiento
	Text2: ¡Has adquirido [NUM] de conocimientos sobre peces!
}

TheForgottenTome: {
	DisplayName: El tomo olvidado
	Tooltip:
		'''
		Cuando se usa, borra cada rastro de tus recuerdos mundanos.
		Una vida ensombrecida, condenada a una caída eterna.
		Todos los seres cargan con sus pecados, y ningun alma encarnará en la próxima vida.
		Mi nombre es [NAME]. Si estás leyendo esto, significa que ya no estoy vivo.
		'''
	CompletionText: Has olvidado todo
	ConditionsText: Consigue cualquier final de la historia
}

Fishoil: {
	DisplayName: Aceite de pescado embotellado
	Tooltip:
		'''
		Aumenta el poder de pesca en un 10%
		Permite respirar bajo el agua
		Otorga resistencia adicional contra ciertas entidades inquietantes
		'''
}

SirenMusicalBox: {
	DisplayName: Caja de musica de sirena
	Tooltip:
		'''
		Haz clic derecho para reproducir música inquietante proveniente de esta caja de música.
		Todos los que lo escuchen serán maldecidos, incapaces de morir mientras la música suene.
		Cuando la música termine, sufrirán un ataque fatal
		'''
	DeathText: "{0} Desintegrado en carne pútrida bajo el ataque de lo desconocido"
}

Heartcarver: {
	DisplayName: Arrancacorazones
	Tooltip:
		'''
		Cada puñalada lanza una daga de sangre giratoria que se guía por el olor de las heridas
		Haz clic derecho para realizar una estocada corta en forma de arco
		Los corazones absorbidos otorgan una breve aumento de la velocidad de ataque y se condensan en cuchillas de sangre que giran en órbita
		Las cuchillas de sangre se lanzan contra la herida de tu próximo Golpe cortante
		'''
	CarveTip:
		'''
		Mientras la sostienes, la hoja late al ritmo de tu corazón
		Los golpes que impactan en el intervalo entre dos latidos se convierten en Golpes talladores
		Termina el combo con un Golpe tallador para arrancar el corazón de una pieza.
		'''
}

OniMachete: {
	DisplayName: Machete Oni
	Tooltip:
		'''
		Realiza una combinación de tres golpes, que culmina con un tajo fulminante que se mantiene en el aire un instante antes de caer
		Mientras se mantiene activada, se invocan seis manos de oni para que luchen a tu lado.
		'''
	SuppressTip:
		'''
		Los golpes y las embestidas avivan la supresión del azufre; cada golpe que asestan las seis manos de los oni quema al enemigo hasta hacerlo desaparecer
		Cuando la llama se apaga, las manos se inquietan: luchan con más fuerza y pueden volverse para estrangularte.
		'''
}

Pandemonium: {
	DisplayName: Pandemonium
	Tooltip:
		'''
		Haz clic izquierdo para cargar el arma y liberar Magia trascendental
		Haz clic derecho para lanzar una Runa de azufre en el cursor
		Mientras se mantiene pulsado, se iluminan dos botones de habilidades en la parte inferior izquierda de la pantalla
		Haz clic en ellos para desatar "El juicio del azufre" o "El fin de todos los demonios"
		'''
	SkillLeftName: Juicio de azufre
	SkillLeftDesc: Invoca un campo de columnas de fuego de azufre alrededor del cursor
	SkillRightName: El fin de todos los demonios
	SkillRightDesc: Despliega un círculo mágico gigante centrado en ti, que golpea a los enemigos que se encuentran en su interior con rayos y fuego
}

Elysium: {
	DisplayName: Elíseo
	Tooltip:
		'''
		Mantén pulsado clic izquierdo para canalizar el Rito de la Serpiente.
		Suéltalo para lanzar una oleada de luz sagrada que convertirá a los enemigos menores que toque en serpientes sagradas que te perseguirán
		Haz clic derecho para exaltar a un habitante cercano de la ciudad, llamándolo a tu lado como discípulo
		Los discípulos te rodean, cada uno desempeñando su propio cargo, y te otorgan bendiciones sagradas
		El daño infligido por los jefes consume a un discípulo, aplicando un punto de Poder del martirio
		Con once puntos de Poder del martirio y si Juan aún en su cargo, el botón de habilidad desata la Revelación
		Una vez que desciende la Revelación, al hacer clic derecho se invocan los Cuatro Jinetes
		Las teclas de habilidad se convierten entonces en "Meteoro celestial" y "El Juicio de los últimos sellos".
		Con los doce asientos ocupados, la bendición alcanza su punto álgido, pero cuantos estes apunto de morir te enfrentarás a la espada de Judas
		Mantén pulsada la tecla Mayús para abrir el Rosetón; arrastra los asientos para reasignar los cargos sagrados
		Mientras lo mantienes pulsado, se iluminan dos botones de habilidad en la parte inferior izquierda de la pantalla
		'''
	SkillLeftName: Trueno sagrado
	SkillLeftDesc: Hace caer un rayo santo sobre el enemigo junto al punto de mira
	SkillRightName: Juicio de los tres últimos sellos
	SkillRightDesc: El quinto, el sexto y el séptimo sello se abren uno tras otro; el juicio final barre los cuatro puntos y el Apocalipsis se cierra
	SkillRightLockedDesc: Solo puedes romper los sellos tras el Apocalipsis
	SkillOpenName: Abrir el Apocalipsis
	SkillOpenDesc: Juan se eleva en martirio y el dominio del cielo desciende
	SkillMeteorName: Meteoro celestial
	SkillMeteorDesc: Hace caer un cuerpo celeste desde la bóveda hacia donde apunta el cursor
	NoConvertTargetText: No hay habitantes cerca que se puedan sublimar
	SeatsFullText: Las doce sillas santas están ocupadas
	JudasDeathReasonText: "{0} fue vendido por Judas por treinta monedas de plata"
	DiscipleName_0: Pedro
	DiscipleName_1: Andrés
	DiscipleName_2: Santiago
	DiscipleName_3: Juan
	DiscipleName_4: Felipe
	DiscipleName_5: Bartolomé
	DiscipleName_6: Tomás
	DiscipleName_7: Mateo
	DiscipleName_8: Santiago el Menor
	DiscipleName_9: Tadeo
	DiscipleName_10: Simón el Zelote
	DiscipleName_11: Judas
}

Proverbs: {
	DisplayName: Proverbio
	Tooltip:
		'''
		Genera una pequeña runa de azufre detrás de ti
		Otorga inmunidad a la mayoría de los debuffs basados en fuego
		La mayoría de tus ataques infligen el debuff de Maldición Marchita
		[Content]
		'''
	L1:
		'''
		Hace el doble de daño a la Bruja de azufre;
		Los ataques de ella pueden provocar más golpes críticos
		'''
	L2:
		'''
		Si estás leyendo esto, entonces probablemente ya me habré ido.
		A lo largo de mis largos años, este anillo fue lo único que se sintió frío de verdad.
		Pero en algún momento del camino, absorbió el calor de un mortal... y se volvió... demasiado caliente para dejarlo ir.
		He regresado al Azufre, reducida a las cenizas de una era.
		Debería haber partido sin nada, 
		y aun así codicio este calor singular y deseo preservarlo.
		Llévatelo.
		Y cuando finalmente levantes tu espada contra los dioses...
		que sepas, que incluso si el mundo se congela, yo seguiré ardiendo en las llemas de tus dedos...
		'''
}

AncientStormGoddessSpear: {
	DisplayName: Lanza de la Diosa de la tormenta Antigua
	Tooltip:
		'''
		Una lanza capaz de lanzar feroces besos fulgurantes que rebotan en los enemigos.
		"Esta lanza ya es cosa del pasado, pero aún funciona."
		[legend]
		'''
	Legend:
		'''
		Alina fue en su día la guerrera más hábil de Terra, y empuñaba una espada de trueno que atravesaba la oscuridad, 
		con una fe inquebrantable y absoluta. Pero la fe no pudo protegerla de la indiferencia de los dioses.
		Cuando la Deidad Suprema dictó sentencia, sus compañeros, familiares, juramentos y gloria quedaron reducidos a cenizas. 
		Ella fue testigo de cómo la "justicia" lo pisoteaba todo hasta convertirlo en polvo, de cómo el orden no era más que un velo para ocultar la más cruel de las destrucciones.
		Ya no buscaba la luz, sino que se reforjó a sí misma en el abismo. Un poder antiguo y 
		prohibido consumió su alma, otorgándole una fuerza más allá de la comprensión mortal.
		Su armadura se convirtió en escombros forjados en las profundidades, sus ojos ardían con los restos del trueno y la oscuridad entrelazados. 
		Ya no era la guardiana de Terra, sino la tormenta misma: una venganza que no podía detenerse.
		Su furia arrasó el campo de batalla como una tempestad rugiente, su trueno destrozó tronos y templos. 
		Ella no luchó por la justicia, ni por Terra, ni por los dioses.
		Luchó por la venganza, por la aniquilación, para que aquellos que se consideraban justos comprendieran el verdadero significado del miedo.
		'''
}

ConstructionBlueprintQET: {
	DisplayName: Plano de Construcción (Torre de entrecruzamiento cuántico)
	Tooltip:
		'''
		Se usa para aprender a crear el [i:CalamityOverhaul/CQETConstructor] Autoconstructor
		"Tus manos forjarán la piedra angular y la torre que conectarán dos mundos"
		'''
	L1: Has aprendido a crear el Auto-Constructor (Torre de entrecruzamiento cuántico)!
	L2: ¡Ya has aprendido este plano!
}

CQETConstructor: {
	DisplayName: Autoconstructor (Torre de entrecruzamiento cuántico)
	Tooltip:
		'''
		Colocalo para construir una Torre de entrecruzamiento cuántico
		Requiere de una gran cantidad de [i:CalamityOverhaul/StarflowPlatedBlock] Bloques chapados con luz estelar
		'''
	UseConstructionBlueprint: Aprende el Plano de Construcción (Torre de entrecruzamiento cuántico)
}

DeploySignaltower: {
	DisplayName: Torre de entrecruzamiento cuántico
	Tooltip:
		'''
		Un dispositivo de comunicación importante que actúa como un faro en el subespacio
		"Un niño salvaje levanta una antorcha en el bosque, gritando "¡Estoy aquí!"
		'''
}

StarflowPlatedBlock: {
	DisplayName: Bloques chapados con luz estelar
	Tooltip:
		'''
		Material básico para construir la [i:CalamityOverhaul/DeploySignaltower] Torre de entrecruzamiento cuántico
		"Moldear la luz que fluye de las estrellas para darle una cimiento eterno"
		'''
}

PQCD: {
	DisplayName: Comunicador cuántico portátil
	Tooltip:
		'''
		Se usa para contactar a Draedon y abrir la interfaz de compras holográfica del arsenal de Draedon
		"Teóricamente es capaz de emitir una Orden de exterminio, pero la autorización parece insuficiente"
		'''
	NeedSignalTowersText: ¡Enlace de entrecruzamiento cuántico incompleto! Requiere que {0} torres de señal estén desplegadas.
	SignalTowerProgressText: Progreso en el despliegue de torres: {0}/{1}
}

Unsunghero: {
	DisplayName: Héroe anónimo
	Tooltip:
		'''
		Aumenta el sigilo máximo en 10
		La velocidad de regeneración del sigilo ya no reduce el daño del sigilo
		"¿Y si nunca regresas?"
		"Entonces nunca volveré."
		'''
}

AriaofTheCosmos: {
	DisplayName: Aria del cosmos
	Tooltip:
		'''
		Mantén presionado el clic izquierdo para cargar un cuásar poderoso, que causará un daño devastador al liberarlo
		Haz clic derecho para liberar un mini agujero negro que dispara una lluvia de rayos gamma una vez formado
		Mientras se mantiene pulsado, se iluminan dos botones de habilidad en la parte inferior izquierda de la pantalla
		Pulsa sobre ellos para invocar a un Guardián del anillo estelar o activar una ráfaga de rayos gamma
		'''
	SkillLeftName: Guardián del anillo estelar
	SkillLeftDesc: Invoca un anillo estelar en órbita cuyos nodos lanzan una lluvia de polvo estelar contra los enemigos cercanos
	SkillRightName: Explosión de rayos gamma
	SkillRightDesc: Tras una breve recarga, lanza nueve rayos gamma en forma de abanico hacia el cursor
}

Oceanfragments: {
	DisplayName: Restos océanicos
	Tooltip: Un objeto misterioso. El Viejo Duque podría estar interesado en ello.
}

OceanRaiders: {
	WorkingText: Funcionando...
	NoWaterText: ¡Debe colocarse debajo del agua para funcionar!
	NoEnergyText: ¡Energía insuficiente!
	DisplayName: Devorador del océcano
	Tooltip:
		'''
		Consume energía para extraer recursos de los cuerpos de agua
		Haz clic derecho para abrir el almacenamiento interno
		'''
}

OldDuchest: {
	StorageText: Gran cofre de almacenamiento
	DisplayName: Viejo Duqofre
	Tooltip:
		'''
		Un cofre con una capacidad inmensa
		"El antiguo cofre del Duque. Si está cerca, podrías meter algunas cosas adentro."
		'''
}

QuestLogBook: {
	DisplayName: Libro de misiones
	Tooltip: Úsalo para abrir o cerrar la interfaz de misiones
}

MermanRod: {
	Text1: ¡Una Percha de tritón ya ha sido colocada en el mundo!
	DisplayName: Percha de tritón
	Tooltip:
		'''
		Incrementa el poder de pesca en 20 cuando estás cerca
		El Viejo Duque trasladará su campamento aquí
		'''
}

MiningMachineMk2: {
	DontWork: Es necesario colocarlo sobre una superficie dura para poder realizar la excavación.
	DisplayName: Máquina minera Mk2
	Tooltip:
		'''
		Los taladros para mineral funcionan con energía eléctrica; exploran zonas más amplias y profundas que los originales
		Haz clic derecho para abrir la terminal de prospección, comprueba las probabilidades de rendimiento e instala los módulos de mejora
		'''
}

UniversalFrost: {
	DisplayName: Helada universal
	Tooltip:
		'''
		Usa bolas de nieve como munición
		Al hacer clic izquierdo se disparan rápidamente destellos de escarcha; cada disparo carga la cúpula de escarcha
		Una vez cargada por completo, al hacer clic derecho se despliega una cortina de aurora sobre el cursor
		La cortina lanza una lluvia de lanzas de escarcha sobre los enemigos que se encuentran debajo
		"Cuando toda la creación se queda en silencio, solo la aurora sigue fluyendo por el cielo"
		'''
}

GodslayerScabbard: {
	DisplayName: Vaina del Asesino de Dioses
	Tooltip:
		'''
		Acumula carga mientras sostiene un arma cuerpo a cuerpo sin atacar
		Atacar con la carga completa otorga 2 segundos de invulnerabilidad
		"Aunque la espada permanece envainada, su intención asesina es palpable.
		Cuando llega el momento adecuado, asesinar a un dios será cuestión de un instante."
		'''
}

Lumberjack: {
	Text1: ¡Cantidad excesiva!
	Text2: ¡Falta de electricidad!
	CycleModeText: Modo cíclico
	ClearModeText: Modo libre
	DisplayName: Leñador
	Tooltip:
		'''
		Consume energía para talar árboles
		Tala automáticamente los árboles circundantes
		Haz clic derecho para cambiar entre el modo cíclico y el modo libre
		El modo cíclico cosecha árboles continuamente y replanta árboles jóvenes
		El modo libre solo talará árboles sin replantar
		'''
}

LifeWeaver: {
	NoValidPositionText: ¡No hay lugares válidos para plantar cerca!
	NoEnergyText: ¡Energía insuficiente!
	DisplayName: Plantadora de árboles
	Tooltip: Consume energía para plantar árboles en las cercanías
}

WGGLumberjack: {
	DisplayName: Leñador salvaje
	Tooltip: ""
}

WGGLifeWeaver: {
	DisplayName: Plantadora de árboles salvaje
	Tooltip: ""
}

Incinerator: {
	DisplayName: Incinerador eléctrico
	Tooltip:
		'''
		Consume energía para fundir objetos
		Haz clic derecho para abrir el panel de control
		Presiona Shift + clic derecho para depositar rápidamente los ítems o para agarrarlos
		Fundir objetos duplica la producción
		'''
}

Crusher: {
	DisplayName: Trituradora de mineral
	Tooltip:
		'''
		Consume energía para triturar mineral: se introducen dos unidades de mineral y se obtienen tres del mismo tipo.
		Haz clic derecho para abrir el panel de control.
		Haz Mayús + clic derecho para depositar rápidamente el mineral o recoger el resultado de la trituración
		Si introduces el resultado en un incinerador, el mismo mineral te dará la mitad más de lingotes
		'''
}

