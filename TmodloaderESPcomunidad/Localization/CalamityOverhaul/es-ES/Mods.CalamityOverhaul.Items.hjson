RMagicConch: {
	DontUseMagicConch: Te está observando una criatura poderosa...

	RMagicConch: {
		DontUseMagicConch: Te está observando una criatura poderosa...
		DisplayName: Caracola mágica
		Tooltip: Escucha con atención y oirás el mar
	}
}

TestItem: {
	DisplayName: Ítem de pruebas
	Tooltip: ""
}

ScrapBeacon: {
	DisplayName: Baliza de chatarra
	Tooltip:
		'''
		Invoca al comandante de la chatarra por la noche
		"La chatarra siempre obedece a su capataz"
		'''
}

Deepclaw: {
	DisplayName: Garra profunda
	Tooltip:
		'''
		Invoca una langosta abisal para que luche a tu lado
		La langosta se abalanza sobre los enemigos con golpes secos de sus pinzas
		Cada tres golpes de pinza, se echa hacia atrás y detona un chasquido por cavitación
		El chasquido inflige daño de área y arrastra a los enemigos hacia su centro
		"Lo que vive en las profundidades nunca afloja su agarre"
		'''
}

SeaShrimpShell: {
	DisplayName: Caparzón de camarón cristalino
	Tooltip:
		'''
		Un caparazón endurecido que deja atrás el camarón cristalino abisal
		Es un material esencial para la serie de armas abisales
		"Acércalo a la oreja y aún se oye el murmullo de la fosa"
		'''
}

DeepcrystalWarhelm: {
	DisplayName: Yelmo bélico de cristal abisal
	Tooltip:
		'''
		Aumenta un 18% al daño cuerpo a cuerpo un 10% la probabilidad de golpe crítico cuerpo a cuerpo
		Aumenta un 18% la velocidad de ataque cuerpo a cuerpo
		"El peso del caparazón se te clavó en los huesos"
		'''
	SetBonus:
		'''
		Aumenta el daño cuerpo a cuerpo un 18%, pero el daño recibido se incrementa un 10%
		Al golpear a los enemigos, se condensan las burbujas que orbitan a tu alrededor; cuando llegan a cinco, todas se colapsan 
		y detonan una potente ráfaga de cavitación sobre el objetivo
		Al recibir un golpe, tus burbujas condensadas se rompen y respondes con una contraráfaga de cavitación (enfriamiento corto)
		Mientras estés mojado, las burbujas se condensan más rápido y detonan con mayor fuerza.
		'''
}

DeepcrystalVisor: {
	DisplayName: Visera de cristal abisal
	Tooltip:
		'''
		Aumenta un 18% el daño a distancia y un 10% la probabilidad de golpe crítico a distancia
		Hay un 30% de probabilidad de no consumir munición
		"A través de la lente de cristal, la trinchera brilla como si fuera de día"
		'''
	SetBonus:
		'''
		Aumenta el daño a distancia en un 18%, pero el daño recibido se incrementa en un 10%
		Al golpear a los enemigos, se condensan burbujas que giran en órbita; cuando llegan a cinco, todas se colapsan formando un chorro de agua perforante dirigido hacia el objetivo
		Al recibir un impacto, tus burbujas condensadas se rompen y responden con una contragolpe de cavitación (enfriamiento corto)
		Mientras estés mojado, las burbujas se condensan más rápido y detonan con mayor fuerza
		'''
}

DeepcrystalCrown: {
	DisplayName: Corona de cristal abisal
	Tooltip:
		'''
		Aumenta el daño mágico en un 18% y la probabilidad de golpe crítico mágico en un 10%
		Reduce el coste de maná en un 18%
		"El murmullo del mar queda sellado en los cristales"
		'''
	SetBonus:
		'''
		Aumenta el daño mágico en un 18%, pero el daño recibido se incrementa en un 10%
		Al golpear a los enemigos, se condensan burbujas que orbitan a tu alrededor; cuando llegan a cinco, todas se colapsan y lanzan tres rayos de agua guiados contra el objetivo
		Si recibes un golpe, tus burbujas condensadas se rompen y respondes con una contrataque de cavitación (enfriamiento corto)
		Mientras estés mojado, las burbujas se condensan más rápido y detonan con más fuerza
		'''
}

DeepcrystalFeelers: {
	DisplayName: Sensores de cristal abisal
	Tooltip:
		'''
		Aumento un 18% al daño de las invocaciones
		Aumenta el número máximo de súbditos en 2
		"Las antenas saben dónde se esconde la presa antes que tú"
		'''
	SetBonus:
		'''
		Aumenta el daño de las invocaciones un 18%, pero el daño recibido se incrementa un 10%
		Al golpear a los enemigos, se condensan las burbujas que orbitan; cuando llegan a cinco, todas se colapsan, liberando cuatro burbujas guiadas que persiguen al objetivo
		Al recibir un impacto, tus burbujas condensadas se rompen y responden con una contrataque de cavitación (enfriamiento corto)
		Mientras estés mojado, las burbujas se condensan más rápido y detonan con mayor fuerza
		'''
}

DeepcrystalBreastplate: {
	DisplayName: Coraza de cristal abisal
	Tooltip:
		'''
		Aumenta dun 10% el daño y un 6% la probabilidad de golpe crítico
		"La concha se cambió por la espada, la sangre se cambió por la marea"
		'''
}

DeepcrystalGreaves: {
	DisplayName: Grebas de cristal abisal
	Tooltip:
		'''
		Aumenta un 15% la velocidad de movimiento, que se incrementa aún más cuando estás mojado
		Te mueves con total libertad por el agua
		"Camina sobre las olas como si fueran tierra firme"
		'''
}

SeaShrimpRelic: {
	DisplayName: Reliquia del Camarón de cristal abisal
	Tooltip: ""
}

SeaShrimpSummonItem: {
	DisplayName: Cebo de gambas cristalizadas
	Tooltip:
		'''
		Al usarla en el océano, invoca al Camarón de cristal abisal
		"El cebo que se hunde nunca vuelve. Pero algo más sí lo hace"
		'''
}

SeaShrimpTreasureBag: {
	DisplayName: Bolsa del tesoro (Camarón de cristal abisal)
	Tooltip: "{$CommonItemTooltip.RightClickToOpen}"
}

SeaShrimpTestItem: {
	DisplayName: Jaula de observación de gambas
	Tooltip: Ítem de desarrollador: invoca al camarón de cristal abisal en cualquier lugar
}

BssBloomBud: {
	DisplayName: Capullo espinoso
	Tooltip:
		'''
		Al usarla en la superficie del desierto, invoca a la Serpiente de arena floreciente
		"La raíz de las dunas se vuelve voraz cuando florece"
		'''
}

FssFesterBud: {
	DisplayName: Capullo podrido
	Tooltip:
		'''
		Al usarla en la superficie del desierto, invoca a la Serpiente de arena podrida
		"El brote nunca murió. Aprendió a pudrirse"
		'''
}

BloomCaller: {
	DisplayName: Clamor del florecer
	Tooltip:
		'''
		Toca el cuerno para llamar a un brote de flor silvestre para que luche a tu lado
		El brote lanza espinas punzantes contra los enemigos
		Cada dos lanzamientos, el tercer ataque se convierte en un golpe corporal que gira formando un círculo de pétalos
		"El cuerno no da órdenes. Riega"
		'''
}
