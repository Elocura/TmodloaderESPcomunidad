SHPCModTooltipDraw: {
	InstalledHeader: MÓDULOS INSTALADOS
	NoModules: NINGUNO
	BonusHeader: TOTAL DE BONIFICACIONES DE MÓDULOS
}

MoldProcessingTable: {
	DisplayName: Mesa de procesamiento de moldes
	Tooltip:
		'''
		Haz clic derecho para abrir la tabla de procesamiento de moldes
		Desmontar: funde las piezas de modificación sobrantes y las convierte en fragmentos
		Refundir: consume fragmentos para producir nuevos moldes; puede fijarse en objetivos específicos en el índice
		'''
}

ElementWhip: {
	DisplayName: Látigo elemental
	Tooltip:
		'''
		{$CommonItemTooltip.Whips}
		Incendia a los enemigos con fuego elemental
		"La esencia primordial de Terra impregna el mundo junto con los elementos del cosmos"
		'''
}

AzureDragonRage: {
	DisplayName: Ira del dragón celeste
	Tooltip:
		'''
		{$CommonItemTooltip.Whips}
		Desprende un intenso aroma a hierba fresca
		'''
}

BleedingScourge: {
	DisplayName: Azote sangrante
	Tooltip: Marca a los enemigos para acabar con ellos al impactar y desata una lluvia de sangre
}

GhostFireWhip: {
	DisplayName: Látigo de fuego fantasmal
	Tooltip:
		'''
		{$CommonItemTooltip.Whips}
		Un látigo extremadamente largo tejido con la furia de los espíritus inquietos de la mazmorra
		[c/d4bc75:La pura pasión irradia desde las profundidades del infierno, instándote a encontrar a quien te hizo daño]
		'''
}

FoodStallChair: {
	DisplayName: Silla para puesto de comida
	Tooltip: I AM THE CHAIR THAT IS APPROACHING!
}

NeutronStarIngot: {
	DisplayName: Lingote de estrella de neutrones
	Tooltip: El peso de todas las cosas, reunido en la yema de tus dedos
}

BloodAltar: {
	DisplayName: Altar de sangre
	Tooltip:
		'''
		Clic derecho sobre el altar con una lágrima de sangre para invocar a la Luna de sangre
		Recoge automáticamente lás lágrimas de sangre los orbes de sangre caídos por todo el mundo y las almacena en el almacenamieto más cercano.
		"Deja que el mundo se tiña de carmesí."
		'''
}

StarMyriadChanges: {
	DisplayName: Estrella de los cambios sin fin
	Tooltip: ¡Alabado sea el Dios del cambio!
}

TerminusOver: {
	DisplayName: El toque final
	Tooltip: La batalla final aguarda, pero hay un precio que pagar.
}

PestilenceIngot: {
	DisplayName: Lingote de pestilencia
	Tooltip: Huele a caramelo ácido de manzana
}

ReminiscenceBreastplate: {
	DisplayName: Coraza de la reminiscencia
	Tooltip: Te recuerda el viaje que has realizado y lo lejos que has llegado.
}

MurasamaMould: {
	DisplayName: Molde dorado sanguíneo
	Tooltip: Un material que parece provenir de otro plano de la existencia. Es cálido y electrizante al tacto, y parece buscar un derramamiento de sangre.
}

OverhaulTheBibleBook: {
	DisplayName: La biblia de Overhaul
	Tooltip: Úsalo para ver tutoriales relacionados con Calamity Overhaul... Es posible que más adelante se añadan más
}

HalibutItem: {
	DisplayName: Halibut
	Tooltip: ""
}

HalibutPilotChart: {
	DisplayName: Carta de navegación
	Tooltip:
		'''
		Úsalo para abrir la guía de Halibut desde el principio, o vuelve a utilizarlo a mitad de la guía para cerrarla
		Se queda contigo si rechazas la guía de inicio; la guía no se consume y se puede volver a utilizar
		'''
	NeedFish: Halibut no está en tu bolsa, por lo que la carta no sirve para orientarse
	HoldFish: La carta está desplegada; coge el Halibut y comienza la guía
	Closed: La guía está guardada; vuelve a usar la carta para reabrirla
	NotNow: En este momento hay otra cosa ocupando el lugar
}

OnikiriItem: {
	DisplayName: Onikiri
	Tooltip:
		'''
		Mantén pulsado clic izquierdo para ejecutar el combo Desgarro carmesí de cinco golpes; cada golpe acertado aumenta la "Postura"
		Pulsa [DASH] para gastar "Vigor" en un "Empuje de Kamui"
		La tecla de expansión del dominio despliega o pliega el dominio Oni; la tecla de cambio de dominio alterna entre Omote y Ura
		En Omote, mantén pulsado [SAKURA] para desplazarte como pétalos de sakura (también se puede encadenar con una carrera); suelta el botón o agota la energía para reaparecer en el mismo lugar
		En Ura, apunta a un enemigo y haz clic izquierdo para desmembrar su cuerpo verdadero; el portador sufrirá entonces un contragolpe del 25% de su vida máxima
		En el breve intervalo tras finalizar un dash o un Vuelo Sakura, haz clic izquierdo para realizar un "Golpe Zanshin"
		Con la Postura a la mitad o más, pulsa [DASH] de nuevo en mitad de un dash o en el segundo siguiente a su finalización para encadenar un dash extra
		Tras un dash de ejecución, haz clic izquierdo para realizar un Destello Aniquilador; con la postura al máximo, un dash de ejecución que atraviese a su objetivo desata directamente un Tajo Final
		Con la postura al máximo, pulsa [EXECUTE] para fijar automáticamente el objetivo, lanzarte y desatar un "Tajo Final"; si no hay ningún objetivo, el ataque se dirige hacia el cursor.
		El dash de ejecución no consume Vigor; una que nunca se convierte no pierde nada.
		[Lang4]
		legend_Text
		'''
}

KikasaItem: {
	DisplayName: Kikasa
	Tooltip:
		'''
		Si mantienes pulsado atacar, Kikasa se queda detrás de tu hombro y se inclina para rociar tinta sobre los enemigos cercanos cuando no estás atacando
		Mantén pulsado clic izquierdo para mantener el paraguas en alto, lanzando una lluvia de tinta autoguiada al ritmo de un compás constante
		Mantén pulsado clic derecho para cargar tinta boca abajo; suéltalo para verter un torrente de tinta
		Mientras lo mantienes pulsado, pulsa "Expansión de dominio" para elevar el Lago de Sangre; pulsa de nuevo para cerrarlo
		Una vez que el agua te llegue a los pies, mantén pulsado un objeto y pulsa "Sumergirse en el lago" para guardarlo; recupéralo en el Corazón del Lago
		Pulsa la misma tecla apuntando a un enemigo para ahogarlo; un jefe ahogado deja tras de sí una sombra hundida.
		Haz clic en la campana de viento de la esquina inferior izquierda para abrir el Corazón del lago y colocar sombras en tres ranuras; lucharán por ti como súbditos
		Mantén pulsada la tecla de la rueda para llamar o retirar a las sombras una a una; cuantas menos haya en el campo de batalla, más fuerte golpeará cada una
		El sector de llama dorada de la rueda enciende el fuego fantasma, que se propaga a lo largo de la orilla y abrasa a los enemigos que toca
		Cuando el nivel de agua esté al máximo, pulsa "Dar la vuelta al lago" (por defecto, botón central del ratón) para alternar entre el «Lago de Sangre» y la «Lluvia Fantasma»
		Los enemigos abatidos bajo la lluvia fantasma resucitan como súbditos-paraguas que luchan a tu lado
		En la lluvia fantasma con el nivel de agua al máximo, pulsa "Reinicio automático" para rebobinar el lugar cercano unos segundos, recargando tu vida y eliminando los efectos negativos
		Con el nivel de agua al máximo, mantén pulsado "Dar la vuelta al lago" para sumergirte en el "Sueño fantasmal": allí los enemigos están indefensos y no pueden existir proyectiles
		Los objetos quedan sellados en el sueño; mantén pulsado clic izquierdo para soltar a los sabuesos y vuelve a pulsar la misma tecla para despertar
		Pulsa «Teletransporte de dominio» para deslizarte a través de un charco de agua hasta tu cursor; serás más rápido dentro del Lago de Sangre
		Un mayor número de ranuras de súbditos acelera el ritmo de la lluvia, añade más gotas y acelera la carga
		4 ranuras: cada latido lanza una gota extra a un segundo objetivo
		7 ranuras: cada cuarto latido lanza todas las gotas a la vez
		10 ranuras: las gotas pesadas dejan charcos de tinta ardiente; un torrente completo estalla en tres géiseres de tinta
		[Lang4]
		legend_Text
		"Bajo el paraguas no llueve, solo se oye el sonido del agua"
		'''
}

