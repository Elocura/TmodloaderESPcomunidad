OniRainWorld: {
	OniRainWorldSystem: {
		InteractHint: "[Clic derecho] Entra en la lluvia con el paraguas"
		DescendHint: "[Clic derecho] Entra en la lluvia profunda con el paraguas"
		GrabHint: "[Clic derecho] Agarra el paraguas"
		OniDeathReason: "{0} fue arrastrado bajo la lluvia por esa cosa que había debajo del paraguas"
	}
}

GodSmithMagicConduit: {
	GsHeatRay.Desc:
		'''
		Reforja: Mantén pulsado para mantener un rayo abrasador; el calor blanco ensancha el haz y detonan en la quinta capa
		Haz clic derecho para liberar todo el calor en forma de lanza
		'''
	GsMedusaHead.Desc:
		'''
		Reforja: Mantén pulsado para lanzar un cono petrificante; las acumulaciones de Marca de piedra petrifican momentáneamente, y el Calor blanco lo reduce a un resplandor concentrado
		Haz clic derecho para liberar todo el calor en forma de destello de piedra en ocho direcciones
		'''

	GsSoulDrain: {
		Desc:
			'''
			Reforja: un conducto de sangría inmoviliza hasta tres enemigos y les drena la sangre a la vez; el calor blanco proporciona recuperación de vida verdadera
			Haz clic derecho para detonar la sangre almacenada en el cursor; la sobrecarga se vuelve en tu contra y te resta 10 puntos de vida
			'''
		BloodPriceDeath: "{0} se vació a través de su propio conducto de drenaje"
	}
}

GodSmithMagicMorph: {
	GsClingerStaff.Desc:
		'''
		Reforja: Mantén pulsado brevemente clic derecho para colocar una pared de enredaderas malditas de 260 píxeles a lo largo de tu línea de mira, en cualquier ángulo
		Si la sobrecargas, en ambos extremos brotarán paredes verticales
		'''
	GsCrimsonRod.Desc:
		'''
		Reforja: La nube de sangre se convierte en un campo de lluvia sacrificial
		Las gotas de lluvia acumulan Erosión de sangre; cuando se alcanzan tres acumulaciones, estas estallan y los aliados que se encuentran en su interior se curan lentamente
		Al hacer clic derecho, el campo se desplaza hasta tu cursor a cambio de una pequeña cantidad de maná
		'''
	GsCrystalSerpent.Desc:
		'''
		Reforja: Los fragmentos estallan y rebotan
		Mantén pulsado clic derecho para cargar; suelta una enorme pitón de cristal que se desliza en forma de onda sinusoidal y estalla en una lluvia de fragmentos aún más intensa
		'''
	GsCrystalStorm.Desc:
		'''
		Reforja: mantén clic derecho para cargar un vórtice de refracción en el cursor
		Los fragmentos de cristal que lo atraviesan se refractan, ganando velocidad y un punto adicional de perforación
		'''
	GsFlamelash.Desc:
		'''
		Reforja: el vuelo autoguiado es un 25% más rápido
		Mantén pulsado clic derecho para cargar; al soltarlo, lanzarás una serpiente de fuego cuyas espiras siguen tu trayectoria y prenden fuego a los enemigos
		'''
	GsMagicMissile.Desc:
		'''
		Reforja: el vuelo autoguiado es un 25% más rápido
		Mantén pulsado clic derecho para cargar; al soltarlo, lanzarás una ráfaga triple que seguirá a tu cursor en formación
		'''
	GsMeteorStaff.Desc:
		'''
		Reforja: meteors leave a scorching crater where they land.
		Hold right click to charge; release to call a five-meteor barrage across the cursor
		'''
	GsNimbusRod.Desc:
		'''
		Reforja: con ambas nubes en el horizonte, un corredor de lluvia las une, empapando y ralentizando a los enemigos que se encuentran en su interior
		Al hacer clic derecho se alterna entre lluvia templada y tormenta eléctrica; la tormenta lanza rayos a lo largo del corredor
		'''
	GsRainbowGun.Desc:
		'''
		Reforja: Mientras el arcoíris permanezca activo, los proyectiles que se encuentren dentro de la banda situada sobre el arco infligirán un 8% más de daño, y el arco emitirá pulsos prismáticos autoguiados
		Al hacer clic derecho, se retira el arcoíris y se devuelve la mitad del maná
		'''
	GsRainbowRod.Desc:
		'''
		Reforja: los rayos guiados se fragmentan en astillas prismáticas al impactar
		Mantén pulsado clic derecho para cargar; suéltalo para levantar un puente arcoíris que daña a los enemigos que lo cruzan y acelera a los aliados que se encuentran sobre él
		'''
	GsSkyFracture.Desc:
		'''
		Reforja: las cuchillas dejan un destello de fractura al lanzarse
		Mantén pulsado clic derecho para cargar; suéltalo para abrir tres grietas alrededor del cursor que lanzan cuchillas convergentes.
		'''
}

GodSmithSummonWhips: {
	GsCoolWhip.Desc: 
		'''
		Reforja: los copos de nieve que surgen de los golpes al compás crecen y atraviesan a un enemigo más; 4 cicatrices de escarcha sellan la marca, 
		y el siguiente golpe al compás la hace florecer en una explosión de escarcha que inflige Congelación.
		'''
	GsDarkHarvest.Desc:
		'''
		Reforja: los saltos de energía oscura se propagan a los enemigos cercanos por cada cicatriz de cosecha que tenga la víctima; 4 cicatrices sellan la marca, 
		y el siguiente golpe al compás cosecha su alma, segando instantáneamente a todos los enemigos marcados en el campo de batalla
		'''
	GsDurendal.Desc: 
		'''
		Reforja: tras una cadena de golpes al compás, cada golpe posterior al compás lanza una onda de espada dorada desde la punta del látigo; 
		5 cicatrices sellan la marca, y el siguiente golpe al compás invoca una espada del veredicto sagrado.
		'''
	GsFirecracker.Desc: 
		'''
		Reforja: mantienne la detoanción normal de los súbditos; los latigazos al compás cargan mechas en el objetivo, 
		y al alcanzar 3 mechas, la siguiente explosión desencadena 3 explosiones adicionales escalonadas.
		'''
	GsKaleidoscope.Desc: 
		'''
		Reforja: la ventana rítmica es más ajustada, y un golpe fallido reinicia todo el tempo; cada cicatriz ilumina un color del prisma, y al alcanzar los cinco colores, 
		el siguiente golpe rítmico despliega un caleidoscopio de cinco cortes prismáticos, lo que expone a la víctima a posibilidades de crítico garantizadas durante 5 segundos
		'''
	GsLeatherWhip.Desc: 
		'''
		Reforja: tras una cadena de golpes al compás, aumenta el tempo y la velocidad del látigo; tres marcas de lñátigo sellan el objetivo,
		y el siguiente golpe al compás lo rompe infligiendo un 200% de daño, tras lo cual tus súbditos atacan al objetivo durante 2 segundos
		'''
	GsMorningStar.Desc: 
		'''
		Reforja: cada golpe al compás provoca un temblor en la punta del látigo; tres cicatrices sellan la marca, y 
		el siguiente golpe al compás hace que una maza de estrella fugaz caiga sobre la cabeza del objetivo
		'''
	GsSnapthorn.Desc: 
		'''
		Reforja: los golpes al compás hacen crecer cicatrices de espinas en la presa; 4 cicatrices sellan la marca, 
		y el siguiente golpe al compás la hace estallar en una explosión de espinas más 4 púas venenosas autoguiadas
		'''
	GsSpinalTap.Desc: 
		'''
		Reforja: un barrido al compás que alcanza a 3 enemigos hace que un eco óseo resuene en todo lo que no haya alcanzado; 
		4 cicatrices sellan la marca, y el siguiente golpe al compás hace brotar una aguja ósea desde abajo
		'''
}

GodSmithAcc.GodSmithSharkToothNecklace.EffectDesc:
	'''
	El daño aumenta un 4%
	Los golpes desgarran la piel del objetivo, lo que otorga Desgarro: obtienes +1 de penetración de armadura por acumulación, hasta un máximo de 8 acumulaciones y dura 3s
	'''

