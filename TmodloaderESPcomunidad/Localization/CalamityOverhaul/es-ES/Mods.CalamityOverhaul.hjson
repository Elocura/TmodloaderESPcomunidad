	AetherTorch: Antorcha del fulgor
	ForestTree: Árbol del bosque
	EbonwoodTree: Árbol de madera de ébano
	RichMahoganyTree: Árbol de caoba rica
	PearlwoodTree: Árbol de madera de perlada
	BorealTree: Árbol boreal
	ShadewoodTree: Árbol de madera sombría
	IronAnvil: Yunque de hierro
	LeadAnvil: Yunque de plomo
	CrimsonAltar: Altar carmesí
	Tile192: Hojas de madera viviente
	Tile187: Maleza
	Tile352: Espinas
}

OniRainWorld: {
	OniRainWorldSystem: {
		InteractHint: "[Clic derecho] Entra en la lluvia con el paraguas"
		DescendHint: "[Clic derecho] Entra en la lluvia profunda con el paraguas"
		GrabHint: "[Clic derecho] Agarra el paraguas"
		OniDeathReason: "{0} fue arrastrado bajo la lluvia por esa cosa que había debajo del paraguas"
	}
}

GodSmithGunsEarly: {
	GsFlintlockPistol.Desc:
		'''
		Reforja: Regarga dos recámaras; el segundo disparo sale un 40% más rápido;
		la última recámara dispara una doble bala en forma de V a partir de una sola bala, con el efecto de retroceso duplicado.
		Haz clic botón derecho para recargar antes de tiempo; si aciertas en el punto óptimo, obtendrás un +25% en el siguiente disparo.
		'''

	GsGunsEarlyPlayer: {
		Perfect: ¡Recarga perfecta!
		HighNoon: ¡Mediodía!
	}

	GsMusket.Desc:
		'''
		Reforja: un auténtico avancarga; cada bala es un proyectil perforador que vuela más rápido y atraviesa a un enemigo más
		Recarga en tres pasos: verter, apisonar, encender. Haz clic derecho durante el paso de apisonado para obtener un +30% de daño y perforación adicional
		'''
	GsQuadBarrelShotgun.Desc:
		'''
		Reforja: dispara un cañón en una ráfaga rápida de cuatro disparos;
		el cuarto cañón retumba de golpe con 8 perdigones y te lanza hacia atrás
		Apunta hacia abajo para realizar un salto cohete. Haz clic derecho para abrir la recámara y recargar; si aciertas en el punto óptimo, obtendrás 2 perdigones más.
		'''
	GsRevolver.Desc:
		'''
		Reforja: Tiene un cilindro de seis balas; la última recámara siempre inflige un 40% más de daño.
		Mantén pulsado clic derecho para girar el tambor: recargarás al instante entre 1 y 6 balas al azar.
		Si sacas exactamente seis, el siguiente disparo será Mediodía: Harás el doble daño, y tendrás doble retroceso.
		'''
}

GodSmithGunsHard: {
	GsCandyCornRifle: {
		Desc:
			'''
			Reforja: haz clic derecho para cambiar de recubrimiento
			Lluvia de caramelos añade un dulce arco descendente a la ráfaga normal
			Explosión pegajosa dispara tres balas de gominola; los impactos acumulan una Capa de azúcar, lo que ralentiza al objetivo y endulza tus disparos
			'''
		ModeCandyRain: Lluvia de caramelos
		ModeStickyBurst: Explosión pegajosa
	}

	GsClockworkAssaultRifle: {
		Desc:
			'''
			Reforja: haz clic derecho para cambiar el modo de disparo
			Explosión de engranajes mantiene la clásica ráfaga de tres disparos, pero el tercero tiene un 30% más de potencia
			Sobrecarga sacrifica calor a cambio de un 40% más de velocidad; si se calienta demasiado, los engranajes se atascan
			'''
		ModeGearBurst: Explosión de engranaje
		ModeOverclock: Sobrecarga
	}

	GsGatligator: {
		Desc:
			'''
			Reforja: haz clic derecho para cambiar el temple
			Disturbio pantanoso descontrola la ráfaga, pero cada ronda se salta un disparo tras un bloqueo
			Tirada de la muerte dispara ráfagas concisas de cuatro disparos; el último provoca una herida sangrante
			'''
		ModeSwampRiot: Disturbio pantanoso
		ModeDeathRoll: Tirada de la muerte
	}

	GsMegashark: {
		Desc:
			'''
			Reforja: haz clic derecho para cambiar de mordisco
			Frenesí alimenticio aumenta la cadencia de disparo cuanto más tiempo mantengas pulsado el gatillo; Mordedura de tiburón reduce la dispersión y aumenta la fuerza del mordisco en un 15%
			Asesta 50 golpes sangrantes: durante 3 segundos, cada golpe deja una herida sangrante
			'''
		ModeFrenzy: Frenesí alimenticio
		ModeSharkBite: Mordedura de tiburón
	}

	GsOnyxBlaster: {
		Desc:
			'''
			Reforja: haz clic derecho para cambiar de carga
			Volea de ónice deja una mancha oscura persistente en el punto de la explosión que arrastra a los enemigos hacia el interior
			Carga de singularidad se dispara más lentamente, pero lanza un enorme orbe de ónix: su explosión atrae todo hacia el núcleo y dispersa tus balas en forma de anillo
			'''
		ModeVolley: Volea de ónice
		ModeSingularity: Carga de singularidad
	}

	GsSDMG: {
		Desc:
			'''
			Reforja: haz clic derecho para alternar entre los tres modos de disparo
			Marea del delfín conserva su velocidad legendaria; Explosión sónica marca el tercer impacto, de modo que los disparos a distancia de todo el equipo penetran un 8% más
			Guía orbital se dirige suavemente hacia el objetivo, con un 10% menos de potencia
			'''
		ModeDolphinTide: Marea del delfín
		ModeSonarBurst: Explosión sónica
		ModeOrbitalGuide: Guía orbital
	}

	GsShotgun: {
		Desc:
			'''
			Reforja: haz clic derecho para cambiar el obturador
			El Obutador amplio dispara seis perdigones caídos en un amplio abanico; si se consiguen tres impactos en una misma ráfaga, se desata una lluvia de plomo sobre el objetivo
			El Obturador estrecho dispara tres perdigones pesados en línea recta; si los tres impactan en un mismo enemigo, lo corroen, infligiéndole un 12% más de daño
			Cada vez que se aprieta el gatillo se gasta un cartucho
			'''
		ModeWideBore: Obutador amplio
		ModeTightChoke: Obturador estrecho
	}

	GsSniperRifle: {
		Desc:
			'''
			Refoja: pulsa clic derecho para cambiar de modo de disparo; mantén pulsado para apuntar con la mira
			El modo Francodirador traza una línea de puntería penetrante; quédate quieto para estabilizar la respiración; un disparo estabilizado siempre es crítico
			El modo Rápido sacrifica potencia a cambio de velocidad
			'''
		ModeSnipe: Francodirador
		ModeRapid: Modo rápido
	}

	GsTacticalShotgun: {
		Desc:
			'''
			Reforja: haz clic derecho para cambiar de postura
			Aficionado a la táctica marca el cono de dispersión para que sepas exactamente qué área cubren los seis perdigones
			Bomba triple carga tres cartuchos rápidamente y luego obliga a un descanso; la primera recarga lanza una onda de choque que abre una brecha, y los enemigos que quedan expuestos reciben un 10% más de daño durante un segundo
			'''
		ModeFan: Aficionado a la táctica
		ModeTriplePump: Bomba triple
	}

	GsUzi: {
		Desc:
			'''
			Reforja: haz clic derecho para cambiar de empuñadura
			El modo En jarras dispara un 30% más rápido con un patrón disperso; el modo Ráfaga dispara ráfagas de tres balas muy precisas que dan de lleno en el blanco
			Cada cuarta bala (la que cierra la ráfaga) se conviernte en un trazador ámbar: los impactos del trazador iluminan el objetivo, 
			y las balas de tu Uzi penetran un 10% más profundamente en los objetivos iluminados
			'''
		ModeAkimbo: En jarras
		ModeBurst: Ráfaga
	}

	GsVenusMagnum: {
		Desc:
			'''
			Reforja: haz clic derecho para activar o desactivar el efecto floración
			Enfoque máximo: tras un golpe crítico, la siguiente bala atraviesa a un enemigo más; la línea de puntería se ilumina durante un tiempo
			Triplete de pétalos dispara tres pétalos en abanico con una sola bala
			'''
		ModeFocus: Enfoque máximo
		ModeTriplet: Petal Triplet
	}

	GsVortexBeater: {
		Desc:
			'''
			Reforja: haz clic derecho para cambiar el flujo
			Barrido en vórtice conserva el disparo normal, y los cohetes se dirigen suavemente hacia el objetivo
			Cañón de vórtice dispara proyectiles cargados de forma lenta que infligen 2,6 veces más daño; los impactos fuertes abren un vórtice que atrae hacia sí a los enemigos
			'''
		ModeSweep: Barrido en vórtice
		ModeCannon: Cañón de vórtice
	}

	GsXenopopper: {
		Desc:
			'''
			Reforja: haz clic derecho para cambiar de burbuja
			Racimo hace estallar cinco burbujas que convergen y estallan en un fuego cruzado sobre el cursor
			Drenar hace flotar una gran burbuja hasta el cursor, la retiene y luego dispara las cinco municiones a la vez
			'''
		ModeCluster: Racimo
		ModeVacuum: Drenar
	}

	GsShotgunLeadRainProj.DisplayName: Lluvia de plomo
	GsTacticalShotgunBreachProj.DisplayName: Onda de asalto
	GsUziTracerProj.DisplayName: Trazadora de ámbar
}

GodSmithLaunchers: {
	GsElectrosphereLauncher: {
		Desc: Reforja: Si hay dos o más esferas, se unen mediante arcos tesla (hasta 3) ; al hacer clic derecho, se sobrecargarán: aplicando un 40% más de radio. Se descargan en 2 segundos
		TipOverload: ¡Sobrecarga!
	}

	GsGrenadeLauncher: {
		Desc: Reforja: Las granadas se adhieren a las paredes y a los enemigos ( en los enemigos aumenta el daño un 25%) ; ya no se activan automáticamente; haz clic derecho para detonarlas todas, hasta un máximo de 6
		TipDetonate: ¡Que les den a todos!
	}

	GsJackOLanternLauncher: {
		Desc: Reforja: Al hacer clic derecho, todas las calabazas rodantes esbozan una sonrisa y estallan; cada explosión deja un campo de velas que quema a quien se encuentre en ellas
		TipGrin: ¡Sonreíd todos a la vez!
	}

	GsNailGun: {
		Desc: Reforja: Las uñas se clavan en la carne (hasta 5 por víctima), y cada una de ellas hace que la víctima reciba un +3 % de daño ; al hacer clic derecho, se arrancan todas las uñas en una ráfaga de metralla
		TipExtract: ¡Arráncalos!
	}

	GsProximityMineLauncher: {
		Desc: Reforja: Las minas te muestran su radio de activación; al hacer cli derecho, se encadenan según el orden de colocación; las minas que permanecen inactivas durante 60s devuelven un cohete y se desactivan automáticamente
		TipChain: ¡Dominó!
		TipRecycle: Mina recuperada
	}

	GsRocketLauncher: {
		Desc: Reforja: Haz clic derecho para detonar todos los cohetes en vuelo; cada explosión aérea lanza 3 dardos perforantes hacia el cursor
		TipDetonate: ¡Explosión aérea!
	}

	GsSnowmanCannon: {
		Desc: Reforja: Al hacer clic derecho se cambia de portador. El enjambre teledirigido marca a las víctimas con un copo de nieve (+8%); la órbita Ventisca lanza cohetes hacia el cielo para que se lancen en picado sobre el cursor
		ModeHoming: Vehículo: enjambre perseguidor
		ModeOrbital: Vehículo: órbita de ventisca
	}

	GsStarCannon: {
		Desc: Reforja: Al hacer clic derecho se invierte la trayectoria. Disparo directo o Lluvia de estrellas: las estrellas se elevan hacia el cielo y caen a modo de lluvia alrededor del cursor, esparciendo polvo de estrellas al impactar
		ModeDirect: Trayectoria: Directa
		ModeStarfall: Trayectoria: Lluvia de estrellas
	}

	GsStynger: {
		Desc: Reforja: Al hacer clic derecho, se alterna los modo. Impacto detona al impactar; Alcance provoca una explosión aérea a la distancia del cursor con un cono de metralla concentrado; Rebote rebota una vez antes de activarse
		ModeImpact: Espoleta: impacto
		ModeRange: Espoleta: explosión a distancia
		ModeRicochet: Espoleta: rebote
	}
}

GodSmithMagicConduit: {
	GsHeatRay.Desc:
		'''
		Reforja: Mantén pulsado para mantener un rayo abrasador; el calor blanco ensancha el haz y detonan en la quinta capa
		Haz clic derecho para liberar todo el calor en forma de lanza
		'''
	GsMedusaHead.Desc:
		'''
		Reforja: Mantén pulsado para lanzar un cono petrificante; las acumulaciones de Marca de piedra petrifican momentáneamente, y el Calor blanco lo reduce a un resplandor concentrado
		Haz clic derecho para liberar todo el calor en forma de destello de piedra en ocho direcciones
		'''

	GsSoulDrain: {
		Desc:
			'''
			Reforja: un conducto de sangría inmoviliza hasta tres enemigos y les drena la sangre a la vez; el calor blanco proporciona recuperación de vida verdadera
			Haz clic derecho para detonar la sangre almacenada en el cursor; la sobrecarga se vuelve en tu contra y te resta 10 puntos de vida
			'''
		BloodPriceDeath: "{0} se vació a través de su propio conducto de drenaje"
	}
}

GodSmithMagicMorph: {
	GsClingerStaff.Desc:
		'''
		Reforja: Mantén pulsado brevemente clic derecho para colocar una pared de enredaderas malditas de 260 píxeles a lo largo de tu línea de mira, en cualquier ángulo
		Si la sobrecargas, en ambos extremos brotarán paredes verticales
		'''
	GsCrimsonRod.Desc:
		'''
		Reforja: La nube de sangre se convierte en un campo de lluvia sacrificial
		Las gotas de lluvia acumulan Erosión de sangre; cuando se alcanzan tres acumulaciones, estas estallan y los aliados que se encuentran en su interior se curan lentamente
		Al hacer clic derecho, el campo se desplaza hasta tu cursor a cambio de una pequeña cantidad de maná
		'''
	GsCrystalSerpent.Desc:
		'''
		Reforja: Los fragmentos estallan y rebotan
		Mantén pulsado clic derecho para cargar; suelta una enorme pitón de cristal que se desliza en forma de onda sinusoidal y estalla en una lluvia de fragmentos aún más intensa
		'''
	GsCrystalStorm.Desc:
		'''
		Reforja: mantén clic derecho para cargar un vórtice de refracción en el cursor
		Los fragmentos de cristal que lo atraviesan se refractan, ganando velocidad y un punto adicional de perforación
		'''
	GsFlamelash.Desc:
		'''
		Reforja: el vuelo autoguiado es un 25% más rápido
		Mantén pulsado clic derecho para cargar; al soltarlo, lanzarás una serpiente de fuego cuyas espiras siguen tu trayectoria y prenden fuego a los enemigos
		'''
	GsMagicMissile.Desc:
		'''
		Reforja: el vuelo autoguiado es un 25% más rápido
		Mantén pulsado clic derecho para cargar; al soltarlo, lanzarás una ráfaga triple que seguirá a tu cursor en formación
		'''
	GsMeteorStaff.Desc:
		'''
		Reforja: meteors leave a scorching crater where they land.
		Hold right click to charge; release to call a five-meteor barrage across the cursor
		'''
	GsNimbusRod.Desc:
		'''
		Reforja: con ambas nubes en el horizonte, un corredor de lluvia las une, empapando y ralentizando a los enemigos que se encuentran en su interior
		Al hacer clic derecho se alterna entre lluvia templada y tormenta eléctrica; la tormenta lanza rayos a lo largo del corredor
		'''
	GsRainbowGun.Desc:
		'''
		Reforja: Mientras el arcoíris permanezca activo, los proyectiles que se encuentren dentro de la banda situada sobre el arco infligirán un 8% más de daño, y el arco emitirá pulsos prismáticos autoguiados
		Al hacer clic derecho, se retira el arcoíris y se devuelve la mitad del maná
		'''
	GsRainbowRod.Desc:
		'''
		Reforja: los rayos guiados se fragmentan en astillas prismáticas al impactar
		Mantén pulsado clic derecho para cargar; suéltalo para levantar un puente arcoíris que daña a los enemigos que lo cruzan y acelera a los aliados que se encuentran sobre él
		'''
	GsSkyFracture.Desc:
		'''
		Reforja: las cuchillas dejan un destello de fractura al lanzarse
		Mantén pulsado clic derecho para cargar; suéltalo para abrir tres grietas alrededor del cursor que lanzan cuchillas convergentes.
		'''
}

GodSmithSummonWhips: {
	GsCoolWhip.Desc: 
		'''
		Reforja: los copos de nieve que surgen de los golpes al compás crecen y atraviesan a un enemigo más; 4 cicatrices de escarcha sellan la marca, 
		y el siguiente golpe al compás la hace florecer en una explosión de escarcha que inflige Congelación.
		'''
	GsDarkHarvest.Desc:
		'''
		Reforja: los saltos de energía oscura se propagan a los enemigos cercanos por cada cicatriz de cosecha que tenga la víctima; 4 cicatrices sellan la marca, 
		y el siguiente golpe al compás cosecha su alma, segando instantáneamente a todos los enemigos marcados en el campo de batalla
		'''
	GsDurendal.Desc: 
		'''
		Reforja: tras una cadena de golpes al compás, cada golpe posterior al compás lanza una onda de espada dorada desde la punta del látigo; 
		5 cicatrices sellan la marca, y el siguiente golpe al compás invoca una espada del veredicto sagrado.
		'''
	GsFirecracker.Desc: 
		'''
		Reforja: mantienne la detoanción normal de los súbditos; los latigazos al compás cargan mechas en el objetivo, 
		y al alcanzar 3 mechas, la siguiente explosión desencadena 3 explosiones adicionales escalonadas.
		'''
	GsKaleidoscope.Desc: 
		'''
		Reforja: la ventana rítmica es más ajustada, y un golpe fallido reinicia todo el tempo; cada cicatriz ilumina un color del prisma, y al alcanzar los cinco colores, 
		el siguiente golpe rítmico despliega un caleidoscopio de cinco cortes prismáticos, lo que expone a la víctima a posibilidades de crítico garantizadas durante 5 segundos
		'''
	GsLeatherWhip.Desc: 
		'''
		Reforja: tras una cadena de golpes al compás, aumenta el tempo y la velocidad del látigo; tres marcas de lñátigo sellan el objetivo,
		y el siguiente golpe al compás lo rompe infligiendo un 200% de daño, tras lo cual tus súbditos atacan al objetivo durante 2 segundos
		'''
	GsMorningStar.Desc: 
		'''
		Reforja: cada golpe al compás provoca un temblor en la punta del látigo; tres cicatrices sellan la marca, y 
		el siguiente golpe al compás hace que una maza de estrella fugaz caiga sobre la cabeza del objetivo
		'''
	GsSnapthorn.Desc: 
		'''
		Reforja: los golpes al compás hacen crecer cicatrices de espinas en la presa; 4 cicatrices sellan la marca, 
		y el siguiente golpe al compás la hace estallar en una explosión de espinas más 4 púas venenosas autoguiadas
		'''
	GsSpinalTap.Desc: 
		'''
		Reforja: un barrido al compás que alcanza a 3 enemigos hace que un eco óseo resuene en todo lo que no haya alcanzado; 
		4 cicatrices sellan la marca, y el siguiente golpe al compás hace brotar una aguja ósea desde abajo
		'''
}

GodSmithAcc.GodSmithSharkToothNecklace.EffectDesc:
	'''
	El daño aumenta un 4%
	Los golpes desgarran la piel del objetivo, lo que otorga Desgarro: obtienes +1 de penetración de armadura por acumulación, hasta un máximo de 8 acumulaciones y dura 3s
	'''

GodSmithEndow: {
	GodSmithLegendaryEndow: {
		EndowName: Eco del santo de la espada
		EndowDesc: Los golpes tienen un {0}% de probabilidad de lanzar una onda de espada dorada que inflige un {1}% del daño del arma.
	}

	GodSmithWardingEndow: {
		EndowName: Juramento del baluarte
		EndowDesc: Reduce el daño recibido en un {0}%
	}
}
