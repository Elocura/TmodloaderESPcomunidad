# For Language Pack Creators:
# The keys here were previously in Items. Since EcTypeItem has been removed, all localization keys similar to "ItemNameEcType" have been moved here.
# The corresponding format is "ItemNameEcType" → "RItemName" or "ItemNameOverride".
# Apart from the class name change, the DisplayName and Tooltip remain the same as in the previous version.
# So if you need to migrate your language pack to the new version, simply copy and paste the entries here and update the class names accordingly.

Arcanes: {
	Items: {
		ArcaneTransformer: {
			DisplayName: Transformador arcano
			Tooltip: ""
		}
	}
}

Resurrections: {
	ResurrectionDeath: {
		DeathText: "{0} murió a causa de Resurrección abisal"
		WarningCombatText: El abismo te está devorando...
		DeathNoticeText: El Abismo te engulló...
		MarkRemainText: La marca del Abismo aún te envuelve...
		RetainValueFormat: Índice de resurrección: {0}%
	}
}

QuickHack: {
	SynapseBurn: {
		DisplayName: Fundesinapsis
		Description: Sobrecarga las sinapsis neuronales del objetivo, infligiendo daño térmico continuo.
	}

	ShortCircuit: {
		DisplayName: Cortocircuito
		Description: Lanza un pulso electromagnético que causa daño inmediato y una breve parálisis.
	}

	Cyberpsychosis: {
		DisplayName: Ciberpsicosis
		Description: Provoca un frenesí en el objetivo, que ataca a todas las unidades cercanas.
	}

	SystemReset: {
		DisplayName: Reinicio del sistema
		Description: Obliga a reiniciar el sistema del objetivo, paralizándolo por completo.
	}

	OpticOverload: {
		DisplayName: Reinicio óptico
		Description: Deja al objetivo ciego, impidiéndole percibir lo que le rodea.
	}

	MemoryWipe: {
		DisplayName: Lavado de cerebro
		Description: Borra los datos de hostilidad del objetivo y restablece su lista de aggro.
	}

	Contagion: {
		DisplayName: Contagio
		Description: Instala un malware autorreplicante que se propaga a objetivos cercanos.
	}

	TileDetonate: {
		DisplayName: Detonación de unidad
		Description: Pone en peligro la integridad estructural, provocando una explosión localizada.
	}

	TilePhase: {
		DisplayName: Protocolo de fase
		Description: Modifica las propiedades físicas de una unidad, haciéndola intangible durante un tiempo.
	}

	TileMagPull: {
		DisplayName: Atracción magnética
		Description: Genera un campo magnético que atrae hacia ti los objetos que se hayan caído cerca.
	}

	MachineShortCircuit: {
		DisplayName: Cortocircuito en maquinaria
		Description: Agota la energía del objetivo, liberando arcos eléctricos que dañan a las entidades cercanas.
	}

	TurretHijack: {
		DisplayName: Secuestro de torreta
		Description: Altera el módulo de reconocimiento IFF, invirtiendo temporalmente la identificación de amigo o enemigo de la torreta.
	}

	FalseMemory: {
		DisplayName: Falso recuerdo
		Description: Implanta recuerdos falsos, lo que provoca una breve interrupción en la persecución o suprime su instinto asesino.
	}

	SelfDismember: {
		DisplayName: Automutilación
		Description: Obliga a la entidad paranormal a desmembrarse.
	}

	SystemHalt: {
		DisplayName: Apagado del sistema
		Description: Hace que el objetivo se quede en silencio durante unos instantes y cese toda actividad.
	}

	TurretCircuitOverload: {
		DisplayName: Sobrecarga del circuito
		Description: Inyecta corriente inversa en el circuito eléctrico de la torreta, inutilizándola por completo durante un largo periodo de tiempo.
	}

	TurretShortCircuit: {
		DisplayName: Cortocircuito en la torreta
		Description: Descarga al instante la energía de la torreta para paralizarla momentáneamente, volviendo a funcionar inmediatamente tras la recuperación.
	}

	VirusBroadcast: {
		DisplayName: Difusión de virus
		Description: Inyecta un código malicioso en la torre de señales, lo que hace que esta emita ondas ciber-EMP que provocan un cortocircuito en todas las torretas dentro del radio de emisión durante un largo periodo de tiempo.
	}

	MeltdownProtocol: {
		DisplayName: Protocolo de fusión
		Description: Bloquea los disipadores térmicos del objetivo; cuatro segundos después, explota y alcanza a los enemigos cercanos.
	}

	ProjectileHijack: {
		DisplayName: Adquisición balística
		Description: Redirige un proyectil entrante y lo devuelve por donde ha venido.
	}

	ProjectileFreeze: {
		DisplayName: Congelación balística
		Description: Inmoviliza un proyectil en el aire durante cinco segundos y, a continuación, lo suelta.
	}

	DataPurge: {
		DisplayName: Purga de datos
		Description: Elimina un proyectil que se aproxime y todos los del mismo tipo que se encuentren cerca.
	}

	BallisticOverclock: {
		DisplayName: Sobrecarga balística
		Description: Añade daño, penetración y tiempo de vuelo a uno de tus propios proyectiles.
	}

	Electrolysis: {
		DisplayName: Electrolisis
		Description: Electrifica el líquido; los enemigos que se sumergen en él reciben daño progresivo.
	}

	Cryostasis: {
		DisplayName: Criostasis
		Description: Congela una zona de líquido y la convierte en hielo sobre el que puedes permanecer de pie durante ocho segundos.
	}

	LiquidPurge: {
		DisplayName: Purga de líquido
		Description: Drena el líquido que lo rodea. También funciona con lava.
	}

	ItemRecall: {
		DisplayName: Recuperación remota
		Description:Arrastra de un tirón un objeto caído hasta tus pies.
	}

	Reappraise: {
		DisplayName: Reevaluar
		Description: Vuelve a generar la reforja del equipamiento que hay en el suelo.
	}

	ArmorParse: {
		DisplayName: Análisis de armadura
		Description: Reduce la defensa del objetivo a cero durante seis segundos.
	}

	Exorcise: {
		DisplayName: Eliminación forzada
		Description: Marca al objetivo para su eliminación; el quinto golpe que reciba desencadena un ataque contundente.
	}

	DataLeech: {
		DisplayName: Absorvedor de datos
		Description: Mientras esté activo, al acertar a un objetivo se recuperará tu RAM, hasta un límite máximo total.
	}

	SwarmLink: {
		DisplayName: Enlace al enjambre
		Description: Si se acierta al objetivo, también inflige un 30% de daño a un máximo de cinco enemigos cercanos.
	}

	MachineOverclock: {
		DisplayName: Sobrecarga del aparato
		Description: Alimenta la máquina con una cantidad fija de carga durante diez segundos y, a continuación, la quema hasta reducirla a cenizas.
	}

	GridBlackout: {
		DisplayName: Apagón general
		Description: Utiliza la torre de señales para cortar la alimentación eléctrica de todas las máquinas en un amplio radio.
	}

	PowerTransmute: {
		DisplayName: Transmutación de energía
		Description: Convierte la carga del objeto que llevas en RAM y, a continuación, se agota por completo
	}

	NeuralOverclock: {
		DisplayName: Sobrecarga neural
		Description: Ataca más rápido durante ocho segundos; la recuperación de RAM se detiene y tu salud se va agotando
	}

	WraithForceDrive: {
		DisplayName: Propulsor de fuerza espectral
		Description: Las acciones del espectro no cuestan nada durante diez segundos; después, la erosión se agrava y se queda dormido
	}

	IndexPreread: {
		DisplayName: Lectura anticipada
		Description: Analiza el inventario completo de un almacenamiento sin abrirlo y señala el objeto más valioso
	}

	LockBurn: {
		DisplayName: Quemar cerradura
		Description: Abre un almacenamiento cerrado con llave sin necesidad de ella, a cambio de quemar un objeto que haya en su interior
	}

	DielSkip: {
		DisplayName: Salto en el tiempo
		Description: Avanza el tiempo hasta el amanecer o el atardecer más cercano
	}

	StormInject: {
		DisplayName: Inyector de tormentas
		Description: Provoca una tormenta eléctrica; los rayos solo alcanzan a los enemigos que sufran algún hackeo
	}

	GravityInvert: {
		DisplayName: Inversión gravitatoria
		Description: Invierte la gravedad a tu alrededor; los enemigos y los objetos suelten caen hacia arriba
	}

	SegmentDelink: {
		DisplayName: Desvinculación de segmento
		Description: Los daños en este segmento solo se registran; el 60% se liquida sobre la entidad principal
	}

	LimbSeizure: {
		DisplayName: Convulsión de extremidad
		Description: Este miembro atacará a su propio cuerpo durante ocho segundos
	}

	CommandLinkCut: {
		DisplayName: Corte del enlace de control
		Description: Rompe el vínculo con sus compañeros; luchan solos durante diez segundos
	}

	MunitionSwap: {
		DisplayName: Intercambio de munición
		Description: La torreta dispara munición de tu inventario. El daño se calcula en base a tu daño
	}

	TurretMesh: {
		DisplayName: Red de torretas
		Description: Une las torretas cercanas en una ráfaga dirigida hacia el cursor, con un total de cuarenta disparos
	}

	BeaconForge: {
		DisplayName: Auxilio falso
		Description: La torre de señales simula una llamada de socorro, atrayendo a los enemigos desde una amplia zona
	}

	PrivilegeEscalate: {
		DisplayName: Aumento de privilegios
		Description: Los protocolos cuestan menos, se cargan más rápido y no tienen en cuenta el alcance; la RAM deja de recuperarse
	}

	ItemSalvage: {
		DisplayName: Rescate
		Description: Desguaza este objeto presente en el suelo y recupera un 60% de los materiales
	}

	DataBrand: {
		DisplayName: Marca de datos
		Description: Copia el modificador de este equipo y aplícalo al siguiente objetivo
		HudTag: Marca: {0}
		DenyNoPrefix: No hay nada que copiar en este elemento
		DenyIncompatible: El modificador registrado no se ajusta a este objeto
	}

	EntityMasquerade: {
		DisplayName: Mascarada
		Description: Los enemigos interpretan este objeto como si fueras tú; atrae atención durante treinta segundos
	}

	TileConscript: {
		DisplayName: Reclutamiento de bloques
		Description: Desintegra los bloques cercanos en ocho placas de armadura que orbitan a tu alrededor y que se lanzan luego de un tiempo
	}

	VeinResonance: {
		DisplayName: Resonancia de vetas
		Description: Revela el mineral correspondiente a través de las paredes; al extraerlo, se obtiene el doble, pero atrae a los guardianes
	}

	StressInvert: {
		DisplayName: Inversión de tensión
		Description: Hace que el terreno sea indestructible durante diez segundos; los enemigos que choquen contra él sufrirán daño.
	}

	PressureSurge: {
		DisplayName: Pico de presión
		Description: Presuriza este líquido; cualquier cosa que se moje en él sale disparado hacia el cielo
	}

	MirrorSurface: {
		DisplayName: Superficie del espejo
		Description: La superficie se convierte en un espejo; los disparos del enemigo que la atraviesan se reflejan hacia tí.
	}

	DelayFuse: {
		DisplayName: Fusible de retardo
		Description: Este proyectil no desaparecerá y permanecerá suspendido en el aire durante treinta segundos para luego volverse una mina.
	}

	ProjectileTithe: {
		DisplayName: Diezmo de proyectiles
		Description: Este proyectil absorbe el fuego enemigo cercano y luego detona en función de la cantidad de fuego que haya absorbido
	}

	ProjectileSample: {
		DisplayName: Muestra de proyectil
		Description: Toma una muestra del proyectil; durante veinte segundos, luego lo repetirá cada 12 disparos
	}

	CompensationProtocol: {
		DisplayName: Protocolo de compensación
		Description: Aumenta un 10% la vida del objetivo; si no lo matas en 8 segundis, se te cobrará la deuda
	}

	PayloadRewrite: {
		DisplayName: Reescritura de carga 
		Description: Durante diez segundos, los proyectiles del objetivo pasan a ser tuyos. El daño se calcula con tu daño actual.
	}

	PhaseDesync: {
		DisplayName: Desincronización de fase
		Description: Separa el cuerpo del objetivo de su área de impacto; ambas partes se vuelven más difíciles de alcanzar
	}

	LiveCellTap: {
		DisplayName: Grabación en vivo
		Description: Inmoviliza al objetivo y lo hace inmune, convirtiendo su vida en RAM
	}

	FirmwareRollback: {
		DisplayName: Degradación de firmware
		Description: Devuelve al objetivo a su fase anterior; este entrará en estado de furia durante cinco segundos 
	}

	ShellRequisition: {
		DisplayName: Solicitud de consola
		Description: Los objetivos marcados eliminados resurgen y luchan por ti durante quince segundos
	}

	PositionCast: {
		DisplayName: Proyector de posición
		Description: Puedes ver la posición del enemigo a través de los bloques durante 15 segundos
	}

	GaugePollution: {
		DisplayName: Indicador de contaminación
		Description: Altera tu interfaz; los indicadores de salud y munición se distorsionan durante ocho segundos
	}

	LinkTraceback: {
		DisplayName: Rastreo de enlaces
		Description: Elimina todas las cargas dirigidas a ti, castiga a quienes las envían y los marca
	}

	ForceUninstall: {
		DisplayName: Desinstalación forzada
		Description: Elimina un protocolo hostil sobre tí; no podrás volver a eliminar ninguno hasta dentro de medio minuto
	}

	MemoryScorch: {
		DisplayName: Memoria abrasada
		Description:Elimina tres puntos de RAM del rival; no recuperará RAM durante diez segundos
		SealTag: RAM SELLADO
	}

	BuffSiphon: {
		DisplayName: Sifón beneficioso
		Description: Te apropias del beneficio que más longevo, hasta treinta segundos.
	}

	CombatSiphon: {
		DisplayName: Sifón de combate
		Description: Durante diez segundos, el daño que infliges se convierte en RAM
	}

	BallisticTurncoat: {
		DisplayName: Traidor balístico
		Description: Los tres siguientes disparos dan la vuelta en pleno vuelo y se dirigen hacia el que los disparó; no disparar es lo que te mantiene a salvo
		HijackCounter: Proyectiles detenidos {0}/{1}
		DeathReason: "El disparo de {0} fue desviado por {1} y se el regresó."
	}

	MeltdownBrand: {
		DisplayName: Marca de colapso
		Description: Coloca una mecha visible de cuatro segundos que, al detonar, inflige 80 puntos de daño; al desmontarla, se desactiva la carga
		FuseTag: Colapso {0}s
		DeathReason: "{0} quedó destrozado por la marca de colpasó {1} que colocó."
	}

	MapBlackout: {
		DisplayName: Apagón de mapa
		Description: Oculta el mapa tras ruido estático durante 15 segundos, incluyendo los marcadores de posición y los del equipo
	}

	ChannelScramble: {
		DisplayName: Codificación de canales
		Description: Distorsiona el chat durante 20 segundos y borra los nombres de los compañeros de equipo de la pantalla
	}

	StealthStrip: {
		DisplayName: Tira de camuflaje
		Description: Quita toda la invisibilidad y sigilo durante diez segundos; su silueta brilla y es visible para todos
	}

	CooldownInject: {
		DisplayName: Inyección de enfriamiento
		Description: Ralentiza el uso de sus objetos en un 35% durante 6 segundos; el tiempo de recarga de una poción aumenta en cinco segundos más
	}

	CyberwareOffline: {
		DisplayName: Ciberimplantes desconectados
		Description: Desconecta todos los ciberimplantes durante 8 segundos
	}
}

