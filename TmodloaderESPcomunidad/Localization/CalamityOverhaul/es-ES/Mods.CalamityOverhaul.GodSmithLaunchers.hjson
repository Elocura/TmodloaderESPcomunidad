GsElectrosphereLauncher: {
	Desc: Reforja: dos o más de tus esferas se unen mediante arcos de Tesla (hasta 3; daño de media esfera)
	TipOverload: ¡Sobrecarga!
}

GsGrenadeLauncher: {
	Desc: Reforja: Las granadas se adhieren a las paredes y a los enemigos (+25 % de daño cuando se adhieren a la carne); se pueden colocar hasta 6, y la más antigua explota para dejar espacio
	TipDetonate: ¡Detonación total!
}

GsJackOLanternLauncher: {
	Desc: Reforja: cada explosión deja tras de sí un campo de velas que abrasa a quien se adentre en él
	TipGrin: ¡Risa al unísono!
}

GsNailGun: {
	Desc: Reforja: las uñas se clavan en la carne (hasta 5 por víctima), y cada una de ellas hace que la víctima reciba un 3% de daño de todas las fuentes
	TipExtract: ¡Arrancar con carne!
}

GsProximityMineLauncher: {
	Desc: Reforja: las minas te muestran su radio de activación; las minas que permanecen inactivas durante 60s devuelven un cohete y se desactivan automáticamente
	TipChain: ¡Dominó!
	TipRecycle: Mina recuperada
}

GsRocketLauncher: {
	Desc: Reforja:Los disparos te hacen retroceder, y los impactos directos duelen más
	TipDetonate: ¡Explosión aérea!
}

GsSnowmanCannon: {
	Desc: Reforja: golpea a las víctimas de la marca con un copo de nieve (+8% con esta arma)
	ModeHoming: Vehículo: enjambre perseguidor
	ModeOrbital: Vehículo: órbita de ventisca
}

GsStarCannon.Desc:
	'''
	Reforja: cambiar la trayectoria
	Tiro tenso: las estrellas vuelan en línea recta; Estrella caída: las estrellas suben y luego llueven alrededor del cursor; al acertar salpican polvo estelar
	'''

GsStynger: {
	Desc: Reforged: explota al impactar, con un efecto de retroceso al disparar. Los pernos Stynger y la metralla permanecen donde estaban.
	ModeImpact: Espoleta: impacto
	ModeRange: Espoleta: explosión a distancia
	ModeRicochet: Espoleta: rebote
}
