		"Keybinds.Phosphor Blackout.DisplayName": Phosphor  Blackout
		BossChecklist.XT017Scorpion.DespawnMessage: "[XT-017 «Scorpion»]: Target destroyed. Reporting."

		NPCs: {
			XT017Scorpion: {
				FireSupportAlert: FIRE SUPPORT REQUIRED.
				Bestiary:
					'''
					Draedon heavy twin-rotor assault helicopter, based on blueprints from HAZARDICATE INC. 
					It is equipped with heavy armor, mine-laying systems, and a direct data link to "Raptor" support jet-fighters. 
					XT-017 is a dreadnought patrolling the shores of the Sulfur Sea to search for and destroy Sea Scourges and Nuclear Terrors.
					The "Scorpion" feeds on nuclear fuel from Nuclear Terrors, allowing it to undergo Subatomic Decay.
					'''
				DisplayName: XT-017 «Scorpion»
				RaptorQuote1: Let's take this one.
				RaptorQuote2: He's mine.
				RaptorQuote3: I see.
				RaptorQuote4: Under control.
				RaptorQuote5: Making a pass!
				RaptorQuote6: Got it.
				RaptorQuote7: Copy that.
				RaptorQuote8: Roger that.
				RaptorQuote9: Raptor here.
				RaptorQuote10: What do you got?
				IntroTitle: CONTAGIOUS DREADNOUGHT
				IntroName: XT-017 SCORPION
				IntroTrack: FOREVER
				IntroComposer: ~ Brandon McKagan
			}

			PilotVane: {
				DisplayName: Shell-shocked Pilot

				Names: {
					Vane: Vane
					McKagan: McKagan
					Hunter: Hunter
					Sparrow: Sparrow
					Eagle: Eagle
					Falcon: Falcon
				}

				Dialogue: {
					Line1: I forgot about your gift again, im so sorry
					Line2: Virili? A damn familiar word. Or a name. I don't really remember.
					Line3: I am grateful to you for freeing me from the jaws of this rotten machine. But again, how was your name?
					Line4: I'm afraid I'll never get into that infectious fighter jet again.
					Line5: How old am i? How long i was a sulfur sea killer? Ugh... I don't even remember my second name...
					BiomeHint: If you want me operating at 100%, get me a base in the Jungle or near my toxic coast. Just keep me away from glowing mushrooms.
					MushroomHate: Are you serious? Get me out of this mushroom dump before I start throwing toxic flasks at the wall.
				}

				TownNPCMood: {
					Content: *Sighs*, intoxicating!
					NoHome: It's like... freezing outside. At least my jet cockpit had heating.
					FarFromHome: I'd kill for a hot coffee back home instead of dealing with all this.
					LoveSpace: Finally, room to spread my wings.
					DislikeCrowded: Getting a bit tight around here, don't ya think?
					HateCrowded: I can't even spread my wings in this tiny closet.
					LoveBiome: Fresh air, moisture and no damn shroomies. Fits me just right.
					HateBiome: I'm about to throw up from all these mushrooms. Get me out of here!
					HateNPC: Keep {NPCName} away from me! That walking mushroom literally makes me sick.
					LikeNPC_Princess: "{NPCName} is an absolute gem."
					Princess_LovesNPC: "{NPCName} has an infectious spirit!"
				}
			}
		}

		Biomes: {
			PlagueJungleBiome: {
				DisplayName: Plagued Jungle
				TownNPCDialogueName: Plagued Jungle
			}
		}

		Conditions: {
			IsVane: Name is Vane
			IsMcKagan: Name is McKagan
		}
	}
