		DisplayName: Disparo de ceniza
		Tooltip:
			'''
			Esta arma convierte la munición en bolas de fuego que infligen [cbuff:OnFire3] y se va cargando a medida que dispara
			Cuando está completamente cargada, potencia las tres siguientes bolas de fuego para que inflijan un daño considerablemente mayor
			'''
	}

	AshesSword: {
		DisplayName: Espada de cenizas
		Tooltip:
			'''
			Lanza una ráfaga de terrones de ceniza al blandirla
			Al cabo de unos instantes, los terrones de ceniza se convierten en bolas de fuego autoguiadas que infligen [cbuff:OnFire3]
			'''
	}

	EmberBolt: {
		DisplayName: Perno de brasas
		Tooltip: Lanza una bola de fuego explosiva que inflige [cbuff:OnFire3] al impactar y estalla en fragmentos tectónicos que se dirigen hacia el objetivo
	}

	RemnantsStaff: {
		DisplayName: Resto infernal
		Tooltip: Lanza tres estrellas térmicas autoguiadas que explotan al impactar e infligen [cbuff:OnFire3]
	}

	CinderLantern: {
		DisplayName: Farol de cenizas
		Tooltip: Invoca un núcleo de ceniza que lanza bolas de fuego que infligen [cbuff:OnFire3] a los enemigos cercanos
	}

	Fuusen: {
		DisplayName: Fuusen
		Tooltip: ""
	}

	Ratziel: {
		DisplayName: Ratziel
		Tooltip:
			'''
			Convoca una visión que proyecta una luz dañina sobre los enemigos que se encuentren dentro de su alcance
			El centinela crea un escudo alrededor del jugador que absorbe el daño
			Cuando el escudo se rompe, comienza a regenerarse tras un tiempo de enfriamiento de 20 segundos
			A medida que aumenta el nivel, también lo hacen el daño, el alcance y la resistencia del escudo
			Este centinela siempre infligirá golpes críticos, aunque estos solo infligen un 50% más de daño
			Por cada ranura de súbdito que tengas, los golpes críticos infligen un 5% más de daño, ganan 1 punto de defensa y un 0,4% de reducción de daño
			Solo puede haber una visión activa a la vez
			Nivel: [LV] / [MAXLV]
			'''
	}

	AzafureSupportRemote: {
		DisplayName: Control a distancia de refuerzo
		Tooltip:
			'''
			Invoca un dron de combate que dispara proyectiles perforantes contra los enemigos
			Los proyectiles infligen [cebuff:CalamityMod/ArmorCrunch] y [cebuff:CalamityEntropy/MechanicalTrauma].
			'''
	}

	AerialiteMissile: {
		DisplayName: Aviador de aerialita
		Tooltip:
			'''
			Explota en tres plumas autoguiadas
			Aumenta el daño en un 5% por cada misil incrustado
			'''
	}

	ClusterMissile: {
		DisplayName: Misil de racimo
		Tooltip:
			'''
			Al impactar, se divide inmediatamente en hasta 5 minimisiles autoguiados
			Aumenta el daño un 3% por cada minimisil incrustado
			Los misiles infligen [cbuff:CalamityEntropy/MechanicalTrauma]
			'''
	}

	GiantBoulder: {
		DisplayName: Roca gigantesca
		Tooltip: "Por defender el Arca Perdida u otros objetos históricos locales"
	}

	BeewaxWall: {
		DisplayName: Pared de cera de abeja
		Tooltip: ""
	}

	HallowedMissile: {
		DisplayName:  Carga sagrada
		Tooltip:
			'''
			Tiene un radio de explosión mucho mayor
			Aumenta el daño en un 7% por cada misil incrustado
			'''
	}

	AzafurePhonograph: {
		DisplayName: Fonógrafo de Azafure
		Tooltip: ""
	}

	BuriedSun: {
		DisplayName: Sol enterrado
		Tooltip:
			'''
			Dispara tres rayos láser penetrantes con el color del atardecer
			Tras recorrer una corta distancia, los proyectiles crean manchas solares
			Las manchas solares se fusionan antes de lanzar un rayo láser adicional con el color del atardecer
			'''
	}

	BaXingChong: {
		DisplayName: Ba Xing Chong
		Tooltip:
			'''
			Lanza una salva de misiles autoguiado
			[c/ff7f50:"¿El antiguo dueño de esta arma? ¿Te refieres a ese tipo que está cubierto de ciberimplantes, excepto el cerebro?"]
			'''
	}

	YoungMaster: {
		DisplayName: Joven señor
		Tooltip:
			'''
			Lanza un boomerang de retazos
			Haz clic derecho para lanzarte hacia delante; no recibirás daño durante el dash
			Si impactas en cualquier objetivo durante el dash, realizarás una voltereta hacia atrás y lanzarás un tajo en forma de X en el aire
			El impacto del tajo en forma de X provoca una explosión retardada y recarga el arma
			Potencia los siguientes 10 ataques normales
			'''
	}

	AzafureImperialGuardMachineGun: {
		DisplayName: Ametralladora de la Guardia imperial de Azafure
		Tooltip:
			'''
			Utiliza los componentes industriales del infierno[i:CalamityEntropy/HellIndustrialComponents] para cargar munición [AMMOMAX]
			Dispara ráfagas rápidas de escopeta a corta distancia
			'''
	}

	AzafureExhaustGasInjector: {
		DisplayName: Inyector de gases de escape Azafure
		Tooltip: Chorro de gases de escape corrosivos
	}

	AzafureStandardShotgun: {
		DisplayName: Escopeta estándar de Azafure
		Tooltip: Dispara unos perdigones de escopeta dispersos
	}

	ThalassianGleam: {
		DisplayName: Brillo talásico
		Tooltip: ""
	}

	GoldenFlowerInAJar: {
		DisplayName: Flor dorada en un frasco
		Tooltip:
			'''
			Convierte el fondo en un campo de color rosa y dorado
			$Gracias por ver mi sueño
			'''
	}

	Erebodrepanon: {
		DisplayName: Erebodrepanón
		Tooltip: Empuña una guadaña gigante y haz pedazos a tus enemigos
	}

	FlowerHeadband: {
