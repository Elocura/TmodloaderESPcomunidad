		Tooltip: Dispara un proyectil perforante que inflige [cebuff:CalamityMod/ArmorCrunch] y [cebuff:CalamityEntropy/MechanicalTrauma]
	}

	RockBullet: {
		DisplayName: Bala de roca
		Tooltip: Al disparar, existe la posibilidad de que el arma se atasque, lo que anularía el ataque
	}

	TatteredGun: {
		DisplayName: Pistola destartalada
		Tooltip:
			'''
			Al disparar, existe la posibilidad de que el arma se atasque, lo que anula el ataque
			"Que esta cosa funcione es un milagro"
			'''
	}

	MoonlightSword: {
		DisplayName: Espada de luz lunar
		Tooltip: Genera una oleada de energía lunar al balancearse
	}

	BookMarkBlackKnife: {
		DisplayName: Marcapáginas - Cuchillo negro
		Tooltip:
			'''
			Los ataques tienen la posibilidad de invocar un cuchillo negro al impactar, que se abalanza sobre los enemigos
			"¿CUÁNTO TIEMPO ME QUEDA AÚN... MI DELTARUNE?"
			'''
	}

	AzafureTeslaGun: {
		DisplayName: Pistola tesla de Azafure
		Tooltip:
			'''
			Lanza una bola de Tesla que se encadena a los enemigos cercanos a medida que avanza.
			La bola de Tesla explota al impactar, generando una pequeña onda de choque e infligiendo [cebuff:CalamityEntropy/MechanicalTrauma]
			'''
	}

	AzafurePioneerCannon: {
		DisplayName: Cañón pionero de Azafure
		Tooltip:
			'''
			Mantén pulsado clic izquierdo para cargar y acumular hasta 5 disparos
			Suelta el clic izquierdo para disparar todos los disparos acumulados de una sola vez
			Estos disparos tienen penetración infinita e infligen [cebuff:CalamityMod/ArmorCrunch] y [cebuff:CalamityEntropy/MechanicalTrauma].
			'''
	}

	ShadoidPotion: {
		DisplayName: Poción de Shadoid 
		Tooltip:
			'''
			Restaura un tercio de la vida máxima y reinicia la duración del vuelo
			No es un objeto consumible
			'''
	}

	ShadowMantle: {
		DisplayName: Manto de las sombras
		Tooltip:
			'''
			Aumenta la regeneración de sigilo en función de tu velocidad de movimiento
			Pulsa [KEY] para consumir todo el sigilo del rogue y lanzarte hacia la posición del cursor, recorriendo una cierta distancia antes de atravesar a los enemigos con un tajo
			El daño aumenta en función de la cantidad de sigilo consumida.
			'''
	}

	MineBox: {
		DisplayName: Caja de minas
		Tooltip:
			'''
			Aumenta un [D]% el daño de rogue
			Los ataques sigilosos colocarán una mina de explosión retardada en la posición del enemigo al impactar por primera vez
			'''
	}

	LurkersCharm: {
		DisplayName: Talismán de los merodeadores
		Tooltip:
			'''
			Aumenta un [A]% el daño rogue
			Aumenta un [B]% la velocidad de movimiento
			Aumenta un [C]% la regeneración de sigilo
			Aumenta un [D]% la reducción de daño si tu sigilo es superior al 80% del sigilo máximo
			'''
	}

	ThiefsPocketwatchOfEclipse: {
		DisplayName: Reloj de bolsillo del eclipse
		Tooltip:
			'''
			Aumenta un [A]% el daño rogue
			Aumenta un [B]% la velocidad de movimiento
			Aumenta un [C]% la regeneración de sigilo
			El sigilo del rogue puede sobrellenarse hasta duplicar el sigilo máximo
			El sigilo sobrellenado no aumentará el daño del pícaro
			'''
	}

	GaleWristblades: {
		DisplayName: Cuchillas de vendaval de muñeca
		Tooltip:
			'''
			Las armas rogue, con un tiempo de recarga de medio segundo, otorgan 1 acumulación de [cebuff:CalamityEntropy/WindPressure] al impactar
			Cuando se alcancen 5 o más acumulaciones de [cebuff:CalamityEntropy/WindPressure], el siguiente ataque consumirá todas las acumulaciones para desatar un pequeño tornado
			'''
	}

	WorshipRelic: {
		DisplayName: Reliquia venerada
		Tooltip:
			'''
			El sigilo del rogue ya no se regenera de forma pasiva, sino que se regenera con cada golpe de arma del pícaro
			Cuando el sigilo está al máximo, tu ataque se convierte en un golpe sigiloso y dispara flechas solares autoguiadas adicionales
			Reduce a la mitad tu sigilo máximo y elimina los golpes críticos de rogue
			'''
	}

	ShadowPact: {
		DisplayName: Pacto de las sombras
		Tooltip:
			'''
			Aumenta un [A]% el daño rogue
			Sustituye el sigilo de rogue por el medidor de sombra
			El medidor de sombra se llena a un ritmo fijo
			Cuando está lleno, tu siguiente ataque con un arma rogue lo consume para lanzar un orbe de sombra autoguiado
			Al impactar, el orbe genera múltiples dagas de sombra que atacan al enemigo alcanzado
			'''
	}

