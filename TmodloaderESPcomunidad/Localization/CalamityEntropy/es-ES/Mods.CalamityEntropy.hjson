		}

		LuminarisLore: {
			DisplayName: Luminaris
			Tooltip: ""
			Lore: "{$loreLuminaris}"
		}

		LoreApsychos: {
			DisplayName: Apsychos
			Tooltip: ""
			Lore:
				'''
				Esta antigua abominación fue uno de los primeros intentos de sellar a un dios. 
				Al principio, intentaron sellar su esencia dentro de las placas tectónicas en las profundidades del mundo. 
				Esto provocó la agitación de una criatura latente en los océanos de lava más profundos del Inframundo, lo que la llevó a arremeter en un intento por resistirse a la repentina oleada de energía. 
				Al final, el intento solo tuvo un éxito parcial, dejando a la extraña criatura atrapada en su angustioso estado. Ya era hora de que alguien la liberara del error de los hombres.
				'''
		}
	}

	BrokenChainsaw: {
		DisplayName: Motosierra rota
		Tooltip: Esta arma se sobrecalienta, lo que impide su uso durante un rato
	}

	MechanicalChainsaw: {
		DisplayName: Esta arma se sobrecalienta, lo que impide su uso durante un rato
		Tooltip: ""
	}

	EnslavedStar: {
		DisplayName: Estrella esclavizada
		Tooltip: Inflige [cbuff:CalamityMod/Plague] y, en ocasiones, libera abejas de la plaga que se dirigen hacia el objetivo
	}

	Euangelion: {
		DisplayName: Euangelion
		Tooltip: Inflige [cbuff:CalamityMod/Nightwither] y, en ocasiones, lanza esferas de luz que se dirigen hacia el enemigo
	}

	Pioneer: {
		DisplayName: Pionero
		Tooltip: Talla grietas de vacío con la punta de la motosierra
	}

	GodsSnack: {
		DisplayName: Deleite divino
		Tooltip: Invoca a DoG-Chan
	}

	CruiserBag: {
		DisplayName: Bolsa del tesoro(Cruiser)
		Tooltip: ""
	}

	CruiserRelic: {
		DisplayName: Reliquia del Cruiser 
		Tooltip: ""
	}

	DivineRemnants: {
		DisplayName: Vestigios divinos
		Tooltip: Invoca a un amigo astral para que te guíe en tu camino
	}

	BottleDarkMatter: {
		DisplayName: Materia oscura contenida
		Tooltip: Invoca al Vacío incesante-chan
	}

	DivineIntervention: {
		DisplayName: Intervención divina
		Tooltip:
			'''
			Lanza un escudo divino que refleja los proyectiles
			Puedes lanzar un escudo cada 5 minutos
			'''
	}

	Godhead: {
		DisplayName: Cabeza de dios
		Tooltip:Los proyectiles están rodeados de un aura dañina que ignora los i-frames y se adapta al daño del arma
	}

	VoidEcho: {
		DisplayName: Símbolo de la teocracia
		Tooltip:
			'''
			invoca un círculo de hasta 6 cañones divinos que disparan rayos láser al activarse
			Inflige [cebuff:CalamityEntropy/VoidTouch]
			"El vacío es un elemento de gran poder; solo se necesitan unas pocas gotas para lograr la aniquilación total"
			'''
	}

	FriendBox: {
		DisplayName: Cajón de amigos
		Tooltip:
			'''
			Invoca a un par de gemelos que orbitan a tu alrededor y clonan tus proyectiles
			Los proyectiles duplicados infligen el 10 % del daño del arma original
			Cada par de gemelos ocupa 4 espacios de súbditos
			'''
	}

	LightningPendant: {
		DisplayName: Colgante relámpago
		Tooltip: Invoca al Tejedor de tormentas-chan
	}

	EvilFriend: {
		DisplayName: Peluche malvado
		Tooltip: Invoca a un espíritu del azufre que lanza rayos láser
	}

	TheocracyPearlToy: {
		DisplayName: Perla de la teocracia de juguete
		Tooltip: Invoca a Cruiser-chan
	}

	CruiserTrophy: {
		DisplayName: Trofeo del Cruiser 
		Tooltip: ""
	}

	VoidMonolith: {
		DisplayName: Monolito del vacío
		Tooltip: "La oscuridad del señor de la luna no se puede comparar con esto"
	}

	VoidToy: {
		DisplayName: Juguete del vacío
		Tooltip: Invoca a un compañero Cruiser del vacío
	}

	WingsOfHush: {
		DisplayName: Alas del silencio
		Tooltip: "[c/9387ff: Dispara un potente láser del vacío y 4 rayos del vacío]"
	}

	SoyMilk: {
		DisplayName: Leche de soja
		Tooltip:
			'''
			Multiplica la velocidad de ataque por 3
			Divide el daño infligido entre 3
			Desactiva la obtención de sigilo mientras el beneficio está activo
			'''
	}

	DarkArts: {
		DisplayName: Artes oscuras
		Tooltip:
			'''
			Te inflige [cebuff:CalamityEntropy/StealthState], lo que te otorga inmunidad total y marca a todos los enemigos y proyectiles con los que entras en contacto
			Inflige daño a todas las entidades marcadas y elimina todos los proyectiles marcados una vez que el efecto desaparece
			'''
	}

	VenomPiece: {
		DisplayName: Trozo de veneno
		Tooltip: invoca un gato-melón
	}

	WisdomCard: {
		DisplayName: Carta del oráculo 『Sabiduría』
		Tooltip:
			'''
			-[COST]% de coste de maná
			"La victoria acompaña a quienes buscan la verdad"
			'''
	}

	TemperanceCard: {
		DisplayName: Carta del oráculo 『Templanza』
		Tooltip:
			'''
			Aumenta tu número máximo de súbditos en [T]
			"Contén tu deseo de ganarte la lealtad de legiones"
			'''
	}

	RadianceCard: {
		DisplayName: Carta del oráculo 『Esplendor』
		Tooltip:
			'''
			+[LR]% de velocidad regeneración de vida 
			"Asegúrate de ser la luz que sane el alma"
			'''
	}

	OracleDeck: {
		DisplayName: Baraja del oráculo
		Tooltip:
			'''
			[CR]% de aumento de la probabilidad de golpe crítico
			+15% de aumento de la velocidad de movimiento
			+[HP] de vida máxima
			+[ST] de sigilo máximo
			-30% de coste de maná
			Reduce el daño recibido en un 5%
			Aumenta la penetración de armadura en [AP]
			Aumenta tu número máximo de súbitos en [MN]
			+[ATS]% de velocidad de ataque
			Las fuentes de luz que emites son mucho más brillantes
			Los jugadores cercanos reciben 20 PV de curación durante 5 segundos
			Recibirás como máximo la mitad de tu salud máxima en daño
			'''
	}

	MetropolisCard: {
		DisplayName: Carta del oráculo 『Metrópolis』
		Tooltip:
			'''
			+10 de sigilo máximo
			"El engaño se encuentra en los lugares más recónditos y oscuros"  
			'''
	}

	InspirationCard: {
		DisplayName: Carta del oráculo 『Inspiración』
		Tooltip:
			'''
			+20% de velocidad de movimiento 
			"La epifanía regresa, rápida como el viento"  
			'''
	}

	EntityCard: {
		DisplayName: Carta del oráculo 『Entidad』
		Tooltip:
			'''
			+10% de velocidad de ataque general
			"La adrenalina abandona lo carnal con la misma rapidez que las sombras"  
			'''
	}

	EnduranceCard: {
		DisplayName: Carta del oráculo 『Resistencia』
		Tooltip:
			'''
			-5% de daño recibido
			"El acero templado con tal voluntad sostendrá las montañas"  
			'''
	}

	BrillianceCard: {
		DisplayName:Carta del oráculo『Brillante』
		Tooltip:
			'''
			Las fuentes de luz que emites son más brillantes
			"En un mundo sumido en la oscuridad, debes traer la luz eterna"
			'''
	}

	AuraCard: {
		DisplayName: Carta del oráculo 『Aura』
		Tooltip:
			'''
			+5% de probabilidad de crítico
			"Basta con un destello de inspiración para asestar un golpe mortal"  
			'''
	}

	ThreadOfFate: {
		DisplayName: Hilo del destino
		Tooltip:
			'''
			Entrelaza las cartas místicas de la baraja del Oráculo
			Mantén pulsada la tecla MAYÚS para leer el hilo...
			'''
		HoldShiftForDetails:
			'''
			[i:CalamityEntropy/AuraCard]Aura: Repartidos entre cabañas ocultas y cajas sumergidas...
			[i:CalamityEntropy/BrillianceCard]Brillante: Vendida por un comerciante excéntrico y misterioso...
			[i:CalamityEntropy/EntityCard]Entidad: Ofrecida a una vidente de piel nacarada del mar hundido...
			[i:CalamityEntropy/InspirationCard]Inspiración: Abandonada a pudrirse en las arenas movedizas...
			[i:CalamityEntropy/MetropolisCard]Metrópolis: Transcrita de muchos libros comunes...
			[i:CalamityEntropy/WisdomCard]Sabiduría: En poder del guardían maldito de la mazmorra...
			[i:CalamityEntropy/RadianceCard]Esplendor: Requiere la magia de un orbe sagrado...
			[i:CalamityEntropy/TemperanceCard]Templanza: Utilizada como ancla espiritual para una monstruosidad mecánica...
			[i:CalamityEntropy/EnduranceCard]Resistencia: Puesta a prueba en esa parte del mar donde la luz nunca llega...
			'''
	}

	RuneSong: {
		DisplayName: Canto arcáico
		Tooltip:
			'''
			Al cargar el arma brevemente, realiza un barrido en un amplio arco
			Si impacta en un enemigo, la hoja retrocede
			y luego realiza una serie de cortes múltiples más amplios
			Si falla, la espada apunta hacia el cursor, y dispara un Pulso rúnico
			Inflige [cebuff:CalamityEntropy/SoulDisorder]
			'''
	}

	GalaxyGrapeSoda: {
		DisplayName: Refresco galáctico de uva
		Tooltip:
			'''
			¿Una mezcla de uvas frescas, esencia divina y... guardianes del clima?
			Te convierte en un auténtico Devorador de Dioses
			'''
	}

	VoidAnnihilate: {
		DisplayName: Órbita nihilista
		Tooltip:
			'''
			[c/9387ff:Haz clic izquierdo o mantén pulsado clic derecho para lanzar unos cuchillos]
			[c/9387ff:Al impactar contra un objetivo, rebotarán y quedarán flotando en el aire]
			[c/9387ff:Mantén pulsado clic izquierdo para acumular impulso]
			[c/9387ff:Cuando esté completamente cargado,]
			[c/9387ff:al soltarlo, lanzarás un cuchillo potenciado que causará el triple de daño]
			[c/9387ff:Potenciar los cuchillos hará que todos los cuchillos que flotan alcancen al objetivo]
			'''
	}

	AuricBoulder: {
		DisplayName: Roca áurica grande
		Tooltip: Del gran creador Red-tropy
	}

	DustyStar: {
		DisplayName: Estrella polvorienta
		Tooltip:
			'''
			Concede la apariencia del desarrollador principal
			¡No te olvides de dejar un "Me gusta"!
			'''
	}

	SoulCandle: {
		DisplayName: Vela del alma
		Tooltip:
			'''
			Invoca Signus-chan
			"Cuanto más fina es la hoja, más afilado es el filo..."
			'''
	}

	KosRunePendant: {
		DisplayName: Colgante de la Runa de Kos
		Tooltip: Invoca al Devorador-Chan y a sus sirvientes chibi
	}

	OdinsRefuge: {
		DisplayName: Protección de Odín
		Tooltip:
			'''
			Permite realizar una embestida, potenciada por el infierno cósmico
			Esta embestida puede atravesar a los enemigos sin sufrir daño
			Otorga inmunidad al empuje y a los bloqueos de fuego
			Otorga inmunidad a la gran mayoría de los efectos negativos, incluido el Infierno del Asesino de Dioses.
			Provoca la caída de estrellas y aumenta la duración de la invulnerabilidad tras recibir daño
			Otorga fotogramas de invencibilidad adicionales en función de la salud que te falte
			Este efecto varía desde 10 fotogramas con la salud al máximo hasta 40 fotogramas con un 25% o menos de salud
			Recibir más de 200 de daño otorga 30 fotogramas de invencibilidad adicionales
			Crea un escudo alrededor del portador cuando tiene menos del 50% de vida, lo que reduce el daño recibido
			Absorbe el 25% del daño infligido a los jugadores de tu equipo mientras tengas más del 25% de vida
			Te proporciona un Escudo sagrado que puede resistir el daño una vez, con un tiempo de enfruamiento de 150 segundos
			Mantén pulsada la tecla Mayús y haz clic derecho para activar o desactivar [i:PanicNecklace] [c/aaaaaa:Efecto del Collar del pánico]
			'''
		ToggleEffectOn: "[c/00ff00:Pánico activado]"
		ToggleEffectOff: "[c/808080:Pánico desactivado]"
	}

	VoidBar: {
		DisplayName: Lingote del vacío
		Tooltip: Miles de kilómetros de entropía cósmica, condensadas en este simple caparazón...
	}

	VoidOre: {
		DisplayName: Mineral del vacío
		Tooltip: Atrapado en un estado constante de disolución y regeneración...
	}

	VoidScales: {
		DisplayName: Escamas del vacío
		Tooltip: Un catalizador biológico capaz de estabilizar el vacío en bruto...
	}

	HolyMoonlight: {
		DisplayName: Venerada Luz de la Luna
		Tooltip:
			'''
			+15% de daño mágico y +50 de maná máximo
			Crea un escudo mágico cada treinta segundos que inflige daño al entrar en contacto, aumenta tu velocidad de movimiento y reduce el consumo de maná en un 10%
			Cuando se rompe el escudo mágico, estas ventajas desaparecen, pero tu daño mágico puede robar vida
			Este escudo no se acumula con el Cáliz del Dios de la sangre
			'''
	}

	PhantomPlanetKillerEngine: {
		DisplayName: Motor de destrucción planetario
		Tooltip:
			'''
			Convoca una pequeña nave de guerra para que dispare cohetes y balas contra tus enemigos
			Las naves de guerra utilizarán las balas de tu inventario, pero no las consumirán
			Estas naves lanzan un láser cada 8 rondas de disparos que inflige [cebuff:CalamityEntropy/VoidTouch].
			'''
	}

	PowerOfTyrant: {
		DisplayName: El poder del tirano
		Tooltip:
			'''
			Genera ondas de choque terrestres al blandir la espada
			Si consigues golpes cuerpo a cuerpo efectivos, la hoja se cargará
			Si la hoja se carga lo suficiente, se invocará un fantasma del tirano que imitará tus golpes
			Si no consigues golpes cuerpo a cuerpo efectivos, tu carga se reducirá y, finalmente, el fantasma desaparecerá
			'''
	}

