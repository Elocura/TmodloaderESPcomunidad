		Tooltip: Lanza estrellas guiadas al impactar
	}

	WhipOfService: {
		DisplayName: Látigo servicial
		Tooltip:
			'''
			Al golpear a otros jugadores, estos reciben el beneficio [cebuff:CalamityEntropy/ServiceBuff]
			Cada golpe adicional aumentará la duración del beneficio
			"¡Ahora trabajas para MÍ, ¿entendido?!"
			'''
	}

	Xytheron: {
		DisplayName: Xytheron
		Tooltip:
			'''
			Inflige [cebuff:CalamityEntropy/LifeOppress] y acumula energía al impactar
			Cuando tu barra de energía esté llena, puedes hacer clic derecho para lanzar un tajo hacia delante, dejando tras de ti una grieta abisal
			'''
	}

	AbyssalAltar: {
		DisplayName: Altar abisal
		Tooltip:
			'''
			Se utiliza para fabricar armas y equipamiento especializados
			Haz clic derecho con un diente de wyrm para invocar a la Sierpe Primordial
			'''
	}

	Ystralyn: {
		DisplayName: Ystralyn
		Tooltip:
			'''
			Invoca una Sierpe primordial fantasma que inflige [cebuff:CalamityMod/MarkedforDeath] y [cebuff:CalamityEntropy/LifeOppress] al impactar.
			Los súbditos obtienen un aumento del 12% de probabilidad de golpe crítico
			{$CommonItemTooltip.SummonTagDamage}
			{$CommonItemTooltip.Whips}
			'''
	}

	VoidPathology: {
		DisplayName: Patología del vacío
		Tooltip: Convoca una mitocondria que sigue al cursor y electrocuta a los enemigos cercanos, infligiendo [cebuff:CalamityEntropy/VoidVirus]
	}

	AnnihilateArrow: {
		DisplayName: Descarga del vacío
		Tooltip: Se divide en cinco proyectiles autoguiados cuando se acerca a un objetivo
	}

	NegentropyBullet: {
		DisplayName: Bala de negentropía
		Tooltip: Las balas crean un portal y repiten su trayectoria al impacta
	}

	Zyphros: {
		DisplayName: Zyphros
		Tooltip:
			'''
			Convierte las flechas en cristales de seguimiento que infligen [cebuff:CalamityEntropy/LifeOppress]
			Estos cristales tienen una probabilidad de crear un cristal elemental adicional que se lanzará e infligirá otros debuffs elementales
			'''
	}

	FriendFinder: {
		DisplayName: Cruz de la conversión
		Tooltip:
			'''
			Los golpes del enemigo tienen una probabilidad de lanzar un rayo penetrante que inflige el 10% del daño del ataque original
			- Muerte -
			'''
		CWRGanged: Sinergia con Calamity Overhaul: Invoca el alma perdurable del Tejedor de Tormentas para que luche a tu lado
	}

	HeartOfStorm: {
		DisplayName: Corazón de la tormenta
		Tooltip:
			'''
			Ataca al enemigo y desata una cadena de rayos que inflige un 10% de daño.
			- Modo Muerte -
			'''
		CWRGanged: Efecto sinérgico con Calamity Overhaul: Invoca el alma persistente del Tejedor de tormentas para que luche junto a ti
	}

	Nyxolithraken: {
		DisplayName: Nyxolithraken
		Tooltip:
			'''
			Invoca un dragón Nyxolith que embiste a los enemigos y les inflige [cebuff:CalamityEntropy/LifeOppress] y [cebuff:CalamityMod/WhisperingDeath]
			Ocupa 5 espacios de súbditos
			'''
	}

	MariviniumBodyArmor: {
		DisplayName: Coraza de marivinium
		Tooltip:
			'''
			Aumenta un 15%  el daño y la probabilidad de golpe crítico
			Otorga la capacidad de respirar en el abismo
			'''
	}

	MariviniumHelmet: {
		DisplayName: Casco de marivinium
		Tooltip:
			'''
			Aumenta el daño un 20%
			Aumenta un 10% la probabilidad de golpe crítico y la velocidad de ataque cuerpo a cuerpo
			Aumenta la vida y el maná máximos en 200
			'''
	}

	MariviniumLeggings: {
		DisplayName: Mallas de marivinium
		Tooltip:
			'''
			Aumenta un 36% la velocidad de movimiento
			Reduce un 20% en el coste de maná
			Aumenta un 5% el daño y la probabilidad de golpe crítico
			'''
	}

	ToyGuitar: {
		DisplayName: Guitarra de juguete
		Tooltip: Invoca a Plantera-chan
	}

	AncientScriptures: {
		DisplayName: Escrituras antiguas
		Tooltip: Lanza un rayo arcano básico
	}

	BookMarkBrimstone: {
		DisplayName: Marcapáginas - Azufre
		Tooltip:
			'''
			Invoca vórtices infernales que disparan láseres de sangre contra los enemigos
			Los láseres de sangre infligen [cbuff:CalamityMod/BrimstoneFlames]
			'''
	}

	BookMarkAerialite: {
		DisplayName: Macapágina - Aerialita
		Tooltip:  Llueven plumas del cielo al golpear
	}

	BookMarkFlesh: {
		DisplayName: Marcapáginas - Macabro
		Tooltip:
			'''
			Los proyectiles se convierten en rayos de sangre destructivos al impactar, lo que inflige [cbuff:CalamityMod/BurningBlood]
			Aumenta la penetración de armadura en 1
			Los proyectiles de este libro roban vida a los enemigos
			'''
	}

	BookMarkIce: {
		DisplayName: Marcapáginas - Helado
		Tooltip: Al impactar, lanza una espada de hielo contra el objetivo que inflige [cbuff:Quemadura de hielo]
	}

	InfiniteBook: {
		DisplayName: Libro infinito
		Tooltip: ""
	}

	BookMarkOfLight: {
		DisplayName: Marcapáginas - Luz
		Tooltip:
			'''
			Los golpes infligidos a los enemigos tienen una probabilidad de invocar un Alma de luz
			Las Almas de luz chocan contra los proyectiles enemigos y los destruyen, curándote un 0,5% de tu vida máxima
			'''
	}

	BookMarkOfNight: {
		DisplayName: Marcapáginas - Noche
		Tooltip:
			'''
			Los golpes infligidos a los enemigos tienen una probabilidad de invocar un Alma de la noche.
			Las Almas de la noche se dirigen hacia los enemigos y les infligen daño
			Aumenta el daño un 10%
			'''
	}

	BookMarkMechanical: {
		DisplayName: Marcapáginas - Mecánico
		Tooltip:
			'''
			Los impactos del enemigo tienen una probabilidad de invocar un dron mecánico que ataque brevemente a los enemigos
			Los proyectiles de este libro ahora se dirigen hacia los enemigos
			'''
	}

	BookMarkAstral: {
		DisplayName: Marcapáginas - Astral
		Tooltip: Los proyectiles de este libro se sustituyen por una estrella persistente que dispara proyectiles contra los enemigos antes de estallar
	}

	BookMarkTerra: {
		DisplayName: Marcapáginas - Terra
		Tooltip:
			'''
			Los proyectiles de este libro se sustituyen por cantos rodados de terra que se lanzan contra el enemigo
			Aumenta el daño un 20%
			Aumenta la penetración de armadura en 1
			'''
	}

	BookMarkLunar: {
		DisplayName: Marcapáginas - Lunar
		Tooltip: Los enemigos a los que se golpee repetidamente se desintegrarán en una luz lunar que causará daño a los enemigos cercanos
	}

	BookMarkAbyss: {
		DisplayName: Marcapáginas - Abisal
		Tooltip: Los impactos del enemigo tienen una probabilidad de abrir una grieta abisal, lo que inflige daño adicional
	}

	BookMarkProfaned: {
		DisplayName: Marcapáginas - Profanado
		Tooltip: Los proyectiles dejan tras de sí llamas persistentes y profanas
	}

	BookMarkVoid: {
		DisplayName: Marcapáginas - Vacío
		Tooltip:
			'''
			Los impactos del enemigo tienen una probabilidad de provocar una explosión del vacío
			Los ataques infligen [cebuff:CalamityEntropy/VoidTouch]
			'''
	}

	BookMarkAuric: {
		DisplayName: Marcapáginas - Áurico
		Tooltip: Los ataques tienen una probabilidad de estallar en fuego de dragón e infligir [cbuff:CalamityMod/Dragonfire]
	}

	BookMarkSilva: {
		DisplayName: Marcapáginas - Silva
		Tooltip:
			'''
			Los impactos del enemigo tienen una probabilidad de invocar un Alma de origen.
			Las Almas de origen se alojan en ti, te curan y te proporcionan un aumento temporal de la defensa
			'''
	}

	BookMarkBee: {
		DisplayName: Marcapáginas - Abeja
		Tooltip: Los impactos del enemigo generan abejas teledirigidas que infligen [cebuff:CalamityEntropy/BonePiercingToxin] y [cebuff:Poisoned]
	}

	BookMarkSunkenSea: {
		DisplayName: Marcapáginas - Mar hundido
		Tooltip: Los impactos del enemigo generan fragmentos de prisma autoguiados
	}

	BookMarkCorrupt: {
		DisplayName: Marcapáginas - Corrupción
		Tooltip:
			'''
			Los golpes del enemigo tienen una probabilidad de generar tentáculos perforantes que infligen [cbuff:ShadowFlame]
			Aumenta la penetración de armadura en 6
			'''
	}

	BookMarkCrimson: {
		DisplayName: Marcapáginas - Carmesí
		Tooltip:
			'''
			Los golpes del enemigo tienen una probabilidad de provocar géiseres de sangre que surgen desde abajo y que infligen [cbuff:CalamityMod/HeavyBleeding]
			Otorga un 17% de probabilidad de curarse 1 punto de vida al recibir un golpe
			Aumenta la probabilidad de golpe crítico en un 4%
			'''
	}

	BookMarkGoozma: {
		DisplayName: Marcapáginas - Croma
		Tooltip: Los proyectiles de este libro se sustituyen por bengalas arcoíris penetrantes que se dividen en estrellas autoguiadas
	}

	BookMarkIntergelactic: {
		DisplayName: Marcapáginas - Intergaláctico
		Tooltip:
			'''
			 Los ataques invocan slimes nova que lanzan corrupción interestelar contra los enemigos
			 Cada 5 impactos, los objetivos lanzarán una ráfaga cósmica
			'''
	}

	BookMarkAquarius: {
		DisplayName: Marcapáginas - Acuario
		Tooltip:
			'''
			Al impactar contra un enemigo, esparce agua radiante
			Esta agua inflige [cebuff:Wet]
			'''
	}

	BookMarkAries: {
		DisplayName: Marcapáginas - Aries
		Tooltip:
			'''
			Los golpes del enemigo tienen una probabilidad de generar una ráfaga de fuerza de voluntad dañina
			Aumento del daño del 6%
			'''
	}

	BookMarkTaurus: {
		DisplayName: Marcapáginas - Tauro
		Tooltip: Los proyectiles de este libro se fragmentarán en tres proyectiles idénticos más pequeños al impactar
	}

	BookMarkCancer: {
		DisplayName: Marcapáginas - Cáncer
		Tooltip:
			'''
			Los proyectiles reducen la velocidad y el daño de los proyectiles enemigos con los que colisionan
			Aumenta un 50% el tamaño del proyectil
			'''
	}

	BookMarkCapricorn: {
		DisplayName: Marcapáginas - Capricornio
		Tooltip: La velocidad de ataque de este libro aumenta con el tiempo, hasta alcanzar un incremento del 25%
	}

	BookMarkLeo: {
		DisplayName: Marcapáginas - Leo
		Tooltip:
			'''
			Aumenta el daño un 12%
			Aumenta un 20% el tamaño del proyectil
			'''
	}

	BookMarkSagittarius: {
		DisplayName: Marcapáginas - Sagitario
		Tooltip:
			'''
			Aumenta el daño un 6%
			Aumento la velocidad del proyectil un 26%
			'''
	}

	BookMarkPisces: {
		DisplayName: Marcapáginas - Piscis
		Tooltip:
			'''
			Los ataques lanzan un clon adicional y más pequeño del proyectil de este libro al atacar
			Aumenta la penetración de armadura en 6
			'''
	}

	BookMarkVirgo: {
		DisplayName: Marcapáginas - Virgo
		Tooltip:
			'''
			Aumenta el daño un 8%
			Los ataques de este libro atraviesan a 1 enemigo más
			'''
	}

	BookMarkLibra: {
		DisplayName: Marcapáginas - Libra
		Tooltip:
			'''
			Aumenta el daño un 10%
			Aumenta la velocidad de ataque un 4%
			Aumenta la probabilidad de golpe crítico un 10%
			AAumenta la velocidad de los proyectiles un 5%
			Los ataques de este libro atraviesan a 1 enemigo adicional
			Aumenta la penetración de armadura en 4
			Además, aumenta en un 4% el valor más bajo entre el daño y la velocidad de ataque
			'''
	}

	BookMarkGemini: {
		DisplayName: Marcapáginas - Géminis
		Tooltip:
			'''
			Los proyectiles de este libro ahora se dirigen hacia los enemigos
			Aumenta la penetración de armadura en 10
			'''
	}

	BookMarkScorpio: {
		DisplayName: Marcapáginas - Escorpio
		Tooltip: Los ataques de este libro infligen [cbuff:CalamityEntropy/AstralScorpionPoisonous]
	}

	BookmarkPactOfDecay: {
		DisplayName: Pacto de la decadencia
		Tooltip: Los ataques generan un Remolino susurrante que se dirige hacia los enemigos e inflige [cbuff:CalamityMod/VulnerabilityHex]
	}

	BookmarkPactOfWar: {
		DisplayName: Pacto de la guerra
		Tooltip: Al llevar este libro, aparecen unos minis Exo gemelos que persiguen a los enemigos e infligen [cbuff:CalamityMod/MiracleBlight]
	}

	UpdraftTome: {
		DisplayName: Libro de corrientes ascendentes
		Tooltip: Lanza ráfagas de viento que arrasan con los enemigos
	}

	RedemptionBible: {
		DisplayName: Tomo de la reconciliación
		Tooltip:
			'''
			Lanza sagradas lanzas de luz
			Mientras sostengas el libro, un arco sagrado atacará a tu lad
			'''
	}

	Redemption: {
		DisplayName: Redención
		Tooltip:
			'''
			{$MissileLauncherDescTooltip}
			{$MissileLauncherMaxStickTooltip}
			Carga energía y lanza una ráfaga de proyectiles elementales
			Los proyectiles tienen la posibilidad de provocar diversos efectos negativos muy potentes
			Haz clic derecho para lanzar un único proyectil muy potente que siempre infligirá estos efectos negativos
			'''
	}

	NightEpic: {
		DisplayName: Epopeya de la luz estelar
		Tooltip: Conjura dos llamas cósmicas autoguiadas
	}

	AshTranscript: {
		DisplayName: Transcripción profanada
		Tooltip: Lanza un rayo instantáneo de fuego purificador que inflige [cbuff:CalamityMod/HolyFlames]
	}

	VoidOde: {
		DisplayName: Oda a la Nada
		Tooltip: Invoca púas del vacío que se dirigen hacia el objetivo desde abajo y que infligen [cebuff:CalamityEntropy/VoidTouch]
	}

	ControlTerminal: {
		DisplayName: Terminal de control
		Tooltip:
			'''
			Lanza un exo-shuriken autoguiado que dispara dardos a los enemigos cercanos antes de volver hacia ti
			El shuriken y sus dardos infligen [cbuff:CalamityMod/MiracleBlight]
			'''
	}

	TabooVolume: {
		DisplayName: Volumen 13
		Tooltip:
			'''
			Lanza un remolino de azufre que explota en brasas de azufre que se dirigen hacia el objetivo
			Invoca a un trío de cazadores de almas que disparan llamas de azufre; estas llamas curan 1 punto de vida al impactar
			Todos los ataques infligen [cbuff:CalamityMod/VulnerabilityHex]
			'''
	}

	BookMarkRoyal: {
		DisplayName: Marcapáginas - Realeza
		Tooltip:
			'''
			Invoca 3 joyas reales para que te ayuden en combate
			La joya de rubí lanza rayos de energía contra los enemigos cercanos
			La joya de esmeralda se lanza contra los enemigos, infligiendo daño al entrar en contacto con ellos
			La joya de zafiro crea un anillo que otorga a los jugadores que se encuentran dentro un aumento del 15% en el daño infligido y un 5% de resistencia al daño
			'''
	}

	EntropyModeToggle: {
		DisplayName: Espejo de la nihilidad
		Tooltip:
			'''
			Activa o desactiva el modo Entropía
			Ofrece una experiencia más desafiante que los niveles de dificultad existentes de Calamity
			Los objetos de lore obtienen bonificaciones especiales que se pueden activar o desactivar
			[c/ff0000: Nota: ¡El equilibrio de este mod no tiene en cuenta este modo! Prepárate para enfrentarte a circunstancias extremas...]
			Clic derecho para usar solamente TDR
			'''
	}

	BookMarkPerfection: {
		DisplayName: Marcapáginas - Perfección
		Tooltip:
			'''
			Aumenta la probabilidad de que se activen otros efectos de marcapáginas
			Aumenta la probabilidad de golpe crítico en un 16%; esta bonificación tiene un tiempo de efriamiento de 10 segundos cada vez que se produce un golpe
			'''
	}

	Crystedge: {
		DisplayName: Filo cristalino
		Tooltip:
			'''
			Lanza una ráfaga de golpes, seguida de un golpe mucho más potente
			{$CommonItemTooltip.SummonTagDamage}
			3% de probabilidad de golpe crítico de la etiqueta de invocación
			Los golpes críticos invocan cristales flotantes divididos
			{$CommonItemTooltip.Whips}
			'''
	}

	VoidToilet: {
		DisplayName: Retrete del vacío
		Tooltip: ""
	}

	Prominence: {
		DisplayName: Prominencia
		Tooltip:
			'''
			Lanza tres flechas solares acompañadas de una ráfaga de brasas de corto alcance.
			Los impactos en el enemigo infligen tanto [cbuff:CalamityMod/HolyFlames] como [cbuff:CalamityMod/Daybroken].
			'''
	}

	SinewLash: {
		DisplayName: Látigo de tendón
		Tooltip:
			'''
			Se lanza hacia delante y luego se retrae, arrasando con los enemigos a su paso e infligiendo [cbuff:CalamityMod/BurningBlood]
			{$CommonItemTooltip.SummonTagDamage}
			{$CommonItemTooltip.Whips}
			Los súbditos arrancan trozos de carne a los enemigos al atacar
			'''
	}

	AzafureBatteringRam: {
		DisplayName: Ariete de Azafure
		Tooltip:
			'''
			Se carga antes de lanzarse hacia delante, generando una potente onda de choque al impactar
			Las colisiones también infligen [cebuff:CalamityEntropy/MechanicalTrauma], otorgan invencibilidad temporal y te lanzan lejos del objetivo golpeado
			'''
	}

	MindCorruptor: {
		DisplayName: Corruptor de mentes
		Tooltip:
			'''
			Lanza un golpe de largo alcance que se clava en el primer enemigo al que impacta antes de ser arrancado, infligiendo [cbuff:CalamityMod/BrainRot]
			{$CommonItemTooltip.SummonTagDamage}
			{$CommonItemTooltip.Whips}
			Los ataques de los súbditos invocan una ráfaga de cortes de sombra al impactar
			'''
	}

	AzafureChargeShield: {
		DisplayName: Escudo de carga de Azafure
		Tooltip:
			'''
			El dash consume energía.
			La energía se va acumulando con el tiempo
			Este dash permite arrollar a los enemigos sin sufrir daño
			'''
	}

	ProphecyToken: {
		DisplayName: Lágrima resplandeciente
		Tooltip:
