	WelkinFractal: {
		DisplayName: Fractal del firmamento
		Tooltip:
			'''
			Lanza plumas desde arriba y desde abajo hacia el cursor
			Cada tercer golpe genera 3 estrellas autoguiadas
			Los ataques infligen [cbuff:CalamityMod/WindChilled]
			'[c/d4fff8:Has canalizado las nubes hacia el diseño...]'
			'''
	}

	BrilliantFractal: {
		DisplayName: Fractal brillante
		Tooltip:
			'''
			Invoca estrellas y espadas teledirigidas que se lanzan hacia el cursor al blandir el arma
			"[c/f2ffd4:Cogiste esta vieja espada y la puliste de nuevo...]"
			'''
	}

	BrokenHilt: {
		DisplayName: Empuñadura rota
		Tooltip: "[c/c4ff3b:Un fragmento de una antigua espada divina]"
	}

	ElementalFractal: {
		DisplayName: Fractal elemental
		Tooltip:
			'''
			Gira la espada a tu alrededor, invocando pequeñas estrellas teledirigidas, antes de lanzar una aparición de la espada para atravesar a los enemigos
			Los ataques infligen [cbuff:CalamityMod/ElementalMix]
			"[c/ff00a6:Has infundido esencia primigenia en esta espada...]"
			'''
	}

	StarlitFractal: {
		DisplayName: Fractal estelar
		Tooltip:
			'''
			Lanza espadas autoguiadas que invocan estrellas del cielo al impactar
			Cada dos golpes, se lanza una estrella que estalla en fragmentos autoguiados
			Los ataques infligen [cbuff:CalamityMod/AstralInfectionDebuff]
			"[c/dd00ff:Las constelaciones que tú mismo has diseñado aparecen y desaparecen...]"
			'''
	}

	AbyssFractal: {
		DisplayName: Fractal abisal
		Tooltip:
			'''
			Lanza tres masas abisales teledirigidas y un tajo de aguas azules
			Inflige [cbuff:CalamityMod/CrushDepth]
			"[c/7045ff:Cuanto más lo miras, más oscuro se vuelve...]"
			'''
	}

	PlagueInternalCombustionEngine: {
		DisplayName: Motor de combustión bacteriano
		Tooltip:
			'''
			Otorga inmunidad al retroceso
			Al golpear a los enemigos con armas cuerpo a cuerpo verdaderas, se recuperan 8 puntos de vida y se obtiene una defensa temporal de hasta un máximo de 8
			Aumenta un {AttackSpeed}% la velocidad de ataque cuerpo a cuerpo verdadero
			'''
	}

	SpiritFractal: {
		DisplayName: Fractal espiritual
		Tooltip:
			'''
			Blande la espada tres veces, lanzando espadas autoguiadas
			Lanza la espada en el cuarto golpe, invocando un anillo de espíritus autoguiados
			Inflige [cebuff:CalamityEntropy/SoulDisorder]
			"[c/dfe7cb:Los espíritus de aquellos a los que has matado potencian cada golpe...]"
			'''
	}

	VoidFractal: {
		DisplayName: Fractal del vacío
		Tooltip:
			'''
			Haz clic izquierdo para lanzar cinco veces un rayo del vacío hacia delante
			El sexto golpe lanza la espada hacia delante, creando un anillo de estrellas
			El séptimo golpe crea un tajo que atraviesa la pantalla
			Haz clic derecho para realizar un tajo del vacío hacia el cursor y hacer que el personaje sea invencible cada 10 segundos
			Los ataques infligen [cebuff:CalamityEntropy/VoidTouch]
			"[c/ba3ade:Trabajar con el vacío es bailar con la muerte; es un gran honor poder manejarlo]"
			'''
	}

	BurntLostClassics: {
		DisplayName: Fábulas perdidas
		Tooltip: Lanza una ráfaga de 3 orbes de azufre rebotantes que infligen [cbuff:CalamityMod/BrimstoneFlames]
	}

	ProphecyMasterpiece: {
		DisplayName: Todo lo que será
		Tooltip: Canaliza una bola de cristal en un rayo de energía del alma, lo que inflige [cebuff:CalamityEntropy/SoulDisorder]
	}

	ForeseeWhip: {
		DisplayName: Látigo del futuro
		Tooltip:
			'''
			{$CommonItemTooltip.Whips}
			{$CommonItemTooltip.SummonTagDamage}
			10% de probabilidad de golpe crítico de la etiqueta de invocación
			Los enemigos marcados reciben un 5% más de daño de todas las fuentes
			Los golpes críticos de los súbditos provocarán daño en cadena a un máximo de 5 enemigos cercanos
			'''
	}

	Nemesis: {
		DisplayName: Némesis
		Tooltip:
			'''
			Invoca una tormenta de plumas infernales que infligen [cebuff:CalamityEntropy/LifeOppress] y [cebuff:CalamityMod/Dragonfire]
			Las plumas infernales también volverán al jugador al impactar, restaurándole entre 10 y 14 de vida
            Cada séptimo golpe, en cambio, invoca una espada gigante que inflige [cebuff:BetsysCurse]
            Al mantener pulsado clic derecho la espada se cargará; al soltar clic derecho cuando está completamente cargada, se desata un torrente de cortes de fuego
			'''
	}

	LashingBramblerod: {
		DisplayName: Azote de zarzas
		Tooltip:
			'''
			{$CommonItemTooltip.Whips}
			{$CommonItemTooltip.SummonTagDamage}
			[1]% de probabilidad de golpe crítico de la etiqueta de invocación
			Los golpes críticos de los súbditos hacen que broten espinas a tu alrededor, lo que te otorga una reducción de daño única del [2]%
			Si ya hay espinas, florecerá una flor; cada flor proporciona una reducción de daño adicional del [3]% y [4] PV/s de regeneración de vida por segundo
			Pueden florecer hasta [5] flores a la vez
			'''
	}

	FinalFractal: {
		DisplayName: Fractal final
		Tooltip:
			'''
			Envía visiones de espadas del pasado hacia tu cursor
			Cada noveno tajo, lanza un rayo devastador
			Cada décimo tajo, lanza la espada con una cadena, liberando energía cósmica
			Haz clic derecho para realizar un tajo fantasma que te otorga invulnerabilidad y te lanza hacia tu cursor cada 5 segundos
			"[c/fcc7ff:El camino más allá de tu cenit depende únicamente de tu voluntad y tu perseverancia...]"
			'''
	}

	AzafureMiner: {
		DisplayName: Extractor de Azafure
		Tooltip: Coloca una pequeña cantera y una terminal minera
	}

	RequiemCard: {
		DisplayName: Carta del alma 『Réquiem』
		Tooltip:
			'''
			Reduce la mayoría de los tiempos de enfriamiento en un [T]%
			"La gradualidad es la muerte de la palabra..."
			'''
	}

	GrudgeCard: {
		DisplayName: Carta del alma 『Rencor』
		Tooltip:
			'''
			Al golpear a los enemigos, existe la posibilidad de que se liberen almas que vuelan hacia ti, curándote 2 puntos de vida, más 1 punto adicional por cada 160 de vida máxima, restaurándote 10 de maná y otorgándote 6 de defensa temporal
			"El odio persistente puede ser el combustible definitivo para quien desea derramar sangre..."
			'''
	}

	ObscureCard: {
		DisplayName: Carta del alma 『Contacto』
		Tooltip:
			'''
			El contacto con los enemigos aumenta considerablemente la regeneración de salud, restaura el tiempo de vuelo e inflige [cebuff:CalamityEntropy/SoulDisorder]
			"Incluso un simple roce puede purificar el ambiente y crear una cercanía antes inalcanzable..."
			'''
	}

	PurificationCard: {
		DisplayName: Carta del alma 『Purificación』
		Tooltip:
			'''
			Reduce la duración de todos los efectos negativos en un [T]%
			"La llama de la absolución consumirá todas las impurezas..."
			'''
	}

	WisperCard: {
		DisplayName: Cartal del alma 『Susurro』
		Tooltip:
			'''
			Aumenta el tiempo de invencibilidad un [T]%
			"Murmullos fantasmales, susurros etéreos, los de las alturas revelan secretos de este plano..."
			'''
	}

	MourningCard: {
		DisplayName: Carta del alma 『Luto』
		Tooltip:
			'''
			Reduce la eficacia de los efectos que disminuyen los valores de defensa, daño, probabilidad de golpe crítico, reducción de daño y regeneración de vida
			"El entumecimiento que provoca el dolor puede, a veces, protegernos de lo peor del mundo..."
			'''
	}

	IndigoCard: {
		DisplayName: Carta del alma 『Índigo』
		Tooltip:
			'''
			Aumenta la velocidad de vuelo en un [T]% y el tiempo de vuelo en [T2]
			"Las almas celestes se elevan, guiadas por el mismo viento del que están formadas..."
			'''
	}

	BitternessCard: {
		DisplayName: Carta del alma 『Aflicción』
		Tooltip:
			'''
			Cuanto menos daño tengas, más daño infligirás; por el contrario, cuanto más daño tengas, menos daño recibirás
			Hasta un [1]% más de daño y un [2]% de reducción de daño
			"La furia que surge del dolor y la miseria es más primitiva que cualquier otra emoción..."
			'''
	}

	DevouringCard: {
		DisplayName: Carta del alma 『Desgarro del alma』
		Tooltip:
			'''
			Los ataques ignoran el [1]% de la defensa del enemigo
			"Las almas hambrientas de los propios pecados carcomen su voluntad..."
			'''
	}

	CursedThread: {
		DisplayName: Hilo maldito
		Tooltip:
			'''
			Se utiliza para entrelazar la Baraja del Alma
			Requiere de los siguientes materiales:
			Réquiem: Notas de los espíritus liberados tras la muerte de Plantera
			Susurro: Ecos de chasquidos y crujidos en la cúspide de la simbiosis...
			Purificación: Se encuentra en cofres vivos impregnados de energía sagrada...
			Oscuridad: Sumergido en los fluidos de dioses muertos...
			Rencor: Extraído del ectoplasma de una docena de espíritus mediante un líquido transmutador...
			Índigo: Oculto en lagos sostenidos por las nubes...
			Luto: Un código moral del protector de una civilización selvática perdida...
			Aflicción: Alimenta a las bestias de una tierra tan asolada...
			Desgarro del alma: Se encuentra carcomiendo la armadura sagrada de un defensor de mazmorras...
			'''
		HoldShiftForDetails: ""
	}

	SoulDeck: {
		DisplayName: Baraja del alma
		Tooltip:
			'''
			Reduce la mayoría de los enfriamientos en un [CD]%
			Incrementa el tiempo de invencibilidad un [IM]%
			Reduce la duración de los debuffos un [DB]%
			Restaura el tiempo de vuelo al tocar las hitboxes de los enemigos e inflige el debuff Perturbación del alma
			De vez en cuando, al golpear, lanza Fragmentos de alma, que vuelan hacia ti para curarte, otorgarte armadura temporal y recuperar maná
			Aumenta la velocidad de vuelo en [FL]% y el tiempo de vuelo en [FT]%
			Ralentiza la bajada de estadísticas (armadura, daño, probabilidad de crítico, reducción de daño, regeneración de vida y otros atributos) cuando estas disminuyen
			Cuanto menor sea tu vida, mayor será tu reducción de daño (hasta un [BE]%)
			Cuanto mayor sea tu vida, mayor será tu daño (hasta un [BD]%)
			Ignora un [AP]% de la armadura enemiga
			'''
	}

