	TaintedDeck: {
		DisplayName: Baraja contaminada
		Tooltip:
			'''
			Tus proyectiles rogue se dirigen hacia los enemigos
			Tus ataques lanzan brasas oscuras autoguiadas, infligen [cebuff:CalamityEntropy/VoidTouch] e infligen [cebuff:CalamityEntropy/Deceive]
