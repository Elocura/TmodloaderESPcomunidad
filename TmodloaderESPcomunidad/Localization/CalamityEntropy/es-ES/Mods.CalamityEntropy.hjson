ModNameOverride: Calamity Entropy

Items: {
	VoidBlade: {
		DisplayName: Cuchilla del vacío
		Tooltip: Realiza tajos amplios y rápidos en rápida sucesión que infligen [cebuff:CalamityEntropy/VoidTouch]
	}

	Weapons: {
		Rogue: {
			Revelation: {
				DisplayName: Revelación
				Tooltip:
					'''
					Lanza una hoz que regresa y dispara mini-hozas fusionadas
					Las mini-hozas fusionadas duran poco tiempo y se dirigen hacia los objetivos
					Los ataques sigilosos lanzan un abanico de tres hozas explosivas autoguiadas, junto con un potente tajo
					'''
			}

			Silence: {
				DisplayName: Silencio
				Tooltip: 
					'''
					[c/9387ff:Lanza un frisbee]
					[c/9387ff:Tras golpear a un enemigo,]
					[c/9387ff:utilizará una Cadena del Vacío para atraerte hacia ese enemigo tras una breve demora,]
					[c/9387ff:y explotará al entrar en contacto con él]
					[c/9387ff:Los ataques sigilosos hacen que el frisbee se adhiera al enemigo alcanzado]
					[c/9387ff:y genere un vórtice de gran área, que inflige daño continuo a los objetivos que se encuentren dentro de su radio de acción]
					'''
			}

			ShadewindLance: {
				DisplayName: Lanza del viento sombrío
				Tooltip:
					'''
					Lanza una jabalina impregnada de el Vacío que provoca una pequeña explosión al impactar.
					Los ataques sigilosos traspasan la defensa, infligen más daño y provocan una explosión mayor al impactar.
					Inflige [cebuff:CalamityEntropy/VoidTouch]
					'''
			}

			Aquashard: {
				DisplayName: Fragmento acuático
				Tooltip:
					'''
					Lanza una jabalina frágil que se hace añicos en cristales más pequeños al impactar contra un enemigo
					Los ataques sigilosos atraviesan al enemigo, liberan cristales autoguiados mientras vuelan y hacen que la jabalina se fracture al impactar
					'''	
			}

			SpearOfRadiance: {
				DisplayName: Lanza del resplandor
				Tooltip:
					'''
					Lanza una jabalina bendita
					Los ataques sigilosos liberan una luz sagrada giratoria
					'''
			}

			AbyssalPiercer: {
				DisplayName: Perforador abisal
				Tooltip:
					'''
					Lanza una jabalina sumergida que, al impactar, estalla en agua abisal autoguiada e inflige [cbuff:CalamityMod/CrushDepth]
					Los ataques sigilosos desatan tentáculos que se aferran y atraviesan a los enemigos
					'''
			}

			AzureOfFirmament: {
				DisplayName: Firmamento azulado
				Tooltip:
					'''
					Lanza una jabalina impregnada de luz
					Los ataques sigilosos generan una ráfaga de plumas autoguiadas
					'''
			}

			ArbitratorII: {
				DisplayName: Árbitro II
				Tooltip:
					'''
					Lanza una jabalina explosiva
					Los ataques sigilosos hacen que la jabalina se clave en los objetivos alcanzados antes de provocar una explosión más grande
					'''
			}

			Voidseeker: {
				DisplayName: Rastreador del vacío
				Tooltip:
					'''
					Blande una guadaña imbuida del vacío
					Los ataques sigilosos te teletransportan hasta el cursor y lanzan una onda de choque que inflige daño
					'''
			}

			TheBeginingAndTheEnd: {
				DisplayName: El comienzo Y el fin
				Tooltip:
					'''
					Al hacer clic izquierdo se lanza El comienzo; al hacer clic derecho, se lanza El fin; ambos infligen el desventaja [cebuff:CalamityEntropy/LifeOppress]
					El comienzo inflige la desventaja [cebuff:CalamityEntropy/EclipsedImprint]
					El fin inflige la desventaja [cebuff:CalamityEntropy/StareOfTheAbyss]
					Ambas desventajas se acumulan hasta 8 veces; cuando se aplica la desventaja opuesto, se crean esa cantidad de almas Eclipse o Eco
					Las Almas eclipsadas regresan a ti, restaurando 4 de vida cada una y otorgándote brevemente el beneficio [cebuff:CalamityEntropy/ServiceBuff]
					Las Almas eco atacan sin descanso a los enemigos durante un breve periodo de tiempo
					Los ataques sigilosos añaden dos cuchillos teledirigidos y desatan un enjambre de ambas almas al impactar
					'''
			}

			AmethystFrisbee: {
				DisplayName: Frisbee de amatista
				Tooltip:
					'''
					Alterna entre lanzamientos penetrantes y rebotantes
					Los ataques sigilosos generan una onda de choque al impactar y siempre rebotan
					'''
			}

			ProphecyFlyingKnife: {
				DisplayName: Dagas proféticas
				Tooltip:
					'''
					Lanza varias dagas autoguiadas que infligen [cebuff:CalamityEntropy/SoulDisorder]
					Los ataques sigilosos lanzan un único cuchillo que genera 6 runas colapsantes al impactar
					'''
			}

			TheDeadCut: {
				Tooltip:
					'''
					Blande una guadaña oxidada que restaura el sigilo al impactar
					Los golpes sigilosos desatan un tajo devastador
					'''
				DisplayName: La Hendidura mortal
			}

			LunarPlank: {
				DisplayName: Principio lunar
				Tooltip: 
					'''
					Lanza un tablón lunar para golpear a los enemigos
					Los golpes sigilosos provocarán un pulso de energía y liberan estrellas autoguiadas al impactar
					'''
			}

			AzafureSurgeRod: {
				DisplayName: Vara de sobretensión de Azafure
				Tooltip:
					'''
					Lanza una cuchilla que se clava en los enemigos y explota tras un breve tiempo
					La cuchilla inflige [cebuff:CalamityEntropy/MechanicalTrauma] y explota al cabo de un breve tiempo
					Los ataques sigilosos lanzan numerosas cuchillas autoguiadas que, además, infligen [cbuff:CalamityMod/GalvanicCorrosion] al explotar
					'''
			}

			TlipocasScythe: {
				DisplayName: Guadaña de Tlipoca
				Tooltip: NOT IMPLEMENTED AT THIS STAGE
			}

			AzafureLightMachineGun: {
				DisplayName: Ametralladora ligera Azafure
				Tooltip:
					'''
					Disparar un láser continuo que restaura el sigilo al impactar
					Los ataques sigilosos lanzan una granada de gran daño
					Ambos infligen ela desventaja [cebuff:CalamityEntropy/MechanicalTrauma]
					'''
			}

			AzafureAirReaper: {
				DisplayName: Segador aéreo de Azafure
				Tooltip:
					'''
					Lanza una hoz que se clava en los enemigos y les inflige [cebuff:CalamityEntropy/MechanicalTrauma]
					Los ataques sigilosos lanzan una hoz que persigue y corta repetidamente al objetivo
					'''
			}

			CrystalSpike: {
				DisplayName: Espina cristal
				Tooltip:
					'''
					Lanza cristales maléficos que se clavan en los enemigos
					Los ataques furtivos arrancan los cristales clavados en el enemigo antes de lanzarlos rápidamente
					'''
			}

			ScorchingChakram: {
				DisplayName: Chakram abrasador
				Tooltip:
					'''
					Lanza un chakram que atraviesa al enemigo y explota en mil pedazos en el aire
					Los chakrams infligen [cbuff:OnFire] al impactar
					Los ataques sigilosos permiten que el chakram lance bolas de fuego antes de dirigirse hacia los enemigos
					'''
			}

			EmberSpike: {
				DisplayName: Espina de brasas
				Tooltip:
					'''
					Lanza brasas ardientes que se funden con los objetivos y explotan al impactar
					Los ataques sigilosos arrancan las brasas incrustadas del enemigo y las lanzan rápidamente
					Los impactos de los ataques sigilosos generan fragmentos tectónicos autoguiados al impactar
					Ignora 8 puntos de defensa
					'''
			}
		}
	}

	PrisonOfPermafrost: {
		DisplayName: Prisón de Permafrost
		Tooltip:
			'''
			Crea una ventisca de escarcha y hielo
			Los golpes infligen [cbuff:Frostburn] y otorgan al usuario [cbuff:CalamityMod/CosmicFreeze], lo que aumenta la regeneración de vida y congela a los enemigos cercanos
			De vez en cuando lanza grandes fragmentos de hielo que infligen [cbuff:CalamityMod/MarkedforDeath]
			'''
	}

	Kinanition: {
		DisplayName: Kinanición
		Tooltip:
			'''
			[c/ce97fa:Lanza una serie de flechas de rayo autoguiadas]
			[c/ce97fa:Estas flechas conservan el efecto original de tu munición]
			[c/0078b9:Haz clic derecho para lanzar un rayo autoguiado que estalla en un rayo al impactar]
			'''
	}

	VoidRelics: {
		DisplayName: Reliquias del vacío
		Tooltip:
			'''
			[c/9387ff:Invoca un Ojo de la mirada del cacío y crea un conjunto de runas a tu alrededor]
			[c/9387ff:Las runas lanzan automáticamente Pernos de vacío autoguiados contra los enemigos cercanos]
			[c/9387ff:y también infligen daño a los enemigos con los que entran en contacto]
			[c/9387ff:Al mantener pulsado atacar, se acumulan runas delante de ti]
			[c/9387ff:para luego disprarse rápidamente un gran número de Pernos de vacío hacia el cursor]
			[c/9387ff:Si dejas de usarla o la utilizas durante más de 6 segundos, las runas se reajustan]
			[c/9387ff:y se aplica un tiempo de enfriamiento de hasta 36 segundos en función del tiempo de uso]
			[c/9387ff:Durante el tiempo de enfriamiento, las runas obtienen un aumento del 15% de velocidad de ataque]
			'''
	}

	AuricToilet: {
		DisplayName: Retrete áurico
		Tooltip:
			'''
			El lugar favorito de Yharim para descansar. Sentarse sobre un objeto tan venerado sería una ofensa atroz para todo Terraria. Lástima que no haya nada que te lo impida...
			"Ya has llegado. ¿Tienes que seguir más allá?"
			'''
	}

	LotteryBox: {
		DisplayName: Terminal de lotería
		Tooltip:
			'''
			Crea un terminal de apuestas personal
			¡Guarda una moneda en tu inventario y haz clic en ella para tener la oportunidad de ganar!
			"Hasta ahora has tentado a la suerte de formas mucho más peligrosas, ¿qué son unas cuantas monedas a cambio de un buen rato?"
			'''
	}

	ToyRock: {
		DisplayName: Piedra de juguete
		Tooltip:
			'''
			Invoca a Wyrm-chan
			"Ella es joven todavía"
			'''
	}

	YharimsStimulants: {
		DisplayName: Estimulantes de Yharim
		Tooltip:
			'''
			Aumenta el daño un 5% 
			Aumenta la probabilidad de golpe crítico un 4%
			Aumenta la velocidad de ataque cuerpo a cuerpo un 10%
			Aumenta el empuje de tus súbditos
			Aumenta la aceleración un 12%
			Aumenta la velocidad de movimiento un 30%
			Aumenta considerablemente la suerte del usuario
			+8 de defensa
			Proporciona +1 PV/s de regeneración de vida
			Reduce la velocidad de minería un 3%
			'''
	}

	VoidBottle: {
		DisplayName: Ampolla del vacío
		Tooltip: Invoca al Cruiser
	}

	VoidMonument: {
		DisplayName: Monumento del vacío
		Tooltip: ""
	}

	Lore: {
		CruiserLore: {
			DisplayName: Cruiser
			Tooltip: ""
			Lore: "{$loreCruiser}"
		}

		NihilityTwinLore: {
			DisplayName: Nihility Twin
