Mods: {
	CalCooldownRenderFix: {
		Configs: {
			CFUConfig: {
				DisplayName: Configuración

				Headers: {
					CooldownBar: Barra de Enfriamiento
					RageAdrenalineBar: Barra de Furia/Adrenalina
					CustomBossTitlesIntros: Títulos de Introducción de Jefes
					Misc: Miscelánea
				}

				CooldownBarShader: {
					Label: "[i:963] Activar"
					Tooltip:
						'''
						Usa el nuevo sombreador para la barra de [c/aaff33:Enfriamiento].
						Compatible con [c/bb3344:Calamity Mod] y [c/ffff00:Calamity Fables].
						[c/444444:Solo funciona si el Modo de Visualización del Panel de Enfriamiento está en Completo.]
						'''
				}

				CooldownStyle: {
					Label: "[i:1967] Estilo"
					Tooltip: Cambia el estilo.
				}

				CooldownPixelation: {
					Label: "[i:3753] Nivel de Pixelado"
					Tooltip:
						'''
						[c/ff3333:OPCIÓN EXPERIMENTAL]
						Pixela las barras de enfriamiento según el nivel establecido.
						Cuanto más alto, más fuerte es el efecto.
						[c/444444:Desactivado por defecto.]
						'''
				}

				CooldownFablesSupport: {
					Label: "[i:174] Compatibilidad de Enfriamientos de Fables"
					Tooltip:
						'''
						Añade compatibilidad para que los enfriamientos de [c/ffff00:Calamity Fables]
						se coloquen junto a su contraparte de [c/bb4444:Calamity Mod].
						'''
				}

				RageAdreBarShader: {
					Label: "[i:CalamityMod/HeartofDarkness] Activar"
					Tooltip:
						'''
						Rediseña el aspecto de las barras de [c/ff4411:Furia]/[c/00bbff:Adrenalina].
						Compatible con [c/bb3344:Calamity Mod].
						'''
				}

				RageAdreStyle: {
					Label: "[i:1967] Estilo"
					Tooltip: Cambia el estilo.
				}

				DraedonHeartForce: {
					Label: "[i:CalamityMod/DraedonsHeart] Corazón de Draedon Anula el Estilo"
					Tooltip:
						'''
						Si está [c/00ff00:activado]:
						  reemplazará la barra de [c/00bbff:Adrenalina] del mod con la
						  contraparte vanilla mientras [c/887799:Corazón de Draedon] esté equipado.
						'''
				}

				CustomBossTitlesIntros: {
					Label: "[i:4798] Activar"
					Tooltip:
						'''
						Cambia los títulos de nombres de jefes a variantes estilizadas.
						Compatible con [c/bb3344:Calamity Mod], [c/ffff00:Calamity Fables] y [c/ff77bb:Calamity Infernum Mode].
						'''
				}

				CustomBossTitlesNoInfernumIntros: {
					Label: "[i:1332] Modo Sin Infernum"
					Tooltip:
						'''
						Si está [c/00ff00:activado]:
						  el mod gestionará las intros al estilo de [c/ff77bb:Infernum] por sí mismo.
						Si [c/ff77bb:Calamity Mod Infernum Mode] está activo:
						  esta configuración omite el requisito del [c/ffff66:Modo Infernum] para que aparezcan las intros.
						'''
				}

				CustomBossTitlesIntroSize: {
					Label: "[i:486] Tamaño"
					Tooltip: Multiplicador de escala para el texto.
				}

				CustomBossTitlesSmoothFablesIntroText: {
					Label: "[i:3481] Renderizado Suave de Texto de Fables"
					Tooltip: Hace que la fuente se renderice más suave en las intros de jefes de [c/ffff00:Calamity Fables].
				}

				RelicBossTitles: {
					Label: "[i:4927] Activar Títulos de Jefes para Reliquias"
					Tooltip: Hace que los nombres de las reliquias se rendericen con la rareza única asociada a su jefe.
				}

				BossBarBossTitles: {
					Label: "[i:5120] Activar Títulos de Jefes en la Barra de Jefes"
					Tooltip:
						'''
						La barra de jefes de [c/bb4444:Calamity] dibuja el título del jefe con su estilo asociado.
						También aplica el efecto a la propia barra.
						Compatible con el estilo de barra de jefes de [c/ff77bb:Calamity Infernum Mode].
						'''
				}

				BossBarCustomFont: {
					Label: "[i:449] Usar Fuente Estilizada en la Barra de Jefes"
					Tooltip:
						'''
						Reemplaza la fuente del progreso de salud de la barra de jefes de [c/bb4444:Calamity] por la estilizada.
						Compatible con el estilo de barra de jefes de [c/ff77bb:Calamity Infernum Mode].
						'''
				}
			}

			CooldownStyles: {
				Tooltip: ""

				Calamity: {
