DisplayName: Configuración principal

DisplayConfigMessage: {
	Label: Mostrar mensaje de configuración
	Tooltip: Activa/desactiva el mensaje superpuesto que le indica al jugador mirar la interfaz.
	WarningText:
		'''	
		¡Hola! Probablemente lo primero que pienses al leer esto sea algo como: "¿Cómo quito este texto? Es molesto".
		Iré al grano. Dada la intensidad de varios efectos visuales del mod, es importante que conozcas las opciones de configuración para atenuarlos.
		Esto se menciona de forma tan explícita para asegurarse de que las personas con fotosensibilidad lo sepan antes de continuar.
		Puedes encontrar la configuración en Ajustes -> Configuración de Mods -> Calamity: Wrath of the Gods -> Configuración Principal.
		Para asegurarte de que seguiste estos pasos correctamente, puedes desactivar este mensaje emergente de forma permanente en la configuración, mediante la opción 'Mostrar Mensaje de Configuración'.
		'''
}

PhotosensitivityMode: {
	Label: Modo de fotosensibilidad
	Tooltip:
		'''
		Activa/desactiva los efectos que dependen de animaciones repentinas y parpadeantes.
		Esto afecta otras opciones de configuración relacionadas, aunque se pueden ajustar manualmente si se desea.
		'''
}

ScreenShatterEffects: {
	Label: Efectos de pantalla fragmentada
	Tooltip:
		'''
		Activa/desactiva los efectos de ruptura de pantalla.
		Desactívalos si resultan demasiado molestos para la vista.
		'''
}

VisualOverlayIntensity: {
	Label: Intensidad de superposición visual
	Tooltip: Modifica la intensidad de superposiciones visuales como el desenfoque o la aberración cromática.
}
