	DisplayName: Fauna sanguínea
	ObtainmentHint: ""
	Tooltip: ""
}

SeamapCollection: {
	DisplayName: Colección de mapas marinos
	ObtainmentHint: "[c/F79BC6:Puede encontrarse en posesión de un capitán pirata]"
	Tooltip:
		'''
		Una colección catalogada de diversos mapas marinos, con marcas que aparentemente indican tesoros
		Ninguna de las ubicaciones representadas te resulta familiar
		'''
}

SulfuricLeaflet: {
	DisplayName: Folleto sulfúrico
	ObtainmentHint: "[c/F79BC6:Este libro puede ser expulsado en las cavernas sulfúricas]"
	Tooltip:
		'''
		Un breve folleto informativo que describe los peligros de la lluvia ácida
		Parece estar irradiado
		'''
}

TheBookOfShaders: {
	DisplayName: El libro de los shaders
	ObtainmentHint: "[c/F79BC6:Trataré de encontrar este por mi cuenta]"
	Tooltip:
		'''
		Una lectura informativa sobre la creación de shaders y arte generado mediante programación
		Siete páginas están dedicadas a divagar sobre la santidad del pixelado
		La última página subraya la importancia de garantizar que estos efectos estén optimizados y alcancen su máximo rendimiento
		'''
}

UnfinishedColoringBook: {
	DisplayName: Libro de colorear incompleto
	ObtainmentHint: "[c/F79BC6:Este libro puede encontrarse ocasionalmente cerca de mi campamento]"
	Tooltip:
		'''
		Un libro para colorear con escenas celestiales simples
		Aproximadamente dos tercios están coloreados con una calidad magistral. El resto no ha sido tocado
		'''
}

WulfrumAssemblyGuide: {
	DisplayName: Guía de ensamblaje Wulfrum
	ObtainmentHint: "[c/F79BC6:Puede obtenerse de máquinas cargadas]"
	Tooltip:
		'''
		El manual de instrucciones detallado, aunque confuso, de un inventor reconocido
		Las instrucciones mencionan diversas herramientas. La mayoría son desconocidas y las otras se usan de formas muy excéntricas
		'''
}

WorldUpdater: {
	DisplayName: Actualizador de versión mundial (DEBUG)
	Tooltip:
		'''
		Modifica los datos internos de la versión del mundo, actualizándolos
		Esto hace que los mundos antiguos cuenten como nuevos para condiciones específicas de la versión, como si la línea de misiones de Solyn está disponible
		'''
}

SolynBookshelfResetter: {
	DisplayName: Reiniciador de Librero de Solyn (DEBUG)
	Tooltip: Restablece todos los libros del librero de Solyn, así como todas las recompensas no reclamadas
}

ExoticSeedBag: {
	DisplayName: Bolsa de semillas exóticas
	Tooltip:
		'''
		Proporciona todos los componentes necesarios para invocar al Avatar del Vacío
		Para invocarlo, coloca todas las semillas cerca unas de otras y haz clic derecho en el brote bendecido por la escarcha cuando esté completamente crecido
		[c/FF2219:Este objeto existe únicamente por razones de compatibilidad y no está pensado para usarse en mundos nuevos]
		'''
}

GenderDye: {
	DisplayName: Tinte de género
	Tooltip: ""
}

SeedOfWill: {
	DisplayName: Semilla de voluntad
	Tooltip:
		'''
		Desencadena una prueba incesante de determinación con la Deidad sin Nombre
		Solo puede usarse en el jardín
		Puedes recibir una recompensa si resistes lo suficiente
		'''
}

ParadiseDye: {
	DisplayName: Tinte del paraíso
	Tooltip: ""
}

SolynQuestSkipper: {
	DisplayName: Saltador de misiones de Solyn (DEBUG)
	Tooltip: Marca todas las misiones de Solyn como completadas, permitiéndote activar la Génesis inmediatamente
}

SolynTelescopeResetter: {
	DisplayName: Reiniciador de telescopio de Solyn (DEBUG)
	Tooltip: Restablece el estado del telescopio de Solyn, permitiendo que se repare nuevamente
}

StrangeFlagpole: {
	DisplayName: Poste de banderae extraño
	Tooltip:
		'''
		Puede usarse para elegir dónde instalará Solyn su campamento
		Asegúrate de que haya espacio plano y abierto cerca del poste, o el campamento no podrá aparecer
		Colocar este poste te indicará si el espacio cercano es lo suficientemente adecuado
		'''
	NotFlatEnoughText: ¡Este espacio no es lo suficientemente plano o abierto!
	FlatEnoughText: Este espacio es adecuado.
}

FancyRopeSet: {
	DisplayName: Conjunto de cuerdas elegantes
	Tooltip: ""
}
