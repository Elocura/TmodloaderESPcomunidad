	Tooltip: ""
}

LoreAvatar: {
	DisplayName: El Avatar del vacío
	Tooltip:
		'''
		[c/E3AF40:Lamentos graves aúllan desde más allá...]
		Pulsa "Shift Izq" para escuchar con atención
		'''
	Lore:
		'''
			Formas sombrías. Niebla criónica. Extensión     hacia    un     fin    inconcluso
		Uno solo, el Oscuro. Anhela consumir, anhela explorar en  	tiempo negado
		Centro retorcido. Lamentación parabólica. Entropía. Sangriento, lacrimógeno espectáculo
		Efímero  
			Respirando
		Fuerzas que observan. Fuerzas ciegas a todo

				Fragmentos helados
		Ruega al viento marchito
		Nostálgica ensoñación de infinitos escarlatas, colapsados hasta el vacío

			Rayas de color devueltas al mínimo por la penumbra rodante

					Elegía cósmica por la pena del dios anterior

		Descenso. Descenso.		Descenso					Descenso
		Descenso

		En un fulgor deslumbrante, la máscara flota por el reino de los seres superiores. Todo brota y se marchita en la divina exhibición de vida y cese

					El Oscuro, la más intensa estrella en un mundo imperfecto

			Ahora, danzarás 		en tapices de    destino sepultado
		Busca tu   destino sobre las brasas antiguas, donde los lirios no renacerán
		'''
}

